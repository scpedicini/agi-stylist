# Dungeon Corridor - Hands From the Wall
# Source: pasted layout sketch - a first-person, one-point-perspective room wireframe (central
#   rectangle = back wall, four corner lines to the picture corners, one "HAND PROTRUDING FROM THE
#   WALL" label on each side wall). Composed by eye onto the 160x168 picture (the pasted image was
#   not saved to disk, so no pnpm grid run; the geometry is a regular symmetric room).
# Brief: a dungeon in first-person view. Gray walls. Blue for the hands.
# Method: composed from a layout sketch. Back-wall box (56,56)-(104,110) -> room() one-point
#   perspective (back / left / right / ceiling / floor). Left & right walls gray (lightgrey) with
#   stone courses; ceiling & floor darkgray with slabs; far end black (the corridor runs into
#   darkness). HAND (left wall) -> blue hand rooted ~(38,84) reaching right; HAND (right wall) ->
#   blue hand rooted ~(122,84) reaching left, fingers to the centre at eye level.
# Stage: interior room; vanishing point at (80, 83)
# Interpreted: single variant `night` (a cold, dim dungeon; blue = cold accent). Painted directly in
#   dungeon tones, no night() remap. Far end made black (the sketch has no door inside the box, so it
#   reads as the corridor continuing into darkness). Hands are side-view, reaching inward across the
#   corridor, fingers toward the player.
scene "Dungeon Corridor - Hands From the Wall"
variants night

let bx1 = 56
let by1 = 56
let bx2 = 104
let by2 = 110
let r = room(bx1, by1, bx2, by2)

# ---------- ceiling (dark, in shadow) ----------
shape(r[3], darkgrey)
color black
for x in [64, 80, 96] {
  let t = 83 / (83 - by1)
  stroke x, by1, 80 + (x - 80) * t, 0
}

# ---------- floor (dark, stone slabs) ----------
shape(r[4], darkgrey)
color black
for i in 1..6 {
  let s = i / 6
  let d = depth(bx1, by1, bx2, by2, s * sqrt(s))
  stroke d[0], d[3], d[2], d[3]
}
for x in [64, 72, 80, 88, 96] {
  let t = (167 - 83) / (by2 - 83)
  stroke x, by2, 80 + (x - 80) * t, 167
}

# ---------- side walls (gray) with stone courses ----------
shape(r[1], lightgrey)
shape(r[2], lightgrey)
color darkgrey
# left wall courses (recede toward the far end)
stroke 0, 57, bx1, by1 + 0.34 * (by2 - by1)
stroke 0, 110, bx1, by1 + 0.66 * (by2 - by1)
# right wall courses
stroke 159, 57, bx2, by1 + 0.34 * (by2 - by1)
stroke 159, 110, bx2, by1 + 0.66 * (by2 - by1)

# ---------- far end (the corridor into darkness) ----------
shape(r[0], black)

# ---------- hands protruding from the walls ----------
fn hand(cx, cy, dir) {
  # dir 1 = fingers point right (left-wall hand), -1 = left (right-wall hand)
  let pts = [
    [cx + dir * -11, cy - 4],
    [cx + dir * -4,  cy - 6],
    [cx + dir * 3,   cy - 6],
    [cx + dir * 10,  cy - 4],
    [cx + dir * 5,   cy - 2],
    [cx + dir * 11,  cy - 1],
    [cx + dir * 5,   cy + 1],
    [cx + dir * 10,  cy + 2],
    [cx + dir * 5,   cy + 4],
    [cx + dir * 8,   cy + 6],
    [cx + dir * 3,   cy + 7],
    [cx + dir * -3,  cy + 7],
    [cx + dir * -6,  cy + 9],
    [cx + dir * -9,  cy + 7],
    [cx + dir * -10, cy + 3],
    [cx + dir * -11, cy + 2],
  ]
  shape(pts, blue, black)
  color lightblue
  line cx + dir * -6, cy - 5, cx + dir * 2, cy - 5
  color black
  line cx + dir * 3, cy - 5, cx + dir * 3, cy + 5
}
hand(38, 84, 1)
hand(122, 84, -1)

frame()
