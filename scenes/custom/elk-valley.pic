# Elk Valley
# Source: a digital painting the user pasted into the chat (not kept in the repo); reframed
#   with: pnpm grid <image> --crop 0,75,2000,1050 --name elk-valley
# Method: translated by eye from a busy digital painting (starry night, icy peaks, an elk with
# glowing antlers in a green valley). Simplified hard: hundreds of ice streaks became a few lit
# faces, snow ridges and shadow gullies; grass texture became a handful of tufts.
# Colours: night sky → black, ice → cyan / lightcyan / white with blue gullies,
# valley slopes → green with black pine silhouettes, meadow → lightgreen, rocks → darkgrey.
scene "Elk Valley"
variants night, day

let day = variant == "day"

# ---- sky -----------------------------------------------------------------------------------
color day ? blue : black
rect 0, 0, 159, 70
if !day {
  color white
  for i in 0..40 {
    line noise(1, i) * 159, noise(2, i) * 58
  }
  color lightgrey
  for i in 0..20 {
    line noise(3, i) * 159, noise(4, i) * 48
  }
}

# ---- the icy range -------------------------------------------------------------------------
shape([[0, 44], [3, 32], [9, 41], [14, 37], [19, 44], [24, 16], [30, 6], [35, 0], [39, 8],
       [44, 19], [47, 22], [51, 35], [55, 32], [59, 40], [64, 32], [68, 27], [73, 36],
       [79, 46], [86, 46], [90, 52], [96, 54], [103, 52], [108, 48], [112, 46], [117, 40],
       [121, 48], [126, 55], [132, 58], [141, 55], [146, 62], [146, 100], [0, 100]], cyan)
# sunlit / moonlit faces (right-hand side of each peak)
fn face(pts) { shape(pts, lightcyan, null) }
face([[35, 0], [39, 8], [44, 19], [47, 24], [51, 35], [55, 46], [58, 58], [48, 48], [42, 34],
      [38, 20], [35, 8]])
face([[68, 27], [73, 36], [79, 46], [82, 54], [74, 44], [69, 34]])
face([[117, 40], [121, 48], [126, 55], [128, 62], [120, 52]])
face([[3, 32], [9, 41], [12, 46], [6, 40]])
face([[103, 52], [108, 48], [110, 54], [106, 58]])
# snowcaps, then snow on the ridgelines
fn snow(pts) { shape(pts, white, null) }
snow([[35, 0], [39, 8], [43, 16], [40, 15], [37, 18], [34, 13], [31, 12], [30, 6]])
snow([[68, 27], [73, 36], [75, 40], [71, 38], [68, 41], [66, 35], [64, 33]])
snow([[117, 40], [121, 48], [118, 47], [116, 50], [114, 45]])
snow([[3, 32], [7, 38], [4, 37], [1, 36]])
snow([[55, 32], [58, 38], [55, 37], [53, 36]])
color white
line 35, 0, 39, 8, 44, 19
line 36, 4, 41, 18, 46, 30, 50, 42
line 30, 6, 28, 12
line 68, 27, 73, 36, 77, 42
line 117, 40, 121, 48, 124, 52
line 86, 46, 90, 52
line 3, 32, 7, 38
line 55, 32, 58, 38
# shadow gullies
color blue
line 26, 22, 22, 40, 18, 56
line 30, 16, 28, 34, 26, 50, 30, 64
line 40, 30, 36, 50, 38, 70
line 60, 44, 62, 58, 58, 72
line 66, 36, 64, 50
line 112, 50, 110, 62, 112, 72
line 96, 58, 98, 70
line 12, 46, 10, 60

# the darker foothill in the middle of the valley
shape([[34, 70], [50, 68], [66, 72], [80, 62], [88, 56], [94, 60], [106, 70], [118, 78],
       [130, 86], [138, 96], [34, 96]], blue)
color lightcyan
line 88, 56, 94, 62, 100, 68
snow([[88, 56], [93, 61], [90, 61], [88, 63], [86, 60], [85, 59]])

# the dark mountain rising on the right
shape([[124, 66], [136, 60], [144, 44], [152, 32], [159, 26], [159, 100], [124, 100]], blue)
color cyan
line 152, 32, 148, 42, 150, 50
line 156, 30, 154, 44, 156, 54
line 144, 46, 140, 56

# ---- green valley sides with pine silhouettes -----------------------------------------------
shape([[0, 46], [12, 52], [26, 62], [40, 72], [54, 84], [66, 92], [74, 98], [0, 98]], green)
shape([[96, 98], [110, 90], [124, 80], [138, 70], [150, 62], [159, 58], [159, 102], [96, 102]], green)
color lightgreen
line 0, 60, 18, 70, 34, 80
line 6, 70, 26, 80
line 126, 86, 140, 80
fn pine_sil(x, y, h) {
  # a black fir silhouette standing on (x, y)
  shape([[x, y - h], [x + h / 5, y - h / 2], [x + h / 8, y - h / 2], [x + h / 3.5, y],
         [x - h / 3.5, y], [x - h / 8, y - h / 2], [x - h / 5, y - h / 2]], black, null)
}
for i in 0..8 {
  pine_sil(2 + i * 3, 96 - noise(5, i) * 2, 12 + noise(6, i) * 8)
}
for i in 0..20 {
  let x = 100 + i * 3
  let top = 96 - (x - 100) * 0.62
  pine_sil(x, top + 10 + noise(7, i) * 6, 6 + noise(8, i) * 6)
}

# ---- the meadow ----------------------------------------------------------------------------
shape([[0, 97], [30, 96], [60, 95], [90, 95], [120, 97], [159, 99], [159, 167], [0, 167]], lightgreen, null)
color cyan
line 66, 95, 118, 95
color green
for i in 0..18 {
  let x = 4 + noise(9, i) * 150
  let y = 102 + noise(10, i) * 30
  line x, y, x + 8 + noise(11, i) * 10, y
}

# far rocks
fn stone(x, y, w, h, s) {
  shape(blob(x, y, w, h, s, 0.15), darkgrey)
  color lightgrey
  line x - w / 2, y - h / 2, x + w / 3, y - h + 1
}
stone 130, 113, 3, 2, 1
stone 142, 114, 2, 2, 2
stone 112, 120, 2, 1, 3
stone 150, 118, 3, 2, 4

# ---- the elk --------------------------------------------------------------------------------
let antler_strokes = [
  [[58, 108], [54, 102], [51, 96], [50, 88], [52, 82], [54, 78]],   # left beam
  [[51, 96], [47, 93]], [[50, 90], [46, 86]], [[51, 84], [48, 80]],
  [[61, 108], [64, 102], [68, 96], [70, 90], [68, 84], [66, 80]],   # right beam
  [[67, 97], [72, 95]], [[69, 91], [74, 88]], [[69, 86], [73, 82]]
]
fn antlers(c, dx = 0, dy = 0) {
  color c
  for stroke in antler_strokes { line shift(stroke, dx, dy) }
}
if !day {
  # the glow: the same strokes nudged a pixel each way in light cyan, then a white core
  for d in [[-1, 0], [1, 0], [0, -1], [0, 1], [-2, 0], [2, 0]] {
    antlers(lightcyan, d[0], d[1])
  }
}
antlers(day ? lightgrey : white)
if day {
  color darkgrey
  line 58, 109, 54, 103
  line 62, 109, 65, 103
}

# body, mane, head, legs
shape([[43, 116], [45, 112], [50, 110], [56, 110], [60, 111], [61, 118], [59, 124], [54, 126],
       [48, 126], [44, 124]], darkgrey)
color lightgrey
line 46, 112, 55, 111
shape([[56, 110], [61, 110], [62, 123], [57, 126]], brown, null)
shape([[58, 106], [62, 106], [63, 110], [62, 117], [60, 119], [59, 115], [58, 110]], darkgrey)
color black
line 59, 116, 61, 116
color black
line 45, 124, 44, 140
line 48, 125, 48, 139
line 55, 125, 55, 140
line 58, 124, 59, 140
color green
line 42, 141, 62, 141

# ---- foreground: darker grass, tufts and boulders -------------------------------------------
shape([[0, 140], [20, 142], [40, 146], [70, 150], [100, 148], [130, 146], [159, 144],
       [159, 167], [0, 167]], green, null)
for i in 0..26 {
  let x = 4 + noise(12, i) * 150
  let y = 144 + noise(13, i) * 22
  color i % 2 == 0 ? black : lightgreen
  line x - 3, y, x - 1, y - 6, x, y, x + 1, y - 7, x + 2, y, x + 4, y - 5
}
stone 22, 124, 8, 6, 5
stone 24, 152, 7, 4, 6
stone 44, 158, 9, 5, 7
stone 66, 142, 4, 2, 8
stone 128, 138, 6, 4, 9
stone 142, 141, 5, 3, 10
stone 104, 156, 4, 2, 11
stone 152, 164, 6, 3, 12

frame()
