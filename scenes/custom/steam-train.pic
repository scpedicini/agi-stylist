# Steam Train
# A black steam locomotive comes round a bend towards the viewer, red carriages trailing behind
# it into the distance and a plume of smoke streaming back over them.
# Method: redrawn from scratch (the pixel-art illustration the first version was translated from
# isn't kept). The train is seen three-quarter on: its side recedes to a vanishing point on the
# horizon past the right edge (VP), so every roof, footplate and rail line is a line towards VP,
# and heights shrink with distance; the smokebox face is towards the viewer. The track runs along
# the same line, then curves down to the bottom left. The engine is cut down to what reads at
# 160×168: stack, headlamp, round smokebox door, two domes, cab with a lit window, red
# footplate and buffer beam, cowcatcher, three driving wheels with a coupling rod.
# Colours: engine darkgrey with black shadows and lightgrey glints (pure black would swallow its
# own outlines), carriages red with lightred trim, smoke lightgrey with darkgrey undersides.
scene "Steam Train"
variants day, night

let hz = 44
let vp = 210
# the line through row y0 at column 0 that runs to the vanishing point (vp, hz)
fn L(y0, x) {
  return y0 + (hz - y0) * x / vp
}
# a slab of the train's side between two such lines, from column x1 to x2
fn side(x1, x2, top, bot) {
  return [[x1, L(top, x1)], [x2, L(top, x2)], [x2, L(bot, x2)], [x1, L(bot, x1)]]
}

# ---- backdrop -------------------------------------------------------------------------------
horizon(hz, 4)
cloud(22, 12, 34, 2)
pine 8, 66, 0.55, seed: 3
pine 15, 63, 0.45, seed: 5
bush(44, 58, 14, 6, 2)

# ---- the track ------------------------------------------------------------------------------
let centre = [[200, L(138, 200)], [150, L(138, 150)], [90, L(138, 90)], [40, L(138, 40)],
              [24, 129], [12, 145], [4, 167]]
let pts = []
for p in along(centre, 1) { push(pts, [p[0], p[1]]) }
let n = len(pts)
let bed = trail(pts, 24, hz)
let ties = trail(pts, 17, hz)
let gauge = trail(pts, 12, hz)
shape(bed, brown)
# sleepers: straight across between the rails, evenly spaced on the ground, so they crowd
# together into the distance
let f = (167 - hz) / 0.45
let last = null
color black
for i in 0..n {
  let z = f / (pts[i][1] - hz)
  let g = [(2 * pts[i][0] - 160) * z / f, z]
  if last == null || sqrt((g[0] - last[0]) * (g[0] - last[0]) + (g[1] - last[1]) * (g[1] - last[1])) > 0.14 {
    let a = ties[i]
    let b = ties[2 * n - 1 - i]
    stroke a[0], a[1], b[0], b[1]
    last = g
  }
}
color darkgrey
stroke slice(gauge, 0, n)
stroke slice(gauge, n)
color lightgrey
stroke shift(slice(gauge, 0, n), 0, -1)
stroke shift(slice(gauge, n), 0, -1)

# ---- the carriages, smallest first ----------------------------------------------------------
fn carriage(x1, x2) {
  shape(side(x1, x2, 82, 122), red)
  # roof
  shape(side(x1 - 1, x2 + 1, 79, 83), darkgrey)
  color lightred
  stroke x1 + 1, L(85, x1 + 1), x2 - 1, L(85, x2 - 1)
  # windows
  let w = (x2 - x1) / 5
  for k in 0..4 {
    let a = x1 + w * (k + 0.5)
    shape(side(a, a + w * 0.6, 90, 104), black, null)
  }
  # bogies
  for a in [x1 + 3, x2 - 4] {
    let r = L(140, a) - L(128, a)
    ellipse a, L(128, a) + 1, max(1, r * 0.45), r
  }
}
carriage(178, 200)
carriage(152, 176)
carriage(126, 150)

# ---- the locomotive -------------------------------------------------------------------------
# tender with its coal heap
shape(side(102, 124, 94, 124), darkgrey)
shape([[103, L(94, 103)], [107, L(89, 107)], [113, L(88, 113)], [119, L(89, 119)],
       [123, L(94, 123)]], black)
color lightgrey
stroke 103, L(96, 103), 123, L(96, 123)
for a in [108, 119] {
  let r = L(140, a) - L(130, a)
  color black
  ellipse a, L(130, a), r * 0.45, r
}
# cab, roof overhanging
shape(side(82, 101, 68, 124), darkgrey)
shape(side(80, 103, 64, 69), black, null)
shape(side(86, 96, 74, 94), black, null)
color lightcyan
stroke 87, L(76, 87), 89, L(76, 89)
stroke 92, L(76, 92), 94, L(76, 94)
# boiler: a cylinder from the cab forward to the smokebox
shape(side(26, 82, 90, 117), darkgrey)
shape(side(26, 82, 110, 117), black, null)
color lightgrey
stroke 30, L(93, 30), 81, L(93, 81)
color black
for a in [44, 58, 72] { stroke a, L(90, a), a, L(117, a) }
# domes and the stack
fn dome(x, w, h) {
  let t = L(90, x)
  shape([[x - w, t + 2], [x - w, t - h + 2], [x - w + 1, t - h], [x + w - 1, t - h], [x + w, t - h + 2],
         [x + w, t + 2]], darkgrey)
}
dome(54, 3, 7)
dome(67, 2, 5)
shape([[31, 84], [31, 72], [29, 69], [29, 66], [38, 66], [38, 69], [36, 72], [36, 84]], darkgrey)
color lightgrey
stroke 32, 72, 32, 82
# cylinder below the smokebox
shape(side(30, 44, 110, 126), darkgrey)
# red footplate along the side
shape(side(24, 102, 116, 120), red)
# driving wheels with a coupling rod
for a in [46, 61, 76] {
  let cy = L(129, a)
  let r = L(141, a) - cy
  color black
  ellipse a, cy, r * 0.5, r
  color darkgrey
  ellipse a, cy, r * 0.32, r * 0.7
  color lightgrey
  rect a, cy - 1, a, cy + 1
}
color red
stroke 46, L(131, 46), 76, L(131, 76)
stroke 46, L(132, 46), 76, L(132, 76)
# smokebox face: the boiler's round end with its door
color black
ellipse 26, L(103.5, 26), 7, 12
color darkgrey
ellipse 26, L(103.5, 26), 6, 11
color black
ellipse 25, L(103.5, 26), 4, 7
color darkgrey
ellipse 25, L(103.5, 26), 3, 6
color lightgrey
stroke arc(26, L(103.5, 26), 5, 10, 280, 350)
color black
rect 25, L(103.5, 26), 25, L(103.5, 26) + 1
# headlamp on top of the smokebox
fn lamp() {
  color black
  rect 23, 76, 29, 83
  color yellow
  rect 24, 77, 28, 82
  color white
  rect 25, 78, 25, 79
}
lamp()
# buffer beam, buffers and the cowcatcher
color red
rect 16, 110, 36, 116
color black
stroke 16, 110, 36, 110, 36, 116, 16, 116, 16, 110
ellipse 15, 113, 2, 3
ellipse 37, 113, 2, 3
color darkgrey
ellipse 15, 113, 1, 2
ellipse 37, 113, 1, 2
shape([[17, 117], [35, 117], [31, 129], [21, 129]], black)
color darkgrey
for a in [20, 23, 26, 29, 32] {
  stroke a, 118, 26 + (a - 26) * 0.6, 128
}

# ---- smoke streaming back over the train ----------------------------------------------------
let plume = [[34, 62, 4, 5], [38, 54, 6, 6], [46, 46, 8, 7], [58, 38, 10, 8], [72, 30, 12, 9],
             [88, 26, 13, 10], [106, 22, 14, 11], [126, 20, 15, 12], [146, 22, 16, 13],
             [100, 34, 10, 6], [128, 34, 12, 7], [152, 38, 10, 7]]
blobs(plume, lightgrey, darkgrey, 0.3, 4)
for c in [[60, 42, 6, 3], [88, 32, 8, 3], [112, 30, 9, 4], [138, 32, 10, 4]] {
  shape(blob(c[0], c[1], c[2], c[3], c[0], 0.3), darkgrey, null)
}
color white
stroke arc(46, 46, 6, 6, 300, 390)
stroke arc(72, 30, 10, 8, 300, 400)
stroke arc(106, 22, 11, 9, 300, 400)
stroke arc(126, 20, 12, 10, 310, 400)

# ---- steam blowing out round the cylinders --------------------------------------------------
blobs([[40, 128, 5, 4], [48, 132, 6, 4], [32, 132, 4, 3]], white, lightgrey, 0.3, 2)

# ---- a tree framing the bottom right --------------------------------------------------------
blobs([[110, 158, 7, 7], [118, 154, 8, 9], [126, 159, 7, 6]], green)
color lightgreen
line 113, 154, 115, 152
line 119, 149, 122, 147
line 124, 156, 126, 154
flowers(40, 146, 100, 164, 14)
tree(146, 166, 1.1, 5)

# ---- night ----------------------------------------------------------------------------------
if variant == "night" {
  # night() without darkgrey → black (the engine keeps its shape) or lightgrey → darkgrey (moonlit
  # smoke and rails)
  remap {
    blue: black, lightblue: blue, lightgreen: green, green: darkgrey, cyan: blue,
    lightcyan: cyan, white: lightgrey, yellow: brown, brown: black,
    red: magenta, lightred: red, lightmagenta: magenta
  }
  moon(60, 9, 4)
  # stars in the clear sky only, not on the smoke or the cloud
  color white
  for i in 0..40 {
    let x = 2 + noise(30, i) * 156
    let y = 2 + noise(31, i) * 30
    if y > 34 - x * 0.25 || (x < 42 && y > 6 && y < 18) || abs(x - 60) < 6 && y < 15 { continue }
    rect x, y, x, y
  }
  # what glows: the headlamp, the cab window and the carriage windows
  lamp()
  color yellow
  shape(side(86, 96, 74, 94), yellow)
  color black
  stroke 91, L(74, 91), 91, L(94, 91)
  for x1 in [126, 152, 178] {
    let w = 22 / 5
    for k in 0..4 {
      let a = x1 + w * (k + 0.5)
      shape(side(a, a + w * 0.6, 91, 103), yellow, null)
    }
  }
}

frame()
