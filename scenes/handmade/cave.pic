# @reference kq1/r05-c02
# Method: large shapes placed from `pnpm regions` polygons; seams and cracks drawn freehand. No traced line art.
# Hand-authored recreation of the KQ1 cave chamber (row 5, column 2).
# Darkness first, then the rock walls, the earthen floor, and the stalactite columns.
scene "Cave chamber"
variants lit, dark

color black
rect 0, 0, 159, 167

# --- rock walls: big pale slabs with dark seams ---
let walls = [
  [[107,2], [117,2], [130,9], [135,8], [138,17], [143,54], [147,29], [150,29], [156,46], [157,61], [151,66], [148,73], [146,96], [139,112], [138,119], [133,109], [133,103], [132,102], [131,104], [128,96], [127,99], [124,98], [126,86], [125,75], [118,88], [115,98], [111,98], [107,91], [105,89], [101,89], [100,86], [99,89], [91,88], [89,60], [90,30], [96,10], [101,4], [106,3]],
  [[48,6], [57,26], [58,59], [59,71], [61,75], [67,21], [75,6], [78,6], [82,11], [86,32], [86,56], [82,88], [80,87], [67,98], [66,95], [61,100], [60,95], [58,100], [55,97], [53,99], [41,95], [37,92], [33,85], [30,75], [30,66], [34,49], [33,31], [40,17], [45,13], [47,7]],
  [[45,7], [43,13], [38,17], [31,31], [32,49], [28,66], [28,75], [31,85], [35,91], [34,98], [32,100], [31,99], [22,83], [21,86], [11,64], [7,60], [6,49], [9,59], [15,65], [18,64], [18,56], [14,43], [14,36], [11,33], [7,38], [5,45], [4,33], [7,28], [14,23], [16,14], [21,10], [24,9], [32,12], [44,8]],
  [[2,36], [5,60], [9,64], [20,87], [24,106], [29,111], [31,118], [31,122], [23,121], [19,124], [15,118], [12,108], [13,105], [11,104], [8,91], [2,84], [2,37]],
  [[47,1], [71,1], [62,26], [60,59], [59,26], [48,2]]
]
for w in walls {
  shape(w, lightgrey, null)
}
color black
polygon 11,34 13,36 17,64 10,59 6,48 5,57 5,46 10,35

# --- the earthen floor ---
shape([[80,90], [82,91], [76,107], [83,111], [89,111], [96,107], [91,90], [105,91], [106,95], [111,100], [123,99], [128,101], [138,123], [152,122], [152,130], [149,137], [152,158], [148,166], [69,166], [73,163], [68,159], [65,147], [61,102], [64,99], [67,100], [79,91]], brown, null)
shape([[37,94], [43,98], [59,102], [57,148], [55,157], [51,162], [56,166], [46,166], [40,163], [37,160], [35,153], [30,152], [27,140], [19,132], [11,128], [17,128], [23,123], [33,123], [33,118], [29,107], [37,95]], brown, null)

# --- the two hanging columns and their shadows ---
color darkgrey
polygon 1,110 8,127 25,140 28,152 33,154 35,160 40,165 45,166 32,166 26,156 18,152 12,142 3,136 1,132 1,111
polygon 99,4 92,18 88,42 89,78 90,88 92,89 90,90 95,107 90,109 91,107 88,96 87,32 91,9 92,7 98,5
polygon 60,97 63,147 66,158 72,163 66,166 63,157 61,116 59,116 59,133 60,102 58,101 60,98
polygon 72,1 77,1 72,7 65,21 62,41 62,57 63,26 72,2
color lightgrey
polygon 87,57 87,96 90,108 83,109 78,106 84,91 87,58
polygon 60,116 61,150 65,165 57,165 60,155 60,117
polygon 79,5 85,5 91,8 87,20 87,31 84,11 80,6
polygon 124,80 123,97 117,98 124,81
polygon 22,87 31,101 28,106 26,106 22,88
polygon 58,149 57,160 55,164 53,163 57,157 58,150

# --- stones on the floor ---
color darkgrey
polygon 84,122 88,122 99,128 93,130 81,129 83,123
polygon 158,112 158,128 155,135 152,136 154,122 158,113
polygon 114,111 118,111 120,115 118,120 111,116 113,112
polygon 40,105 42,108 46,107 43,112 41,113 37,111 36,109 39,106

# --- seams in the rock and cracks in the floor, drawn freehand ---
color darkgrey
squiggle(100, 10, 60, 175, 21, 12)
squiggle(118, 6, 70, 180, 22, 10)
squiggle(136, 12, 60, 185, 23, 12)
squiggle(40, 12, 50, 170, 24, 12)
squiggle(58, 14, 40, 180, 25, 10)
squiggle(16, 20, 50, 175, 26, 12)
color black
squiggle(91, 6, 80, 182, 27, 6)
squiggle(46, 40, 50, 178, 28, 8)
color darkgrey
for k in 0..8 {
  let x = 70 + noise(31, k) * 80
  let y = 100 + noise(32, k) * 60
  line x, y  x + 3, y + 1
}

# with the torch out, only shapes remain
if variant == "dark" {
  remap { lightgrey: darkgrey, darkgrey: black, brown: black }
}
frame
