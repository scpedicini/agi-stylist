# @reference kq1/r01-c02
# Method: measured polygons plus a freehand oak; tracer-assisted line art for the black ink and dark grey mortar, which is most of the stonework.
# Hand-authored recreation of the KQ1 opening screen: Castle Daventry (row 1, column 2).
# Back to front: sky → forest → lawn → oak → moat and bank → castle mass → stonework → doorway → bridge.
scene "Castle Daventry"
variants day, night

sky 17
color lightblue
rect 0, 18, 159, 34
color cyan
polygon 47,11 49,13 50,25 51,26 52,24 55,26 55,30 52,34 53,39 48,39 44,31 42,20 42,17 47,12
color green
rect 0, 35, 159, 39
polygon 58,19 61,26 65,27 67,34 70,35 70,39 54,39 53,34 56,30 55,24 57,20
polygon 110,25 113,26 113,41 111,47 109,43 104,43 103,41 103,35 108,33 110,26
polygon 128,27 128,43 115,41 115,31 120,28 123,35 128,28

ground 40

# --- the old oak on the lawn ---
color green
ellipse 18, 117, 18, 8
shape([[28,79], [28,120], [22,121], [18,119], [21,109], [22,81], [26,84], [28,80]], brown)
let crown = [[18,1], [36,1], [38,7], [42,10], [36,15], [36,21], [34,20], [32,25], [33,37], [38,39], [42,48], [42,53], [41,55], [37,54], [34,57], [34,67], [27,78], [23,74], [21,75], [18,70], [18,66], [15,64], [15,60], [17,59], [16,52], [12,50], [10,53], [7,53], [6,51], [9,33], [14,31], [16,32], [18,30], [15,20], [14,19], [12,21], [9,18], [11,14], [10,11], [16,8], [18,2]]
