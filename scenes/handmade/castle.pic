polygon 12,52 14,52 15,56 13,59 13,64 16,66 19,76 15,72 14,67 11,66 10,58 13,53
color cyan
squiggle(14, 10, 20, 150, 51, 25)
squiggle(24, 20, 24, 160, 52, 25)
squiggle(30, 36, 18, 200, 53, 25)
squiggle(12, 50, 16, 120, 54, 25)

# --- moat, and the muddy bank the castle stands on ---
color blue
polygon 37,147 42,155 43,161 158,161 158,166 10,166 36,148
polygon 70,125 65,143 59,133 69,126
