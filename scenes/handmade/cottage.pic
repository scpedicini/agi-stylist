# --- needles and shingles, drawn freehand ---
color lightcyan
line 147,10 146,23 149,33
for apex in [[145, 45], [149, 63], [144, 85]] {
  let x = apex[0]
  let y = apex[1]
  line x - 7, y + 13  x, y  x + 7, y + 8
}
# a shingle is a little "u" scallop
fn shingle(x, y) {
  line x, y  x + 1, y + 4  x + 3, y + 4  x + 5, y
}
color lightgrey
for at in [[36, 36], [41, 39], [47, 39], [41, 45], [31, 46], [38, 49], [33, 57], [28, 60], [36, 60],
           [27, 68], [32, 70], [26, 78], [21, 86], [62, 47], [68, 47], [73, 48], [80, 54], [66, 60],
           [73, 62], [78, 66], [82, 76], [88, 73], [84, 83], [90, 82]] {
  shingle(at[0], at[1])
}

