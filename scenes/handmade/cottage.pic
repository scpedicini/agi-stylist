# @reference kq1/r03-c04
# Method: measured polygons plus freehand shingles and needles; tracer-assisted line art for the black ink outlines.
# Hand-authored recreation of the KQ1 gingerbread cottage (row 3, column 4).
# Painted back to front; shapes were placed over the reference with `pnpm regions`.
scene "Cottage in the pines"
variants day, night

# --- sky, hazy hills, the dark forest behind ---
sky 17
color lightblue
rect 0, 18, 159, 33
color green
rect 0, 34, 159, 40
color darkgrey
polygon 111,9 112,15 110,19 113,22 108,27 110,31 109,33 91,34 92,30 90,28 98,24 101,10 104,16 103,22 105,25 108,22 111,10
color green
polygon 116,1 119,11 118,14 124,24 122,26 122,30 126,35 119,40 89,40 87,36 107,35 111,32 109,27 114,22 111,18 116,2
polygon 49,6 49,13 52,22 50,25 54,31 49,35 42,35 34,27 29,40 20,40 19,37 22,22 24,30 27,19 27,23 31,29 35,20 36,24 38,24 40,13 40,20 44,27 49,7
