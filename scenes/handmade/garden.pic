# @reference kq1/r02-c03
# Method: named layers from measured polygons plus freehand plants and veins; tracer-assisted line art (`regions --lines`) for the soil cracks and the wall joints.
# Hand-authored recreation of the KQ1 carrot garden (row 2, column 3).
# Painted back to front: sky → far forest → meadow → trees → garden bed → walls → plants.
scene "Carrot garden"
variants day, night

# --- sky, far hills and the forest behind the garden ---
sky 17
color green
polygon 22,41 22,40 40,30 40,18 128,18 128,21 158,19 158,41
rect 22, 36, 158, 40
color lightblue
polygon 74,18 110,18 102,22 98,20 91,27 85,21 79,25 79,19 77,19 76,23 74,19
color green
polygon 116,11 117,10 127,21 128,40 110,20

ground 41

# shaggy tree behind the wall: dark foliage drawn with grey strokes, brown trunk
color green
polygon 43,18 48,13 50,17 54,13 55,12 57,18 60,17 61,13 63,19 62,27 59,28 57,24 55,26 52,23 47,27 44,23
polygon 68,13 69,22 71,22 72,14 73,23 75,26 77,24 76,31 80,31 75,36 73,41 69,39 66,41 63,37 66,36 61,32 65,30 65,26 67,28
color brown
polygon 50,26 55,27 53,37 57,42 51,40 49,43 49,27
color darkgrey
line 51,27 46,14 44,18
line 55,26 60,12 63,18
line 57,28 70,15 72,22
line 59,30 76,22 80,27

# two tall cypresses on the right
for cx in [131, 144] {
  let pts = [[cx - 4, 42], [cx - 3, 20], [cx - 2, 4], [cx, 1], [cx + 2, 4], [cx + 3, 20], [cx + 4, 42]]
  shape(pts, green, null)
  color cyan
  line cx - 1, 8  cx + 1, 16  cx - 1, 24  cx + 1, 32  cx, 38
}
color blue
rect 149, 1, 158, 17

# --- the big tree crowding in from the top left ---
let crown = [[1, 1], [38, 1], [40, 26], [35, 36], [30, 33], [21, 36], [19, 50], [12, 64], [4, 73], [1, 73]]
shape(crown, green, null)
color black
line 40,26 35,36 30,33 21,36 19,50 12,64 4,73 1,73
color cyan
squiggle(4, 20, 18, 70, 3)
squiggle(14, 8, 16, 110, 4)
squiggle(8, 40, 12, 60, 5)
squiggle(24, 14, 10, 120, 6)

# --- the garden bed: brown furrows with diagonal rows of carrot tops ---
