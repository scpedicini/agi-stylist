# Treehouse Hollow
# Source: King's Quest VI (VGA), reference/kq6/r06-c02.png; reframed with:
#   pnpm grid reference/kq6/r06-c02.png --name kq6-r06-c02
# Method: translated by eye. Kept: the two giant dark trees framing the clearing, the pink
#   giant tree behind, pale sky, the dirt clearing and grass patches, both treehouses with
#   lavender roofs, the log steps and ladder on the left, the stone fire pit, the stone pile
#   at the right tree's foot, two dry saplings, the dark twisting roots and the leafy
#   foreground twigs. Dropped: bark texture, most of the hanging sticks and scaffolding,
#   individual pebbles, the grey knot on the pink tree, the fine leaf clusters on the sky.
# Colours: pale sky → lightcyan, pink tree → lightred / red, dark trunks → brown / black,
#   dirt → yellow with brown streaks, grass → lightgreen / green, lavender roofs →
#   lightmagenta / magenta, purple roots → blue with lightblue sheen, stones → lightgrey /
#   darkgrey, coals → black.
scene "Treehouse Hollow"
variants day

fn leaf(x, y, len, h, c = green) {
  # a single pointed leaf from its stalk end (x, y), `len` rows long on screen, heading h
  let tx = x + sin(h) * len / 2
  let ty = y - cos(h) * len
  let mx = x + sin(h) * len / 4
  let my = y - cos(h) * len / 2
  let px = cos(h) * len / 8
  let py = sin(h) * len / 4
  shape([[x, y], [mx + px, my + py], [tx, ty], [mx - px, my - py]], c)
  color lightgreen
  stroke [[x, y], [mx, my]]
}

# ---- sky and the far clearing ------------------------------------------------------------
# (delay: the viewer paints these backdrops last, farthest last, filling in behind the rest; the
# picture itself is unchanged)
delay 2 {
  color lightcyan
  rect 0, 0, 159, 54
}
delay {
  color yellow
  rect 0, 50, 159, 167
}

# ---- the pink giant tree behind ---------------------------------------------------------
shape(band([[72, 16], [62, 8], [50, 3], [38, -2]], 8, 3), lightred)
shape(band([[88, 10], [100, 4], [114, -2]], 7, 3), lightred)
shape([[68, -1], [94, -1], [92, 14], [94, 28], [98, 40], [104, 48], [112, 55],
       [52, 56], [60, 50], [66, 42], [70, 30], [70, 16]], lightred)
color red
stroke [[74, 8], [73, 22], [71, 36], [64, 48], [58, 54]]
stroke [[82, 18], [80, 34], [78, 46]]
stroke [[90, 30], [94, 42], [100, 50]]
stroke [[62, 6], [52, 2]]

# ---- dark branches with leaves against the sky -------------------------------------------
shape(band([[84, 24], [92, 20], [100, 22], [108, 16], [118, 10]], 4, 2), black)
shape(band([[86, 42], [96, 38], [104, 36], [112, 30], [122, 28]], 4, 2), black)
shape(band([[92, 22], [96, 30], [100, 36]], 3, 2), black)
shape(band([[98, 37], [96, 46], [92, 52]], 2, 1), black)
shape(band([[44, 6], [56, 4], [68, 0]], 2, 1), black)
leaf 104, 21, 9, 200
leaf 110, 15, 9, 150
leaf 100, 37, 10, 200
leaf 108, 33, 9, 150
