# log steps winding down
fn step(x1, x2, y) {
  shape([[x1, y + 1], [x1 + 2, y - 1], [x2 - 2, y - 1], [x2, y + 1], [x2 - 2, y + 3],
         [x1 + 2, y + 3]], yellow)
  color brown
  stroke [[x1 + 2, y + 2], [x2 - 2, y + 2]]
}
step 24, 36, 72
step 21, 34, 77
step 18, 31, 82
step 14, 27, 87
step 3, 13, 85

