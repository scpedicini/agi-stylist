stroke [[56, 133], [59, 132]]
stroke [[64, 126], [67, 127]]
for i in 0..14 {
  let a = i * 360 / 14 + 10
  let cx = 58 + sin(a) * 18
  let cy = 128 - cos(a) * 11
  rock(cx, cy, 8, 6, seed: i + 1)
}

