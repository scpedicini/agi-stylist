fn bough(pts, w) {
  # a branch: brown stroke `w` px thick with a black underside
  color brown
  for j in 0..w {
    line shift(pts, 0, j)
  }
  color black
  line shift(pts, 0, w)
}
bough([[86, 26], [96, 20], [106, 14], [120, 10], [134, 7], [148, 4], [159, 2]], 4)
bough([[87, 14], [96, 8], [106, 3], [114, 0]], 3)
