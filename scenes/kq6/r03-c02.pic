fn frond(x0, y0, x1, y1, w, c, rib, vein = black, teeth = 7) {
  # a tapering, saw-edged fern leaf from (x0, y0) to its tip (x1, y1), `w` px wide
  let dx = x1 - x0
  let dy = y1 - y0
  let l = sqrt(dx * dx + dy * dy)
  let nx = -dy / l
  let ny = dx / l
  let left = []
  let right = []
  for k in 0..teeth * 2 {
    let t = (k + 1) / (teeth * 2 + 1)
    let ww = w * sin(t * 180) * (k % 2 == 0 ? 1 : 0.5)
    push(left, [x0 + dx * t + nx * ww, y0 + dy * t + ny * ww])
    push(right, [x0 + dx * t - nx * ww, y0 + dy * t - ny * ww])
  }
  let pts = [[x0, y0]] + left + [[x1, y1]]
  for k in 0..len(right) { push(pts, right[len(right) - 1 - k]) }
  shape(pts, c)
  color vein
  for k in 0..teeth {
    let t = (2 * k + 1) / (teeth * 2 + 1)
    let t2 = t + 0.6 / teeth
    let ww = w * sin(t2 * 180) * 0.7
    line x0 + dx * t, y0 + dy * t, x0 + dx * t2 + nx * ww, y0 + dy * t2 + ny * ww
    line x0 + dx * t, y0 + dy * t, x0 + dx * t2 - nx * ww, y0 + dy * t2 - ny * ww
  }
  color rib
  line x0, y0, x1, y1
}
# dark teal fronds drooping at the back right
