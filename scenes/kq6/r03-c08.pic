fn window(x1, y1, x2, y2) {
  shape([[x1, y1], [x2, y1], [x2, y2], [x1, y2]], black)
  shape([[x1 - 3, y1 - 1], [x1 - 1, y1], [x1 - 1, y2], [x1 - 3, y2 + 1]], brown)
  shape([[x2 + 1, y1], [x2 + 3, y1 - 1], [x2 + 3, y2 + 1], [x2 + 1, y2]], brown)
  color red
  line x1 - 3, y2 + 2, x2 + 3, y2 + 2
}
