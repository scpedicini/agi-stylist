fn roses(list, s) {
  for i in 0..len(list) {
    let h = list[i]
    for k in 0..3 {
      let x = h[0] + (noise(s, i * 3 + k) - 0.5) * h[2] * 1.4
      let y = h[1] + (noise(s + 1, i * 3 + k) - 0.5) * h[3] * 1.2
      color k == 1 ? red : lightred
      stroke x, y, x + 1, y
    }
  }
}
roses(hedge_r, 11)
roses(hedge_l, 13)

