# ---- palms ---------------------------------------------------------------------------------
fn trunk(pts, w1, w2, s) {
  shape(band(pts, w1, w2), brown)
  # rings: short dark arcs down the trunk
  color black
  let n = len(pts)
  for i in 0..n - 1 {
    let a = pts[i]
    let b = pts[i + 1]
    for k in 0..3 {
      let t = k / 3
      let x = a[0] + (b[0] - a[0]) * t
      let y = a[1] + (b[1] - a[1]) * t
      let hw = (w1 + (w2 - w1) * (i + t) / (n - 1)) / 4
      stroke x - hw, y - 1, x, y + 1, x + hw, y - 1
    }
  }
  color yellow
  let off = -w1 / 6
  for i in 0..n - 1 {
    stroke pts[i][0] + off, pts[i][1] - 2, pts[i][0] + off, pts[i][1] - 4
  }
}
# a thin drooping date-palm leaf: a curving spine with paired needles hanging off it
fn leaf(x, y, n, heading, droop) {
  let side = heading % 360 < 180 ? 1 : -1
  let px = x
  let py = y
  let spine = [[x, y]]
  for i in 1..=n {
    let hh = heading + side * droop * i / n
    px += 1.5 * sin(hh)
    py -= 2 * cos(hh)
    push(spine, [px, py])
  }
  for i in 1..=n {
    let p = spine[i]
    let l = 4 * sin(180 * i / (n + 2)) + 1
    color green
    stroke p[0], p[1], p[0] - side * l * 0.3, p[1] + l
    color i % 3 == 0 ? lightgreen : green
    stroke p[0], p[1], p[0] + side * l * 0.6, p[1] + l * 0.8
  }
  color green
  stroke spine
}
# left palm, mostly off the edge
