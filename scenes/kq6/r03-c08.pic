# ---- dark agave in the foreground --------------------------------------------------------
fn spike(x, y, tx, ty, w) {
  shape([[x - w, y], [tx, ty], [x + w, y]], black)
  color darkgrey
  line x, y, (x + tx) / 2, (y + ty) / 2
}
