fn mushroom(x, y) {
  color lightgrey
  rect x, y, x + 1, y + 3
  shape([[x - 2, y + 1], [x - 2, y], [x - 1, y - 2], [x + 2, y - 2], [x + 3, y], [x + 3, y + 1]],
        white)
  color lightgrey
  line x - 1, y + 1, x + 2, y + 1
}
