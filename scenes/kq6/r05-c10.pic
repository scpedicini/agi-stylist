# Redwood Forest Pool
# Source: King's Quest VI (VGA) - reference/kq6/r05-c10.png; reframed with:
#   pnpm grid reference/kq6/r05-c10.png --name kq6-r05-c10
# Method: translated by eye. Kept: the two giant redwoods framing left and right, the hazy
#   far forest of thin trunks with pale sky between, the mossy branch with hanging moss, the
#   dirt path running back between two grass-capped earth banks, the blue pool, four grey
#   boulders, the bright fern bank and pale trunk on the far right, the foreground path,
#   fallen sticks and a few white mushrooms. Dropped: individual needles and pine boughs (a
#   few green clumps stand in), most hanging moss, bark texture, small roots on the left
#   bank, grass blades.
# Colours: pale sky → lightcyan, far trunks → lightgrey with darkgrey sides, far canopy →
#   green, redwood bark → brown lit half / red shadowed half with black grooves and yellow
#   highlights, cream earth banks → lightgrey with white hanging lobes and a darkgrey
#   shadowed base (kept off yellow so they stay apart from the path), moss caps →
#   lightgreen, tan path → yellow with brown edges, pool → blue with lightblue ripples, boulders →
#   lightgrey/darkgrey, mushrooms → white with lightgrey gills.
scene "Redwood Forest Pool"
variants day

# ---- sky and the far forest --------------------------------------------------------------
# (delay: the viewer paints this backdrop last, filling in behind the rest; the picture itself is
# unchanged)
delay {
  color lightcyan
  rect 0, 0, 159, 70
}

# thin far trunks, irregular widths and spacing
fn ftrunk(x, w, top, bot) {
  color lightgrey
  rect x, top, x + w, bot
  color darkgrey
  line x + w, top, x + w, bot
}
let far = [[33, 3], [46, 1], [55, 2], [62, 1], [73, 2], [86, 3], [95, 1], [101, 3]]
for t in far {
  ftrunk(t[0], t[1], 0, 64)
}
# far canopy: pine boughs in front of the trunks
blobs([[34, 2, 12, 6], [50, 0, 10, 5], [64, 3, 10, 6], [92, 2, 12, 5], [104, 6, 8, 6]], green)
# pine boughs: a flat top and a saw-toothed underside
fn bough(x, y, w, seed) {
  let pts = [[x - w / 2, y + 1], [x - w / 4, y - 1], [x + w / 4, y - 2], [x + w / 2, y]]
  let n = floor(w / 3)
  for i in 0..n {
    let bx = x + w / 2 - (i + 0.5) * w / n
    push(pts, [bx, y + 3 + noise(seed, i) * 2])
    push(pts, [bx - w / n / 2, y + 1])
  }
  shape(pts, green)
  color lightgreen
  line x - w / 4, y, x + w / 4, y - 1
}
