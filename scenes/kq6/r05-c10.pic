# white lit lobes hanging off the cap, with dark gaps between
fn lobes(edge, x1, x2, seed, lo, hi) {
  let x = x1
  let i = 0
  while x < x2 {
    let w = 3 + noise(seed, i) * 5
    let top = interp(edge, x + w / 2) + 1
    let len = lo + noise(seed + 1, i) * (hi - lo)
    shape([[x + 1, top], [x + w, top], [x + w, top + len * 0.6], [x + w - 1, top + len - 2],
           [x + w / 2 + 0.5, top + len], [x + 1, top + len - 2]], white, null)
    color darkgrey
    line x, top + len * 0.4, x, top + len + 2
    x = x + w + 1 + noise(seed + 2, i) * 3
    i += 1
  }
}
lobes(rcap_bot, 75, 112, 3, 12, 26)
