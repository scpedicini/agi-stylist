# Gnarled Oak Cove
# Source: King's Quest VI (VGA) - reference/kq6/r06-c01.png; reframed with:
#   pnpm grid reference/kq6/r06-c01.png --name kq6-r06-c01
# Method: translated by eye. Kept: the misty pale sky, the ghostly grey trees and grey boulders
#   at the back, the green grass strip and dark mossy boulders, the sandy beach, the huge gnarled
#   oak with spreading roots and moss-hung branches, the shore rocks, the teal cove with mossy
#   rocks standing in it, the boulder on the beach, and the dark twisted tree in the near left
#   with its grey boulder behind it.
#   Dropped: the ivy texture on the oak, most of the small twigs, the grass tufts on the sand,
#   the root shadows on the sand, mist gradients. Moved: nothing.
# Colours: hazy sky → lightcyan, far ghost trees → lightgrey with darkgrey lines, grey-blue
#   boulders → lightgrey/darkgrey, mossy boulders → darkgrey with green moss, grass → green,
#   pale sand → yellow with brown shading, oak → brown with black shadow side and yellow lit
#   edges, hanging moss → green, teal water → cyan with lightcyan and blue streaks, near
#   twisted tree → black with brown lit edges.
scene "Gnarled Oak Cove"
variants day

# ---- sky -------------------------------------------------------------------------------
# (delay: the viewer paints these backdrops last, farthest last, filling in behind the rest; the
# picture itself is unchanged)
delay 3 {
  color lightcyan
  rect 0, 0, 159, 60
}

# ---- far sea (right), pale near the horizon ---------------------------------------------
delay 2 {
  color cyan
  rect 116, 44, 159, 167
}
color lightcyan
for r in [[46, 104, 159], [48, 120, 150], [50, 112, 159], [53, 130, 159], [56, 120, 140],
          [60, 140, 159], [64, 128, 152]] {
  line r[1], r[0], r[2], r[0]
}

# ---- ghostly far trees (upper left) -----------------------------------------------------
fn ghost(pts, w, w2) {
  shape(band(pts, w, w2), lightgrey, darkgrey)
}
# arching grey trunk in the top-left corner
ghost([[2, 40], [0, 24], [2, 10], [10, 2], [26, 0]], 16, 8)
# the pale tree behind the rocks
ghost([[52, 42], [52, 30], [50, 18], [44, 8], [36, 2], [24, 0]], 16, 5)
ghost([[50, 22], [56, 12], [64, 6], [74, 2]], 8, 2)
ghost([[48, 14], [38, 12], [30, 8]], 6, 2)
ghost([[44, 8], [42, 0]], 3, 1)
color darkgrey
stroke [[30, 8], [24, 14], [20, 22]]
stroke [[30, 8], [22, 6], [14, 10]]
stroke [[64, 6], [70, 14], [72, 22]]

# ---- far grey boulders -------------------------------------------------------------------
boulder([[0, 40], [2, 28], [10, 22], [18, 26], [20, 36], [12, 42]], lightgrey, darkgrey, darkgrey, 0.4)
boulder([[22, 40], [26, 28], [34, 20], [46, 22], [54, 30], [56, 40], [36, 44]], lightgrey, darkgrey, darkgrey, 0.4)
boulder([[58, 36], [60, 24], [68, 16], [80, 14], [88, 18], [90, 34], [76, 40]], lightgrey, darkgrey, darkgrey, 0.4)

# ---- grass strip and the start of the beach ---------------------------------------------
delay {
  shape([[0, 44], [100, 44], [112, 52], [124, 60], [134, 70], [136, 84], [126, 96], [100, 110], [60, 124], [0, 130]],
        yellow, null)
}
shape([[0, 38], [20, 36], [40, 38], [60, 40], [70, 44], [62, 50], [40, 52], [20, 50],
       [0, 52]], green, null)
color lightgreen
line 6, 42, 14, 41
line 24, 44, 34, 43
line 46, 44, 54, 45

# ---- path running back between the boulders ---------------------------------------------
shape([[60, 46], [66, 38], [74, 32], [86, 30], [92, 36], [90, 50], [70, 54]], yellow, null)

# ---- dark mossy boulders behind the beach ------------------------------------------------
fn mossy(pts, cut = 0) {
  boulder(pts, darkgrey, black, black, cut)
}
mossy([[28, 52], [30, 46], [38, 44], [44, 48], [44, 56], [34, 58]])
mossy([[52, 46], [54, 38], [60, 34], [66, 38], [68, 48], [60, 52]])
mossy([[64, 50], [66, 40], [74, 34], [86, 32], [92, 40], [88, 52], [74, 54]], 0.3)
mossy([[40, 58], [42, 50], [50, 46], [60, 48], [66, 56], [58, 62], [46, 62]])
mossy([[14, 56], [16, 48], [22, 46], [28, 50], [28, 58], [20, 60]])
color lightgrey
line 32, 46, 38, 45, 42, 48
line 56, 38, 60, 35, 64, 38
line 46, 48, 52, 47, 58, 49
line 76, 35, 84, 34
line 18, 48, 22, 47
color green
line 42, 60, 52, 61, 60, 59
line 30, 56, 36, 57
line 70, 52, 78, 53, 84, 50
line 18, 58, 24, 58

# ---- the beach ---------------------------------------------------------------------------
# sand shading: a brown band where it slopes down to the water and under the roots
color brown
line 0, 66, 10, 64
line 30, 70, 46, 68
line 18, 84, 34, 82
line 64, 76, 80, 74
line 80, 96, 94, 94

# ---- the cove ----------------------------------------------------------------------------
shape([[0, 120], [40, 122], [60, 119], [76, 115], [88, 111], [100, 106], [118, 98],
       [126, 88], [132, 78], [136, 66], [140, 56], [159, 52], [159, 167], [0, 167]], cyan, null)
color brown
line 40, 121, 60, 118, 76, 114, 88, 110, 100, 105
line 118, 97, 125, 88, 131, 78
color lightcyan
line 50, 122, 64, 122
line 68, 118, 82, 117
line 90, 114, 100, 113
color blue
for r in [[116, 96, 116], [120, 104, 124], [126, 92, 110], [130, 60, 84], [146, 128, 150],
          [152, 116, 134], [148, 70, 90], [138, 40, 56], [160, 60, 80]] {
  line r[1], r[0], r[2], r[0]
}
color lightcyan
for r in [[72, 140, 156], [80, 148, 159], [94, 128, 146], [104, 136, 156], [112, 140, 159]] {
  line r[1], r[0], r[2], r[0]
}

# ---- shore rocks beyond the oak, and rocks out in the water ------------------------------
boulder([[112, 66], [114, 54], [122, 50], [130, 56], [134, 68], [126, 74]], lightgrey, darkgrey)
boulder([[120, 80], [122, 70], [130, 66], [136, 72], [136, 82], [128, 86]], lightgrey, darkgrey)
blobs([[118, 56, 6, 5]], green)
boulder([[140, 74], [142, 69], [148, 67], [152, 71], [150, 75]], lightgrey, darkgrey)
boulder([[136, 90], [138, 86], [142, 85], [144, 89], [141, 91]], lightgrey, darkgrey)
boulder([[146, 90], [148, 87], [151, 88], [150, 91]], lightgrey, darkgrey)

# ---- the gnarled oak ---------------------------------------------------------------------
fn limb(pts, w, w2) {
  shape(band(pts, w, w2), brown)
}
# branches first, so the trunk covers their roots
limb([[100, 14], [108, 8], [114, 4], [120, 0]], 10, 5)
limb([[110, 10], [120, 10], [128, 6], [136, 7], [144, 2], [152, 0]], 9, 2)
limb([[106, 32], [114, 26], [120, 28], [128, 20], [136, 22], [144, 15], [152, 14], [159, 9]], 14, 3)
limb([[108, 42], [116, 38], [124, 42], [130, 39], [136, 44]], 9, 2)
limb([[92, 12], [86, 4], [78, 0]], 14, 8)
limb([[100, 8], [106, 0]], 12, 8)
limb([[96, 14], [110, 6], [118, 0]], 10, 4)
# twigs off the right-hand branches
color brown
stroke [[126, 8], [132, 14], [134, 22]]
stroke [[138, 4], [146, 10], [148, 16]]
stroke [[130, 20], [134, 28], [132, 34]]
stroke [[142, 18], [150, 24], [152, 30]]
stroke [[118, 24], [122, 32], [120, 38]]
stroke [[136, 44], [138, 50]]
# roots spreading over the sand
limb([[90, 56], [80, 64], [70, 70], [62, 70]], 12, 2)
limb([[94, 62], [90, 72], [84, 80]], 10, 2)
limb([[104, 62], [108, 72], [104, 80]], 9, 2)
limb([[110, 58], [118, 66], [124, 76], [128, 82]], 12, 2)
color brown
stroke [[70, 70], [66, 76]]
stroke [[84, 80], [78, 82]]
stroke [[104, 80], [100, 84]]
# the trunk: shadowed left half, lit right half
shape([[82, 66], [86, 52], [87, 36], [88, 20], [86, 8], [84, 0], [102, 0], [102, 10],
       [108, 22], [110, 36], [111, 48], [114, 58], [120, 68], [104, 64], [96, 68], [90, 66]],
      brown)
shape([[86, 52], [87, 36], [88, 20], [86, 8], [85, 1], [88, 1], [90, 10], [92, 22], [91, 30],
       [90, 40], [89, 50], [90, 60], [86, 62]], black, null)
color black
stroke [[96, 10], [96, 30], [98, 50]]
stroke [[102, 30], [104, 46], [108, 58]]
color yellow
stroke [[106, 14], [108, 26], [109, 38]]
stroke [[100, 34], [102, 44]]
stroke [[111, 50], [114, 58]]
# grass at the foot of the trunk
color green
line 92, 58, 92, 64
line 94, 56, 95, 62
line 106, 58, 106, 64

# hanging moss off the branches
fn moss(x, y, h) {
  color green
  line x, y, x, y + h
  line x + 1, y + 1, x + 1, y + h - 2
}
moss 118, 26, 10
moss 126, 22, 14
moss 134, 20, 8
moss 140, 19, 16
moss 148, 20, 10
moss 154, 21, 12
moss 122, 10, 8
moss 132, 7, 12
moss 144, 3, 9
moss 152, 1, 7
moss 132, 42, 7

# ---- rocks on the beach and in the cove ---------------------------------------------------
boulder([[48, 98], [52, 90], [60, 86], [70, 88], [76, 96], [70, 104], [56, 104]])
color green
line 52, 98, 60, 100, 66, 98
# big mossy boulder on the shore
boulder([[96, 108], [98, 96], [104, 90], [112, 88], [118, 92], [124, 104], [120, 110],
         [104, 112]], lightgrey, green, black, -0.3)
color lightgrey
line 104, 91, 112, 89, 117, 93
color green
line 98, 96, 98, 88
line 100, 95, 102, 87
# mossy rocks out in the water (right)
boulder([[124, 140], [128, 132], [136, 130], [144, 134], [144, 142], [132, 144]], lightgrey,
        green, black, -0.3)
boulder([[138, 140], [140, 128], [148, 120], [156, 120], [159, 124], [159, 144], [146, 146]],
        lightgrey, green, black, -0.3)
color lightgrey
line 130, 132, 138, 131
line 146, 122, 154, 120
# rock in the bottom-middle
boulder([[88, 167], [92, 156], [100, 150], [110, 152], [116, 162], [118, 167]], lightgrey,
        green, black, -0.3)
color lightgrey
line 94, 156, 100, 151, 108, 152

# ---- near-left boulder and twisted tree --------------------------------------------------
boulder([[2, 118], [6, 104], [18, 96], [32, 98], [42, 108], [42, 120], [24, 126], [8, 126]],
        lightgrey, darkgrey, black, 0.2)
color green
line 10, 112, 18, 114
fn twig(pts, w, w2 = 1) {
  shape(band(pts, w, w2), black)
}
# the trunk rising from the bottom-left corner
twig([[0, 167], [4, 140], [8, 110], [8, 86], [6, 70], [8, 60]], 18, 6)
# upper branches
twig([[6, 64], [12, 56], [18, 52]], 7, 2)
twig([[8, 72], [16, 66], [22, 68], [30, 62], [38, 62], [46, 56], [54, 54]], 9, 2)
twig([[10, 86], [18, 80], [24, 82], [30, 76], [36, 72]], 8, 2)
twig([[8, 100], [18, 94], [24, 88]], 7, 2)
# the long branch over the water
twig([[4, 122], [14, 128], [22, 126], [32, 132], [40, 129], [48, 133], [56, 131], [64, 137], [72, 140]], 16, 2)
twig([[48, 132], [52, 124], [58, 124], [62, 118]], 5, 1)
twig([[32, 132], [36, 140], [34, 146], [40, 150]], 5, 1)
twig([[60, 134], [62, 142], [68, 146], [70, 152]], 5, 1)
# low branch near the bottom
twig([[2, 152], [12, 158], [20, 155], [30, 158], [38, 156], [46, 162], [56, 166]], 12, 2)
twig([[30, 156], [36, 150]], 5, 1)
# spiky twigs
color black
stroke [[18, 52], [16, 44]]
stroke [[30, 64], [32, 56]]
stroke [[44, 58], [46, 50]]
stroke [[24, 88], [26, 82]]
stroke [[72, 140], [78, 138]]
stroke [[64, 137], [70, 132], [74, 133]]
stroke [[40, 129], [42, 122], [46, 120]]
stroke [[22, 126], [24, 118]]
stroke [[20, 155], [22, 148]]
stroke [[46, 162], [52, 158], [58, 158]]
# lit edges along the top of the bigger limbs
color brown
stroke [[10, 108], [11, 90], [10, 76]]
stroke [[14, 126], [22, 124], [32, 129]]
stroke [[12, 155], [20, 152], [30, 155]]
# moss hanging off the near tree
moss 10, 104, 10
moss 22, 130, 12
moss 44, 132, 10
moss 60, 136, 8
moss 14, 160, 6

frame()
