line 98, 160, 106, 158

shape([[10, 96], [24, 100], [30, 120], [28, 132], [22, 140], [12, 146], [10, 146]], green, null)
# ---- ivy hedge over the left of the wall -----------------------------------------------------
blobs([[18, 98, 12, 12], [32, 102, 12, 10], [14, 116, 10, 12], [28, 118, 12, 8]], green)

# ---- left stone wall ------------------------------------------------------------------------
let wall_l = [[24, 124], [26, 112], [40, 100], [52, 91], [76, 83], [76, 122]]
shape(wall_l, lightgrey)
fn course(pts) {
  color darkgrey
  stroke pts
}
course([[30, 110], [44, 101], [54, 95], [76, 89]])
course([[28, 116], [44, 108], [76, 99]])
course([[28, 121], [76, 109]])
course([[30, 124], [76, 116]])
# vertical joints staggered between the courses
color darkgrey
for j in [[48, 98, 104], [62, 92, 99], [38, 106, 112], [56, 101, 107], [70, 94, 101],
          [34, 113, 118], [50, 110, 115], [66, 106, 111], [42, 116, 121], [60, 112, 117]] {
  line j[0], j[1], j[0], j[2]
}
# ivy spilling over the wall's left end
blobs([[24, 110, 8, 12], [32, 104, 5, 6], [28, 120, 8, 6]], green)
color black
line 30, 100, 36, 106, 40, 116
line 22, 104, 26, 112

# ---- right stone wall (behind the right trunk) -----------------------------------------------
shape([[127, 82], [142, 86], [142, 126], [127, 126]], lightgrey)
color darkgrey
stroke 128, 92, 142, 95
stroke 128, 101, 142, 104
stroke 128, 110, 142, 112
stroke 128, 118, 142, 120
line 134, 84, 134, 92
line 137, 95, 137, 102
line 132, 103, 132, 110
line 136, 112, 136, 119

# ---- gate pillars ----------------------------------------------------------------------------
fn pillar(x1, x2, top, bot) {
  shape([[x1, top], [x2, top], [x2, bot], [x1, bot]], lightgrey)
  shape([[x1 - 2, top - 4], [x2 + 2, top - 4], [x2 + 2, top], [x1 - 2, top]], lightgrey)
  color white
  line x1 - 1, top - 3, x2 + 1, top - 3
}
pillar(75, 89, 76, 122)
# shaded face and the fluted half-gate on the left pillar's inner side
shape([[84, 76], [89, 76], [89, 122], [84, 122]], darkgrey)
color lightgrey
line 86, 80, 86, 120
line 88, 80, 88, 120
pillar(108, 127, 76, 124)
# dark recessed panel with iron flutes
shape([[109, 80], [120, 80], [120, 124], [109, 124]], black)
color darkgrey
for x in [111, 113, 115, 117] {
  line x, 82, x, 122
}
shape([[108, 78], [121, 78], [121, 81], [108, 81]], darkgrey)

# ---- the crouching archer statue on the left pillar ------------------------------------------
# a hooded figure hunched on the plinth, facing right, a bow held upright before him
color darkgrey
stroke 93, 44, 92, 56, 93, 70
color black
stroke 94, 44, 93, 56, 94, 70
# body: curved back on the left, hunched shoulders
shape([[77, 72], [77, 64], [78, 57], [81, 52], [85, 50], [89, 53], [90, 60], [91, 68],
       [90, 72]], lightgrey)
# the raised knee in front
shape(blob(88, 64, 3, 4, 5, 0.1), lightgrey)
color darkgrey
line 86, 61, 85, 66, 86, 70
# shaded flank and back
line 78, 66, 79, 58, 82, 54
# hooded head bent forward
shape(blob(86, 50, 3, 3, 3, 0.1), lightgrey)
color darkgrey
line 88, 50, 88, 52
# arm reaching to the bow
shape(band([[85, 55], [89, 58], [93, 56]], 4, 3), lightgrey)

# ---- the overhead bough and the top canopy ---------------------------------------------------
blobs([[20, 2, 16, 6], [48, 2, 16, 5], [76, 3, 14, 6], [104, 2, 14, 4], [132, 2, 14, 4]],
      green)
color lightgreen
line 30, 2, 36, 0
line 60, 3, 66, 1
line 84, 4, 90, 2
shape(band([[4, 50], [8, 34], [14, 22], [26, 14], [44, 11], [62, 13], [76, 16], [86, 12],
            [96, 4]], 14, 5), brown)
color yellow
stroke [[10, 30], [16, 21], [28, 13], [44, 9], [60, 11]]
color black
stroke [[12, 40], [18, 27], [30, 19], [46, 16], [62, 18], [74, 20]]

# ---- framing trunks --------------------------------------------------------------------------
fn bark(x1, x2, top, bot, s) {
  let n = 0
  for x in range(x1 + 2, x2 - 1, 3) {
    n += 1
    let y = top + noise(s, n) * 18
    while y < bot - 6 {
      let len = 8 + noise(s + 1, n * 7 + y) * 14
      color noise(s + 2, n + y) < 0.5 ? black : yellow
      stroke x, y, x + (noise(s + 3, y) - 0.5) * 2, y + len
      y += len + 4 + noise(s + 4, n + y) * 8
    }
  }
}
# left trunk with its root flare
shape([[0, 0], [14, 0], [12, 20], [10, 50], [10, 120], [12, 134], [18, 146], [24, 152],
       [16, 152], [12, 160], [10, 167], [0, 167]], brown)
bark(0, 11, 0, 150, 11)
color yellow
stroke 9, 50, 9, 130
# right trunk, lit on its left edge
shape([[139, 0], [159, 0], [159, 167], [146, 167], [142, 160], [136, 152], [139, 140],
       [139, 60]], brown)
bark(140, 159, 0, 150, 31)
color yellow
stroke 140, 2, 140, 140
color lightred
stroke 141, 10, 141, 40
stroke 141, 80, 141, 110
# a knot
color black
stroke arc(152, 140, 3, 5)

# ---- foreground: rock, earth bank, root ------------------------------------------------------
boulder([[44, 136], [48, 128], [56, 124], [62, 130], [64, 138], [52, 140]])
# earth bank along the bottom left
shape([[12, 152], [30, 150], [50, 148], [70, 150], [86, 152], [90, 167], [10, 167]], brown)
color black
for x in [19, 32, 43, 58, 69, 83] {
  stroke x, 153, x, 167
}
color yellow
for x in [25, 38, 50, 63, 76] {
  stroke x, 155, x, 162
}
# darker grass lip above the bank
color green
line 14, 148, 30, 146, 50, 144, 70, 146, 88, 148
# a twisting root crossing to the path
shape(band([[60, 140], [72, 142], [82, 146], [88, 152], [86, 160], [80, 167]], 4, 3), brown)
# rock at the foot of the right trunk
boulder([[136, 162], [138, 152], [146, 148], [148, 158], [146, 167], [136, 167]])

frame()
