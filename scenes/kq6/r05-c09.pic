# Garden Gate of the Beast
# Source: King's Quest VI (VGA) - reference/kq6/r05-c09.png; reframed with:
#   pnpm grid reference/kq6/r05-c09.png --name kq6-r05-c09
# Method: translated by eye. Kept: the two framing tree trunks and the bough arching over the
#   top left, the vine-covered gazebo with its dark door and flowering bushes, the tall forest
#   trunks behind, the green hedge, the stone wall with its two gate pillars and the crouching
#   archer statue, the dark fluted gate, the path through the gate, the lawn, the grey rock,
#   the earth bank at the bottom and a twisting root. Dropped: individual leaves and flowers
#   (a few dots remain), most of the far trunks, the ivy's leaf texture, the little sapling on
#   the bank, grass blades.
# Colours: bright sky → lightcyan, foliage → green / lightgreen, tree bark → brown with yellow
#   lit plates and black grooves, far trunks → darkgrey / lightgrey (aerial perspective),
#   blue-grey stone → lightgrey with darkgrey mortar and shade, tan path → yellow with a brown
#   shadowed run, earth bank → brown, gazebo → green lattice on sky with a black door.
scene "Garden Gate of the Beast"
variants day

# ---- sky -----------------------------------------------------------------------------------
# (delay: the viewer paints this backdrop last, filling in behind the rest; the picture itself is
# unchanged)
delay {
  color lightcyan
  rect 0, 0, 159, 100
}

# ---- far forest: tall trunks and a cross branch (right half) --------------------------------
fn far_trunk(x1, x2, top, bot, c, lit) {
  shape([[x1, top], [x2, top], [x2 + 1, bot], [x1 - 1, bot]], c)
  color lit
  stroke x1 + 1, top + 2, x1 + 1, bot - 2
}
# far foliage behind the trunks, with sky showing through in gaps
blobs([[70, 26, 10, 12], [86, 20, 10, 14], [104, 16, 12, 12], [122, 22, 12, 14],
       [134, 30, 8, 16], [96, 40, 14, 10], [118, 44, 14, 10], [78, 44, 10, 8]], green)
color lightcyan
for g in [[88, 12, 92, 18], [112, 10, 116, 14], [128, 16, 131, 22], [80, 32, 84, 36]] {
  rect g[0], g[1], g[2], g[3]
}
color lightgreen
line 66, 22, 72, 18
line 84, 26, 90, 22
line 118, 30, 124, 27
line 100, 44, 108, 41
far_trunk(92, 94, 0, 70, darkgrey, lightgrey)
far_trunk(98, 106, 0, 72, brown, yellow)
far_trunk(114, 116, 4, 70, lightgrey, white)
far_trunk(124, 128, 0, 72, darkgrey, lightgrey)
# the bough crossing behind
shape(band([[84, 38], [96, 34], [110, 36], [124, 34], [140, 38]], 4, 3), brown)
shape(band([[84, 30], [92, 24], [100, 22]], 3, 2), brown)
# leafy clumps among the trunks
blobs([[110, 22, 7, 6], [118, 26, 6, 5], [130, 16, 6, 5], [86, 14, 5, 6]], green)
color lightgreen
line 107, 20, 111, 18
line 128, 15, 131, 13
line 116, 25, 119, 23

# ---- gazebo (upper left), seen through the arch ---------------------------------------------
# dome
shape([[22, 40], [24, 30], [30, 23], [40, 20], [50, 23], [56, 30], [58, 40], [54, 37],
       [46, 34], [40, 33], [34, 34], [26, 37]], green)
color lightgreen
for a in [-14, -8, -2, 4, 10, 16] {
  stroke 40, 21, 40 + a, 36
}
color lightcyan
stroke arc(40, 37, 17, 5, 270, 450, 15)
# columns
fn gcol(x, top) {
  shape([[x, top], [x + 2, top], [x + 2, 66], [x, 66]], green)
  color lightgreen
  stroke x + 1, top + 2, x + 1, 64
}
gcol(23, 39)
gcol(29, 37)
gcol(35, 36)
gcol(48, 37)
gcol(54, 39)
# dark door
shape([[42, 52], [47, 52], [47, 68], [42, 68]], black)

# ---- flowering bushes either side of the gazebo, and the hedge behind the wall --------------
# green ground behind the hedges so no sky shows under them
color green
rect 56, 56, 140, 88
blobs([[16, 58, 8, 10], [26, 60, 8, 9], [34, 64, 7, 6]], green)
blobs([[54, 60, 7, 8], [64, 56, 8, 10], [72, 54, 7, 8], [74, 64, 8, 8], [84, 60, 8, 12]], green)
blobs([[96, 66, 10, 10], [112, 60, 10, 9], [126, 62, 10, 9], [134, 70, 8, 10],
       [104, 76, 12, 9], [124, 78, 12, 9]], green)
color lightgreen
line 92, 62, 97, 58
line 108, 57, 113, 55
line 122, 60, 128, 58
line 100, 74, 106, 71
line 120, 76, 126, 74
line 61, 55, 66, 52
line 14, 56, 19, 53
# blossoms
for i in 0..44 {
  let x = i < 22 ? 12 + noise(5, i) * 24 : 50 + noise(5, i) * 24
  let y = 50 + noise(6, i) * 16
  color i % 3 == 0 ? lightmagenta : white
  plot x, y
}

# ---- lawn ------------------------------------------------------------------------------------
shape([[0, 68], [40, 68], [60, 74], [92, 84], [140, 86], [159, 86], [159, 167], [0, 167]],
      lightgreen, null)
# path from the gazebo door, behind the wall
shape([[41, 69], [48, 69], [64, 88], [56, 90]], yellow, brown)
color green
line 10, 76, 18, 74
line 24, 80, 32, 78
line 66, 78, 72, 80

# ---- the clearing beyond the gate ------------------------------------------------------------
shape([[90, 96], [96, 92], [104, 93], [108, 98], [106, 106], [96, 108], [90, 104]], yellow, brown)
color brown
line 94, 98, 100, 97
line 96, 103, 102, 102

# ---- the path through the gate ---------------------------------------------------------------
shape([[90, 108], [98, 108], [108, 122], [120, 132], [130, 140], [136, 150], [134, 167],
       [92, 167], [94, 150], [100, 140], [102, 132], [96, 122]], yellow)
