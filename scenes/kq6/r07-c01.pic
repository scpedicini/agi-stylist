# Throne of the Lord of the Dead
# Source: King's Quest VI VGA background, reference/kq6/r07-c01.png (the
#   chained Lord of the Dead on his throne, wings spread, before heaps of skulls);
#   reframed with:
#   pnpm grid reference/kq6/r07-c01.png --name kq6-r07-c01
# Method: translated by eye. Kept: the pale cloudy sky, the bone spire on the left and the
#   rock on the right edge, the two heaps of skulls, the brown folded wing on the left with
#   its lit tresses, the lavender wing on the right, the horned crest, the gaunt face, the
#   iron collar, the chains draped over the chest, the green robe and the drapes over the
#   knees, the two dark carved knobs of the throne arms, the two pale skeletal hands.
# Dropped: the fine rib texture of the wings (a few grooves remain), most of the hair
#   strands, most bony spikes on the skull heaps (two kept), the robe's soft shading, the
#   tangle of extra chain loops (three chains remain).
# Colours: pale blue sky -> lightcyan with white cloud streaks, left wing -> brown with
#   black grooves and a yellow rim, lit orange tresses -> yellow with brown grooves,
#   lavender wing -> lightblue with blue grooves and white lit ribs, crest -> darkgrey with
#   lightblue ridges, face -> lightgrey lit from the right, brown on its orange-lit left,
#   collar and chains -> lightgrey with darkgrey shade and black holes, olive robe -> green
#   with black folds and lightgreen lit folds, throne knobs -> darkgrey with black carving
#   and a yellow rim, hands -> lightcyan with black finger gaps, orange skulls -> brown
#   with yellow tops on a red heap.
scene "Throne of the Lord of the Dead"
variants day

# ---- helpers ---------------------------------------------------------------------------

# one orange skull on the heap: a round brown head, a yellow lit top, maybe eye sockets
fn skull(x, y, eyes = true) {
  color black
  ellipse x, y, 3, 4
  color brown
  ellipse x, y, 2, 3
  color yellow
  stroke [[x - 2, y - 1], [x - 1, y - 3], [x + 1, y - 3]]
  if eyes {
    color black
    stroke [[x - 1, y + 1]]
    stroke [[x + 1, y + 1]]
  }
}

# a heap of skulls under a measured top edge, packed in staggered rows, back to front
fn heap(edge, x1, x2, seed) {
  let row = 0
  for y in range(interp(edge, x1) - 6, 172, 7) {
    let x = x1 + (row % 2) * 4 - 4
    while x <= x2 + 4 {
      let jx = x + noise(seed, x * 7 + y) * 2 - 1
      let jy = y + noise(seed + 1, x + y * 5) * 2 - 1
      if jy >= interp(edge, jx) + 3 {
        skull(jx, jy, noise(seed + 2, x + y) > 0.3)
      }
      x += 8
    }
    row += 1
  }
}

# a chain along a path: alternating face-on rings and side-on links
fn chain(path, step = 9) {
  let links = along(path, step)
  let i = 0
  for p in links {
    if i % 2 == 1 {
      let a = [p[0] - p[2] * 3, p[1] - p[3] * 5]
      let b = [p[0] + p[2] * 3, p[1] + p[3] * 5]
      shape(band([a, b], 5), lightgrey)
    }
    i += 1
  }
  i = 0
  for p in links {
    if i % 2 == 0 {
      let x = p[0]
      let y = p[1]
      color black
      ellipse x, y, 3, 4
      color lightgrey
      ellipse x, y, 2, 3
      color white
      stroke [[x - 2, y], [x - 1, y - 2]]
      color black
      stroke [[x, y - 1], [x, y + 1]]
    }
    i += 1
  }
}

