# ---- throne arms: dark carved heads with a radiating mane ------------------------------
fn knob(cx, cy, rx, ry, seed, rim, rim_pts) {
  shape(blob(cx, cy, rx, ry, seed, 0.1), darkgrey)
  color black
  for a in [210, 240, 270, 300, 330, 30, 60, 90, 120, 150] {
    let k = 0.45 + noise(seed, a) * 0.15
    stroke [[cx + sin(a) * rx * k, cy - cos(a) * ry * k],
            [cx + sin(a) * rx * 0.9, cy - cos(a) * ry * 0.9]]
  }
  # the carved face: lit brow and snout, dark eye
  color lightgrey
  stroke [[cx - 4, cy - 4], [cx, cy - 6], [cx + 4, cy - 4]]
  stroke [[cx - 1, cy + 2], [cx - 1, cy + 6]]
  color black
  ellipse cx - 3, cy - 1, 1, 2
  ellipse cx + 3, cy - 1, 1, 2
  stroke [[cx - 3, cy + 8], [cx + 3, cy + 8]]
  color rim
  stroke rim_pts
}
