line 156, 100, 152, 108, 154, 114
line 146, 128, 150, 138
# dark hollow with a teal bush in it
shape([[138, 96], [140, 88], [146, 84], [152, 86], [155, 92], [152, 98]], black, null)
shape(blob(145, 94, 4, 3, 3, 0.3), cyan, null)
