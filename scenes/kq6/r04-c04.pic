# overhang shadow above the pediment
shape([[10, 10], [14, 4], [24, 2], [34, 4], [20, 8]], brown, null)
shape([[52, 6], [60, 4], [70, 8], [78, 16], [74, 22], [64, 12]], brown, null)
color black
line 10, 30, 12, 50, 10, 70
line 72, 36, 74, 52, 72, 70

# ---- the temple facade ----------------------------------------------------------------
# recessed wall behind the columns
shape([[16, 28], [70, 30], [70, 94], [16, 96]], lightgrey)
color darkgrey
line 17, 30, 17, 94
line 69, 32, 69, 92
# pediment and entablature
shape([[8, 14], [40, 3], [72, 18], [72, 30], [10, 26]], white)
color lightgrey
line 18, 15, 40, 8, 62, 18
line 11, 21, 71, 25
color darkgrey
line 10, 18, 71, 22
line 11, 26, 71, 30
fn column(x, top, bottom) {
  shape([[x, top], [x + 5, top], [x + 5, bottom], [x, bottom]], white)
  color lightgrey
  line x + 3, top + 3, x + 3, bottom - 3
  color darkgrey
  line x + 4, top + 3, x + 4, bottom - 3
  # capital and base
  shape([[x - 1, top], [x + 6, top], [x + 5, top + 2], [x, top + 2]], white)
  shape([[x - 1, bottom - 2], [x + 6, bottom - 2], [x + 6, bottom], [x - 1, bottom]], white)
}
column 20, 29, 94
column 62, 31, 92
# door frame
shape([[30, 30], [57, 31], [57, 92], [30, 93]], white)
color lightgrey
line 32, 32, 32, 91
# black doorway with the half-open plank door
shape([[34, 34], [55, 35], [55, 91], [34, 92]], black)
shape([[34, 34], [46, 35], [46, 91], [34, 92]], brown)
color black
for x in [37, 40, 43] {
  line x, 36, x, 90
}
line 34, 48, 46, 48
line 34, 76, 46, 76
color yellow
line 45, 36, 45, 90

# steps
shape([[8, 94], [80, 90], [88, 96], [86, 101], [16, 109], [6, 104]], white)
color lightgrey
shape([[8, 98], [84, 93], [86, 101], [16, 109], [6, 104]], lightgrey, null)
color darkgrey
line 10, 102, 85, 97
color black
outline [[8, 94], [80, 90], [88, 96], [86, 101], [16, 109], [6, 104]]
line 8, 98, 84, 93

# cave mouth on the far left
shape([[0, 120], [1, 98], [5, 88], [10, 85], [14, 92], [16, 104], [14, 114], [8, 120]], black)

# ---- tumbled rocks right of the temple ------------------------------------------------
# rock behind the pile, so no sky shows between the boulders
shape([[76, 6], [88, 6], [92, 30], [98, 56], [104, 70], [80, 96]], lightgrey, null)
boulder 82, 20, 6, 10, 31
boulder 86, 36, 7, 10, 32
boulder 82, 52, 6, 9, 33
boulder 92, 62, 9, 9, 34
boulder 82, 70, 8, 9, 35
boulder 104, 72, 9, 7, 36
boulder 94, 82, 12, 8, 37
boulder 110, 86, 8, 6, 38
boulder 80, 90, 8, 6, 39

# ---- shadows on the sand --------------------------------------------------------------
shape([[124, 102], [140, 104], [144, 110], [138, 118], [130, 126], [128, 134], [140, 140],
       [142, 130], [140, 120]], brown, null)
shape([[84, 152], [96, 148], [112, 150], [110, 156], [96, 158]], brown, null)
# shade band at the foot of the steps
shape([[14, 110], [86, 101], [96, 102], [60, 110], [24, 114]], brown, null)

# ---- foreground rocks -----------------------------------------------------------------
crag([[0, 112], [6, 114], [10, 126], [12, 140], [16, 152], [20, 167], [0, 167]],
     [[6, 124], [10, 128], [12, 142], [16, 154], [18, 167], [6, 167], [8, 146]])
crag([[18, 167], [19, 140], [21, 120], [24, 106], [27, 106], [32, 116], [36, 126],
