line 142, 93, 145, 91
line 145, 95, 148, 93

# ---- the left cliff the temple is carved into -----------------------------------------
crag([[0, 0], [84, 0], [86, 8], [84, 20], [80, 30], [78, 44], [78, 62], [80, 80],
      [84, 92], [88, 100], [60, 104], [20, 110], [0, 112]],
