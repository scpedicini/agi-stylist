# Temple in the Canyon
# Source: King's Quest VI (VGA) - reference/kq6/r04-c04.png; reframed with:
#   pnpm grid reference/kq6/r04-c04.png --name kq6-r04-c04
# Method: translated by eye. Kept: blue sky, snowy far peak, grey canyon walls, temple facade
#   (pediment, two columns, frame, half-open plank door, black doorway, steps), the left cave
#   mouth, the tumbled rock pile right of the temple, the right cliff with its dark hollow and
#   bush, the sand floor with cliff shadows, the foreground rock spires. Dropped: the frieze
#   lettering, rock speckle, most small boulders, soft shading on the sand. Moved: nothing.
# Colours: pale sky → blue, snowy peak → white with lightblue faces, distant lavender rock →
#   lightgrey with darkgrey shade, pale tan rock (cliff, boulders, spires) → lightgrey lit side
#   with a brown shadow side, carved temple → white with lightgrey/darkgrey lines, orange sand
#   → yellow with brown shadows, door → brown planks, doorway and cave → black, teal bush → cyan.
#   (Tan rock as yellow merged with the sand, so the warmth lives in the brown shadows.)
scene "Temple in the Canyon"
variants day

# ---- sky and the far snowy peak -------------------------------------------------------
# (delay: the viewer paints these backdrops last, farthest last, filling in behind the rest; the
# picture itself is unchanged)
delay 2 {
  color blue
  rect 0, 0, 159, 80
}
shape([[96, 50], [104, 34], [112, 22], [120, 14], [126, 8], [131, 8], [138, 14], [146, 20],
       [154, 24], [159, 26], [159, 70], [96, 70]], white, lightgrey)
# shaded faces
shape([[104, 40], [110, 30], [116, 26], [114, 36], [110, 46]], lightblue, null)
shape([[118, 30], [122, 24], [124, 34], [120, 46], [116, 50]], lightblue, null)
shape([[134, 22], [140, 20], [146, 26], [140, 34], [136, 30]], lightblue, null)
color lightgrey
line 126, 8, 124, 14, 126, 20
line 131, 8, 134, 16

# ---- sand floor ------------------------------------------------------------------------
delay {
  color yellow
  rect 0, 60, 159, 167
}


# ---- helpers ---------------------------------------------------------------------------
# sun-lit rock: light grey with a brown shadow on its lower right, black outline
fn boulder(cx, cy, rx, ry, seed, shade = brown) {
  let pts = blob(cx, cy, rx, ry, seed, 0.2)
  shape(pts, lightgrey)
  shape(shadow_side(pts, cx, cy, rx, ry), shade, null)
  color black
  outline pts
}
# the part of a closed outline below-right of a diagonal through (cx, cy): the shadow side
fn shadow_side(pts, cx, cy, rx, ry) {
  let n = len(pts)
  let k = 0
  for i in 0..n {
    let a = pts[i]
    let b = pts[(i + 1) % n]
    if (a[0] - cx) / rx + (a[1] - cy) / ry <= 0.2 && (b[0] - cx) / rx + (b[1] - cy) / ry > 0.2 {
      k = i + 1
    }
  }
  let out = []
  for j in 0..n {
    let p = pts[(k + j) % n]
    if (p[0] - cx) / rx + (p[1] - cy) / ry <= 0.2 { break }
    push(out, p)
  }
  return out
}
# a crag given as a polygon, with its shadowed side as a second polygon
fn crag(pts, shadow, shade = brown) {
  shape(pts, lightgrey)
  shape(shadow, shade, null)
  color black
  outline pts
}

# ---- grey canyon walls in the hazy middle distance ------------------------------------
# left wall, falling from the top edge to the canyon floor
shape([[80, 0], [86, 0], [90, 8], [94, 18], [98, 26], [102, 36], [106, 44], [110, 52],
       [112, 62], [110, 70], [96, 76], [80, 76]], lightgrey)
# shaded faces (darkgrey: cooler than the brown shade on the near rock)
shape([[96, 28], [102, 38], [106, 48], [108, 60], [102, 56], [98, 44]], darkgrey, null)
color darkgrey
line 88, 4, 90, 14, 96, 26
line 92, 22, 94, 34, 100, 42
line 98, 46, 104, 54, 106, 64
line 94, 50, 98, 60
# right wall, a stack of grey ledges
shape([[116, 66], [118, 58], [124, 54], [130, 48], [138, 42], [146, 34], [152, 28],
       [159, 24], [159, 80], [116, 78]], lightgrey)
shape([[124, 58], [132, 52], [138, 56], [130, 62]], darkgrey, null)
shape([[140, 46], [148, 40], [154, 44], [146, 50]], darkgrey, null)
color darkgrey
line 118, 64, 126, 60, 134, 62
line 126, 54, 134, 50, 140, 54
line 136, 46, 144, 40, 150, 44
line 146, 36, 154, 30
line 122, 70, 130, 68

# ---- near right cliff ------------------------------------------------------------------
crag([[159, 36], [154, 44], [150, 54], [146, 64], [140, 70], [132, 74], [124, 80],
      [122, 88], [126, 94], [136, 96], [146, 100], [150, 106], [146, 114], [142, 122],
      [140, 132], [142, 140], [148, 146], [159, 148]],
