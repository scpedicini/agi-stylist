# Throne Room
# Source: King's Quest VI VGA background, reference/kq6/r07-c05.png
#   (the Castle of the Crown throne room); reframed with:
#   pnpm grid reference/kq6/r07-c05.png --name kq6-r07-c05
# Method: translated by eye. Kept: the vaulted ceiling, the two diagonal cornice beams, the
#   receding arcades of cream-brick arches with dark recesses on both sides, the rows of pink
#   marble columns, the lunette mural over the back wall, the two crowns, the small chandelier,
#   the two thrones on their dais, the side doorway, the red carpet with patterned borders,
#   the lit floor strips and the diamond-patterned marble floor, the big chandelier in front.
# Dropped: the rear row of columns (now one thin shaded red post per opening), the mural's
#   figures (now a few blobs), the vault's rib pattern, column marbling, floor reflections,
#   most of the floor diamonds, voussoir detail.
# Colours: orange walls and vault -> brown with red vault bands, cream brick arches -> yellow
#   with brown joints, purple recesses -> black with a magenta glimpse, pink marble columns -> lightred with red
#   shade and a white highlight, dark column bases -> red with black, orange marble floor ->
#   brown with red diamonds, lit floor strips -> yellow, carpet -> red with yellow borders,
#   gold thrones -> yellow frames on red, big bronze chandelier -> darkgrey arms with
#   yellow cups and bulb, small chandelier -> yellow rims with white candles.
scene "Throne Room"
variants lit

# ---- helpers ---------------------------------------------------------------------------------
fn marble(x1, x2, top, bottom) {
  # pink marble shaft: shaded right side, white highlight, red capital, dark red base
  shape([[x1, top], [x2, top], [x2, bottom], [x1, bottom]], lightred)
  let w = x2 - x1
  if w >= 5 {
    color red
    rect x2 - max(1, round(w / 3)), top + 3, x2 - 1, bottom - 2
    color white
    stroke x1 + max(1, round(w / 4)), top + 4, x1 + max(1, round(w / 4)), bottom - 5
  } else {
    color red
    stroke x2 - 1, top + 3, x2 - 1, bottom - 2
  }
  shape([[x1 - 1, top - 1], [x2 + 1, top - 1], [x2 + 1, top + 2], [x1 - 1, top + 2]], red)
  let bh = max(3, round(w / 2))
  shape(blob((x1 + x2) / 2, bottom + 1, w / 2 + 1.5, bh, 3, 0.05), red)
  color black
  stroke x1, bottom + bh, x2, bottom + bh
}

fn arch(cx, top, rx, ry, bottom, rim) {
  # cream-brick arch rim with brown joints round a magenta recess
  shape(archway(cx, top - rim * 2, rx + rim, ry + rim * 2, bottom), yellow)
  color brown
  for a in range(-75, 76, 30) {
    stroke cx + (rx + 0.5) * sin(a), top + ry - (ry + 0.5) * cos(a),
      cx + (rx + rim) * sin(a), top + ry - (ry + rim * 2) * cos(a)
  }
  shape(archway(cx, top, rx, ry, bottom), black)
  shape(archway(cx + rx * 0.35, top + ry * 0.9, rx * 0.55, ry * 0.7, bottom), magenta, null)
  # a rear column of the far arcade, in shade
  let px = round(cx + rx * 0.1)
  let pw = max(1, round(rx * 0.4))
  color red
  rect px, top + ry * 2.2, px + pw, bottom
  color black
  stroke px - 1, top + ry * 2.2, px - 1, bottom
  stroke px - 1, top + ry * 2.2, px + pw, top + ry * 2.2
}

fn throne(x1, x2, top, bottom) {
  # gold frame, red studded back, seat and legs
  let cx = (x1 + x2) / 2
  shape(archway(cx, top, (x2 - x1) / 2, 4, bottom - 6), yellow)
  shape(archway(cx, top + 2, (x2 - x1) / 2 - 1.5, 3, bottom - 8), red, null)
  color black
  plot cx - 1, top + 6, cx + 1, top + 9, cx - 1, top + 12, cx + 1, top + 15
  shape([[x1 - 1, bottom - 7], [x2 + 1, bottom - 7], [x2 + 1, bottom - 4], [x1 - 1, bottom - 4]], yellow)
  color brown
  line x1, bottom - 5, x2, bottom - 5
  color yellow
  line x1, bottom - 4, x1, bottom
  line x2, bottom - 4, x2, bottom
  plot x1, top, x2, top, cx, top - 2
}

fn crown(cx, y) {
  # gold crown on a little red cushion
  shape([[cx - 3, y + 7], [cx + 3, y + 7], [cx + 3, y + 9], [cx - 3, y + 9]], red)
  shape([[cx - 3, y + 6], [cx - 3, y], [cx - 1.5, y + 3], [cx, y - 1], [cx + 1.5, y + 3], [cx + 3, y], [cx + 3, y + 6]], yellow)
  color white
  plot cx, y + 4
  color red
  plot cx - 2, y + 5, cx + 2, y + 5
}

# ---- walls, ceiling vault ------------------------------------------------------------------------
# (delay: the viewer paints this backdrop last, filling in behind the rest; the picture itself is
# unchanged)
delay {
  color brown
  rect 0, 0, 159, 167
}

# vault bands round the lunette
color red
stroke arc(86, 56, 48, 62, 275, 445, 10)
stroke arc(86, 56, 47, 61, 275, 445, 10)
shape(arc(86, 56, 38, 42, 270, 450, 10), red)
shape(arc(86, 56, 33, 34, 270, 450, 10), brown, null)
color yellow
stroke arc(86, 56, 35, 38, 280, 440, 10)

# ---- lunette mural ------------------------------------------------------------------------------
shape(arc(86, 53, 29, 30, 270, 450, 10), yellow)
shape(arc(86, 53, 26, 26, 270, 450, 10), red)
# figures in the mural
blobs([[73, 46, 4, 6], [80, 42, 3, 8], [88, 42, 4, 9], [96, 45, 4, 6], [102, 49, 3, 3]], brown, black, 0.3, 4)
color yellow
line 73, 42, 74, 47
line 80, 37, 81, 44
line 88, 36, 89, 45
line 96, 41, 97, 47
color lightred
plot 74, 41, 80, 36, 88, 35, 96, 40
color brown
stroke arc(86, 53, 28, 28, 280, 440, 10)

# cornice under the lunette
shape([[58, 51], [114, 51], [114, 55], [58, 55]], yellow)
color brown
line 58, 53, 114, 53
color black
line 58, 55, 114, 55

# ---- back wall --------------------------------------------------------------------------------
shape([[66, 56], [114, 56], [114, 108], [66, 108]], brown, null)
# doorway at the right
shape([[109, 82], [118, 82], [118, 108], [109, 108]], red)
shape([[111, 85], [117, 85], [117, 108], [111, 108]], black)
# pilasters with crowns
marble 69, 72, 72, 104
marble 105, 108, 72, 104
crown 71, 61
crown 107, 61

# ---- small chandelier before the back wall ------------------------------------------------------
color black
line 91, 24, 91, 58
color black
stroke arc(91, 61, 11, 6, 90, 270, 20)
stroke arc(91, 69, 8, 4, 90, 270, 20)
line 91, 58, 91, 78
color yellow
stroke arc(91, 60, 11, 6, 90, 270, 20)
stroke arc(91, 68, 8, 4, 90, 270, 20)
shape([[88, 72], [94, 72], [91, 78]], yellow)
color white
for x in [81, 85, 89, 93, 97, 101] { line x, 58, x, 60 }
for x in [84, 88, 94, 98] { line x, 67, x, 69 }

# ---- left arcade --------------------------------------------------------------------------------
arch 63.5, 57, 2.5, 5, 120, 2.5
arch 54, 50, 3, 6, 125, 3
arch 42.5, 42, 3.5, 7, 132, 4
arch 26, 30, 4, 8, 140, 5
arch 9, 18, 4, 9, 150, 6
# right arcade
arch 118, 49, 2.5, 5, 120, 2.5
arch 125, 40, 3, 6, 125, 3.5
arch 136, 28, 3.5, 7, 132, 4.5
arch 152, 12, 4, 8, 140, 5.5

# ---- cornice beams ----------------------------------------------------------------------------
let lb = [[14, -4], [70, 56]]
let rb = [[142, -4], [112, 56]]
shape(band(lb, 5, 3), yellow)
color black
stroke offset(lb, 3)
shape(band(rb, 5, 3), yellow)
color black
stroke offset(rb, -3)

# ---- floor ------------------------------------------------------------------------------------
shape([[0, 140], [64, 108], [116, 108], [160, 140], [160, 167], [0, 167]], brown, null)
# red marble diamonds with pale grout
fn diamond(cx, cy, rx, ry) {
  shape([[cx - rx, cy], [cx, cy - ry], [cx + rx, cy], [cx, cy + ry]], red, lightred)
}
diamond 12, 156, 13, 7
diamond 30, 140, 9, 5
diamond 44, 128, 6, 3
diamond 140, 156, 13, 7
diamond 130, 138, 9, 5
diamond 121, 126, 6, 3
# lit strips beside the carpet
shape([[58, 117], [72, 117], [42, 168], [16, 168]], yellow, null)
shape([[100, 117], [110, 117], [130, 168], [92, 168]], yellow, null)

# ---- dais, thrones and carpet -------------------------------------------------------------------
shape([[64, 104], [116, 104], [110, 112], [70, 112]], yellow)
shape([[70, 112], [110, 112], [110, 117], [70, 117]], red)
color yellow
line 70, 113, 110, 113
shape([[79, 104], [104, 104], [104, 112], [76, 112]], red, null)
throne 81, 89, 84, 105
throne 97, 104, 84, 105

# carpet with patterned borders
shape([[72, 117], [101, 117], [92, 168], [38, 168]], red)
shape(band([[73, 117], [40, 168]], 6, 9), yellow)
shape(band([[100, 117], [91, 168]], 4, 7), yellow)
color brown
for p in along([[73, 117], [40, 168]], 4) { plot p[0], p[1] }
for p in along([[100, 117], [91, 168]], 4) { plot p[0], p[1] }

# ---- marble columns, back to front ---------------------------------------------------------------
marble 65, 68, 74, 108
marble 55, 59, 70, 113
marble 44, 49, 66, 120
marble 31, 37, 62, 128
marble 14, 21, 57, 138
marble -3, 6, 50, 150
marble 119, 123, 66, 112
marble 129, 134, 62, 120
marble 139, 145, 58, 128
marble 151, 158, 52, 138

# ---- big chandelier in front ---------------------------------------------------------------------
fn arm(pts, w = 3) {
  shape(band(pts, w + 1, 3), darkgrey)
  color lightgrey
  stroke slice(offset(pts, -1), 1)
}
shape([[65, 0], [67, 0], [67, 18], [65, 18]], black)
arm [[60, 28], [48, 32], [38, 26], [36, 14]], 4
arm [[62, 22], [53, 20], [50, 10]]
arm [[72, 28], [84, 32], [94, 26], [95, 15]], 4
arm [[70, 22], [78, 18], [80, 9]]
arm [[63, 30], [56, 36], [46, 37], [42, 32]]
arm [[69, 30], [76, 36], [86, 37], [89, 32]]
arm [[66, 18], [64, 8], [60, 4]]
# candle cups and candles
for c in [[36, 14], [50, 10], [95, 15], [80, 9], [42, 32], [89, 32], [60, 4]] {
  shape([[c[0] - 3, c[1]], [c[0] + 3, c[1]], [c[0] + 2, c[1] + 2], [c[0] - 2, c[1] + 2]], yellow)
  color white
  rect c[0] - 1, c[1] - 4, c[0], c[1] - 1
}
# bulb and finial
shape(blob(66, 27, 6, 7, 2, 0.05), yellow)
color brown
stroke arc(66, 27, 5, 6, 90, 200, 15)
color white
plot 64, 23, 64, 24
shape([[64, 34], [68, 34], [66, 40]], brown)

frame()
