# the trunk winds down from the top and splits into roots
let trunk = [[38, 0], [35, 14], [40, 26], [36, 40], [33, 56], [36, 70], [34, 86]]
sil(trunk, 10, 12)
# roots spreading from the trunk's foot
sil([[34, 84], [24, 96], [14, 108], [4, 118]], 6, 4)
sil([[36, 84], [32, 100], [26, 116], [22, 132]], 5, 4)

# ---- foreground ribbed roots ------------------------------------------------------------
root([[20, 104], [30, 98], [40, 96], [52, 100], [62, 108]], 5, 3)
root([[0, 124], [14, 112], [26, 104], [36, 104]], 6, 4)
root([[0, 150], [20, 136], [40, 124], [56, 120], [70, 124]], 7, 5)
# the toothed tentacle mouth reaching for the ledge
root([[30, 167], [44, 150], [56, 134], [64, 124], [72, 116]], 8, 5)
color lightcyan
for i in 0..6 {
  let x = 62 + i * 3
  let y = 110 + i * 2
  line x, y, x + 1, y + 5
}
root([[0, 167], [12, 158], [24, 152], [34, 150]], 6, 5)
root([[10, 140], [16, 150], [20, 167]], 6, 6)
# right foreground roots
root([[96, 167], [112, 156], [128, 148], [144, 144], [162, 140]], 7, 6)
root([[88, 140], [104, 133], [120, 131], [136, 134]], 4, 3)
color lightcyan
for i in 0..7 {
