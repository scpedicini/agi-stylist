# Village Street
# Source: King's Quest VI (VGA), reference/kq6/r03-c05.png (the village on the
#   Isle of the Crown: Ali's bookshop and the pawn shop); reframed with:
#   pnpm grid reference/kq6/r03-c05.png --name kq6-r03-c05
# Method: translated by eye. Kept: blue sky, palms and a dark cypress behind the roofs, the
#   arched town wall with its onion-domed gate pillar and tower, the striped awning, Ali's
#   two-storey bookshop (shuttered windows, tiled lean-to roof, arched sign, door, window,
#   stairs, bench), the Pawn Shoppe (sign board, door, grilled window, shutter, back house
#   with tiled roof), the long diagonal shadow across the sand, the blue pots, steps, chest and
#   clay jugs, and the ferns and basket pot in the left foreground.
#   Dropped: the leaning shield, the lantern, the lettering (scribbles stand in), the little
#   notice's text, the stone texture of the street, the second pot on the bench.
# Colours: sky → lightblue, sunlit adobe → yellow, brightest lit faces → white, shaded adobe
#   and wood → brown, shutters → brown, tiles → red with lightred joints, glazed pots →
#   lightblue/blue, sand → yellow with a brown shadow band, foliage → green/lightgreen.
scene "Village Street"
variants day

# ---- sky -------------------------------------------------------------------------------------
# (delay: the viewer paints these backdrops last, farthest last, filling in behind the rest; the
# picture itself is unchanged)
delay 3 {
  color lightblue
  rect 0, 0, 159, 90
}

# ---- ground (sand) -----------------------------------------------------------------------------
delay 2 {
  color yellow
  rect 0, 84, 159, 167
}
# the long shadow the shops throw across the street
delay {
  shape([[38, 86], [159, 86], [159, 152], [130, 139], [100, 124], [80, 113], [64, 104],
         [50, 96]], brown, null)
}

# ---- palms and trees behind the roofs ---------------------------------------------------------
fn frond(x, y, dx, dy, c = green) {
  # a drooping leaf: arches up in the middle, thick at the middle, pointed at the tip
  shape([[x, y], [x + dx * 0.5, y + dy * 0.5 - 4], [x + dx, y + dy], [x + dx * 0.5, y + dy * 0.5 - 1]],
        c)
}
fn palm(x, y, bx, by) {
  # trunk from the base (bx, by) up to the crown (x, y)
  color brown
  line bx, by, (x + bx) / 2 + 1, (y + by) / 2, x, y
  line bx + 1, by, (x + bx) / 2 + 2, (y + by) / 2, x + 1, y
  color black
  line bx + 2, by, (x + bx) / 2 + 3, (y + by) / 2, x + 2, y
  frond x, y, -11, 7
  frond x, y, 11, 8
  shape(blob(x, y, 7, 5, x, 0.35), green)
  color lightgreen
  line x - 5, y + 1, x - 1, y - 2, x + 3, y - 1
  line x - 2, y + 3, x + 2, y + 1, x + 5, y + 3
  color black
  line x - 4, y + 3, x + 1, y + 4
}
