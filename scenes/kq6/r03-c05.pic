# shuttered windows, upper floor
fn shutters(x1, y1, x2, y2, slope = 0) {
  # opening from x1..x2, tops sloping by `slope` rows per column; shutters either side
  let w = x2 - x1
  shape([[x1, y1], [x2, y1 + slope * w], [x2, y2 + slope * w], [x1, y2]], black, null)
  shape([[x1 - 3, y1 + 1], [x1 - 1, y1], [x1 - 1, y2], [x1 - 3, y2 - 1]], brown)
  shape([[x2 + 1, y1 + slope * w], [x2 + 3, y1 + slope * w], [x2 + 3, y2 + slope * w - 1],
         [x2 + 1, y2 + slope * w]], brown)
}
