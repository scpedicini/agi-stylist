# ---- left foreground: ferns and a basket pot ----------------------------------------------------
fn fern(x, y, dx, dy, c = green) {
  # one broad fern leaf from (x, y) to (x + dx, y + dy), with a midrib in the partner colour
  frond x, y, dx, dy, c
  color c == green ? lightgreen : green
  line x + dx * 0.15, y + dy * 0.15 - 1, x + dx * 0.5, y + dy * 0.5 - 2, x + dx * 0.85, y + dy * 0.85
}
shape(blob(3, 125, 8, 30, 6, 0.3), green)
