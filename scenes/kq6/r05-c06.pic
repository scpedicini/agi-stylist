shape(band([[6, 82], [5, 66], [7, 52], [5, 40], [8, 32]], 5, 2), brown)
shape(band([[6, 60], [14, 52], [20, 42], [26, 32]], 3, 1), brown)
shape(band([[24, 80], [26, 66], [30, 54], [36, 44], [42, 36]], 3, 1), brown)
fn leaf(x, y) {
  shape([[x - 2, y], [x, y - 3], [x + 2, y - 2], [x + 2, y + 1], [x, y + 2]], green)
  color lightgreen
  line x, y - 1, x, y - 1
}
for p in [[10, 34], [3, 46], [14, 48], [18, 38], [24, 30], [10, 60], [30, 50], [36, 40], [40, 34],
          [28, 62], [22, 70], [2, 56], [44, 46], [34, 58]] {
  leaf(p[0], p[1])
}
# grape bunch
blobs([[12, 43, 2, 3], [12, 47, 1, 2]], magenta, black, 0.15, 4)
color lightmagenta
line 11, 42, 11, 42
line 12, 46, 12, 46

# ---- red chair against the right wall -------------------------------------------------------
color brown
line 148, 58, 147, 67
line 157, 58, 158, 67
line 152, 58, 152, 64
shape(blob(155, 48, 4, 8, 2, 0.05), red)
color yellow
stroke arc(155, 48, 4, 8, 250, 470, 20)
color lightred
