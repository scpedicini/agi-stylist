# ---- baby's tears ----------------------------------------------------------------------
for p in [[60, 103], [72, 102], [78, 104], [86, 103], [70, 108], [76, 110], [82, 109],
          [88, 108], [72, 114], [78, 116], [84, 114], [66, 118], [74, 120], [80, 120],
          [56, 120], [62, 106]] {
  color lightcyan
  rect p[0] - 1, p[1], p[0] + 1, p[1] + 1
  color white
  line p[0] - 1, p[1], p[0], p[1]
  color cyan
  line p[0] - 1, p[1] + 2, p[0] + 1, p[1] + 2
}

# ---- wallflower faces in bonnets -----------------------------------------------------------
fn baby(x, y, s = 1) {
  # frilled bonnet behind the face
  shape(blob(x, y - 1, 7 * s, 9 * s, 3, 0.18, 20), lightblue)
  color lightcyan
  stroke arc(x, y - 1, 6 * s, 8 * s, 290, 420, 20)
  # face
  shape(blob(x, y + 1, 5 * s, 6 * s, 2, 0.06), brown)
  color yellow
  line x - 3 * s, y - 2, x - 3 * s, y + 1
  color black
  line x - 2, y - 1, x - 2, y - 1
  line x + 1, y - 1, x + 1, y - 1
  line x, y + 2, x, y + 3
  color white
  line x - 1, y + 6 * s, x + 1, y + 6 * s
  # leaves under the chin
  color lightgreen
  stroke [[x - 6 * s, y + 8 * s], [x - 3, y + 6 * s]]
  stroke [[x + 6 * s, y + 8 * s], [x + 3, y + 6 * s]]
}
baby 9, 95
baby 19, 107
baby 4, 125
baby 28, 129, 1.15

