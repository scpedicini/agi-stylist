# ---- tomato clumps ---------------------------------------------------------------------
fn tomato(x, y, rx = 3, ry = 3) {
  shape(blob(x, y, rx, ry, x + y, 0.08), red)
  color lightred
  line x - rx + 1, y - ry + 1, x - rx + 1, y
  color black
  line x, y, x + 1, y
}
fn stalk(pts) {
  shape(band(pts, 4, 2), black, null)
}
stalk([[28, 96], [28, 86], [29, 74]])
stalk([[44, 112], [44, 98], [46, 84]])
stalk([[60, 132], [62, 116], [64, 102]])
for t in [[29, 76], [26, 82], [31, 85], [28, 91], [45, 86], [42, 92], [48, 95], [41, 100],
          [47, 102], [42, 107]] {
  tomato(t[0], t[1])
}
tomato(56, 112, 4, 5)
tomato(66, 111, 4, 5)
tomato(59, 124, 3, 4)
tomato(52, 133, 3, 4)
color green
line 62, 104, 63, 101
line 30, 72, 28, 70
