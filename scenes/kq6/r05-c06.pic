       [12, 24, 8, 5]], green, black, 0.28, 2)
blobs([[110, 14, 7, 5], [120, 8, 9, 6], [134, 5, 11, 6], [150, 6, 12, 8], [128, 14, 8, 4],
       [144, 13, 8, 5], [100, 19, 5, 3]], green, black, 0.28, 5)
color lightgreen
line 4, 6, 8, 3, 12, 5
line 16, 10, 20, 7
line 22, 18, 26, 16
line 6, 16, 10, 14
line 116, 7, 121, 5, 124, 7
line 132, 3, 138, 2
line 146, 6, 151, 4, 155, 6
line 106, 13, 110, 11
color black
line 10, 12, 14, 14
line 24, 24, 28, 25
line 126, 11, 132, 12
line 140, 10, 144, 11

# ---- what shows through the gateway -------------------------------------------------------
# far checkerboard dune
for row in 0..4 {
  let y = 56 + row * 3
  for col in 0..12 {
    let x = 50 + col * 4
    color (col + row) % 2 == 0 ? lightred : magenta
    rect x, y, x + 3, y + 2
  }
}
color black
line 52, 56, 64, 55, 78, 55, 92, 57
# stone landing and stair beyond the gate
shape([[56, 66], [92, 66], [97, 87], [51, 87]], lightgrey)
color darkgrey
line 58, 70, 90, 70
line 56, 74, 92, 74
line 54, 78, 94, 78
# newel posts
fn post(x, top, bottom) {
  color darkgrey
  rect x - 1, top + 2, x + 1, bottom
  ellipse x, top + 1, 1, 2
  color black
  line x + 1, top + 2, x + 1, bottom
}
post 66, 60, 70
post 78, 60, 70

# ---- the garden wall ------------------------------------------------------------------------
fn edge_pts(e, x1, x2, k, b) {
  # points along the course line k (0 = top edge, 1 = bottom edge b) between columns x1..x2
  let pts = []
  let x = x1
  while x <= x2 {
    let t = interp(e, x)
    push(pts, [x, t + (interp(b, x) - t) * k])
    x += 3
  }
  let t2 = interp(e, x2)
  push(pts, [x2, t2 + (interp(b, x2) - t2) * k])
  return pts
}

# left run
let LT = [[0, 22], [20, 25], [34, 28], [46, 33]]
let lb = [[0, 79], [159, 79]]
shape([[0, 22], [20, 25], [34, 28], [48, 33], [48, 79], [0, 79]], lightgrey)
color white
stroke edge_pts(LT, 0, 44, 0.03, lb)
for k in 1..6 {
  color darkgrey
  stroke edge_pts(LT, 0, 46, k / 6, lb)
  # vertical joints, staggered
  let off = k % 2 == 0 ? 0 : 5
  let x = off + 2
  while x < 44 {
    let ya = interp(LT, x) + (79 - interp(LT, x)) * (k - 1) / 6
    let yb = interp(LT, x) + (79 - interp(LT, x)) * k / 6
    line x, ya + 1, x - 1, yb
    x += 10
  }
}

# right run (rises away from the gate)
let RT = [[86, 32], [100, 26], [115, 22], [130, 19], [145, 15], [159, 13]]
let RBp = [[86, 80], [100, 74], [115, 70], [135, 68], [159, 66]]
let rb = RBp
shape([[86, 32], [100, 26], [115, 22], [130, 19], [145, 15], [159, 13], [159, 66], [135, 68],
       [115, 70], [100, 74], [86, 80]], lightgrey)
color white
stroke edge_pts(RT, 90, 159, 0.04, rb)
for k in 1..6 {
  color darkgrey
  stroke edge_pts(RT, 88, 159, k / 6, rb)
  let off = k % 2 == 0 ? 0 : 8
  let x = 96 + off
  while x < 159 {
    let t = interp(RT, x)
    let b = interp(rb, x)
    let ya = t + (b - t) * (k - 1) / 6
    let yb = t + (b - t) * k / 6
    line x, ya + 1, x - 1, yb
    x += 14 + (x - 96) / 10
  }
}
color black
stroke RT

# ---- the gate pillars -----------------------------------------------------------------------
# Each pillar is a thick curved horn: a darkgrey body, a lightgrey lit strip on the gate side,
# a hooked knob on top bending towards the gate, and a broken top floating above it.
fn pillar(path, w1, w2, dx, knob, frag) {
  let body = band(path, w1, w2)
  shape(body, darkgrey)
  shape(band(shift(path, dx, 0), w1 * 0.5, w2 * 0.4), lightgrey, null)
  color black
  outline body
  boulder(knob, lightgrey, darkgrey, black, dx > 0 ? 0.2 : -0.2)
  boulder(frag, lightgrey, darkgrey, black, 0.3)
}
pillar([[47, 85], [48, 70], [50, 56], [52, 44], [55, 34]], 32, 16, 3,
       [[49, 33], [50, 28], [54, 25], [59, 26], [62, 30], [62, 35], [59, 33], [55, 33]],
       [[57, 6], [59, 3], [62, 4], [62, 20], [60, 23], [57, 21]])
pillar([[93, 85], [92, 70], [89, 56], [86, 44], [82, 33]], 30, 16, -3,
       [[87, 32], [87, 27], [83, 23], [78, 24], [75, 28], [75, 33], [78, 31], [82, 32]],
       [[79, 18], [83, 4], [86, 2], [88, 5], [84, 20], [80, 21]])
# a groove or two down each shaft
color black
stroke [[57, 46], [56, 56], [56, 66]]
stroke [[83, 46], [85, 58], [86, 68]]
color lightgrey
stroke [[53, 70], [53, 80]]

# ---- lawns ---------------------------------------------------------------------------------
# left lawn (shaded green) under the left wall and pillar
shape([[0, 79], [42, 79], [52, 82], [72, 84], [90, 84], [100, 84], [100, 167], [0, 167]], green)
# right lawn (sunny)
shape([[86, 82], [100, 74], [115, 70], [135, 68], [159, 66], [159, 167], [86, 167]], lightgreen)
shape([[96, 78], [100, 74], [115, 70], [135, 68], [159, 66], [159, 80], [148, 78], [140, 82],
       [128, 80], [118, 83], [108, 82], [100, 86]], green, null)
color green
for p in [[112, 92], [124, 100], [136, 90], [104, 104], [130, 110], [144, 96], [118, 108]] {
  line p[0], p[1], p[0] + 2, p[1] - 2
  line p[0] + 3, p[1], p[0] + 4, p[1] - 3
}
# dark tufted grass in the right foreground
shape([[104, 132], [118, 130], [132, 126], [142, 116], [148, 104], [154, 96], [159, 92],
       [159, 167], [60, 167], [80, 150], [96, 140]], green)
fn tufts(x1, y1, x2, y2, dx, dy) {
  color black
  let y = y1
  let r = 0
  while y <= y2 {
    let x = x1 + (r % 2) * dx / 2
    while x <= x2 {
      stroke [[x - 2, y + 1], [x, y - 1], [x + 2, y + 1]]
      x += dx
    }
    y += dy
    r += 1
  }
}
tufts(110, 138, 159, 166, 7, 6)
tufts(136, 124, 159, 136, 8, 6)
tufts(150, 102, 159, 120, 8, 7)
tufts(92, 148, 108, 166, 7, 6)
color lightgreen
line 120, 136, 122, 134
line 140, 150, 142, 148
line 128, 158, 130, 156
line 150, 130, 152, 128
color black
outline [[104, 132], [118, 130], [132, 126], [142, 116], [148, 104], [154, 96], [159, 92]]

# ---- the cobble path -----------------------------------------------------------------------
let PL = [[70, 84], [80, 92], [88, 100], [93, 108], [92, 116], [86, 126], [76, 136], [62, 146],
          [48, 156], [34, 168]]
let PR = [[92, 84], [102, 90], [110, 100], [115, 110], [114, 120], [108, 130], [98, 140],
          [88, 150], [82, 160], [78, 168]]
let outlinePts = []
for p in PL { push(outlinePts, p) }
for i in 0..len(PR) { push(outlinePts, PR[len(PR) - 1 - i]) }
shape(outlinePts, brown)
fn mix(a, b, f) { return [a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f] }
# cross joints: each segment between matched edge points split into rows of cobbles
for i in 0..len(PL) - 1 {
  let rows = i < 3 ? 2 : 3
  for r in 0..rows {
    let f = r / rows
    let a = mix(PL[i], PL[i + 1], f)
    let b = mix(PR[i], PR[i + 1], f)
    color black
    stroke a, b
    # long joints inside this row, staggered
    let a2 = mix(PL[i], PL[i + 1], (r + 1) / rows)
    let b2 = mix(PR[i], PR[i + 1], (r + 1) / rows)
    let n = i < 3 ? 3 : 4
    for j in 1..n {
      let g = (j - ((i * rows + r) % 2) * 0.5) / n
      if g <= 0.05 { continue }
      let p = mix(a, b, g)
      let q = mix(a2, b2, g)
      stroke p, q
    }
    # lit top of the cobbles
    if (i * rows + r) % 2 == 0 {
      color yellow
      let c1 = mix(a, b, 0.2)
      let c2 = mix(a, b, 0.32)
      stroke [c1[0], c1[1] + 1], [c2[0], c2[1] + 1]
    }
  }
}
color black
stroke PL
stroke PR

