             [70, 40, 6, 6], [40, 40, 6, 6]]
blobs(puffs, lightgrey, null, 0.2, 3)
let tops = []
for p in puffs { push(tops, [p[0] - 1, p[1] - 2, p[2] - 1, p[3] - 1]) }
blobs(tops, white, null, 0.2, 3)

# ---- tree crowns behind the wall ------------------------------------------------------------
