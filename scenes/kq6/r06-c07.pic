# The Root Gate
# Source: King's Quest VI (VGA), reference/kq6/r06-c07.png; reframed with:
#   pnpm grid reference/kq6/r06-c07.png --name kq6-r06-c07
# Method: translated by eye. Kept: teal gloom sky, jagged far spires with pale lit edges, the
#   indigo rocks at the left, the huge tangle of ribbed roots with its top ring and dark hole,
#   the fan of fibres in the middle, the two ribbed horn pillars of the gateway (lit inner
#   stripe, sky rim outside), the winding pale path, the ribbed floor, the bone ladder at the
#   lower right, the ochre horns in the corners. Dropped: most of the small tubes and coils
#   inside the tangle (one coil kept), the hanging blue strands at the right, the mist gradient.
# Colours: slate-teal sky → cyan, dark teal spires → blue with lightcyan lit edges, indigo
#   rocks → blue with lightblue rims, ochre ribbed roots → brown with black ribs and yellow lit
#   edges, deep gaps → black, pale olive path → yellow, ribbed floor → brown, bones → white
#   with lightgrey undersides.
scene "The Root Gate"
variants night

# ---- helpers ----------------------------------------------------------------------------
# black (or c) rib strokes across a band drawn along `path`, w1 → w2 rows wide
fn ribs(path, w1, w2, step, c = black, frac = 0.7) {
  let pts = along(path, step)
  let n = len(pts)
  color c
  for i in 1..n {
    let p = pts[i]
    let sx = p[2] * 2
    let sy = p[3]
    let l = max(0.001, sqrt(sx * sx + sy * sy))
    let half = (w1 + (w2 - w1) * i / max(1, n - 1)) / 2 * frac
    let nx = -sy / l * half / 2
    let ny = sx / l * half
    stroke [p[0] - nx, p[1] - ny], [p[0] + nx * 0.6, p[1] + ny * 0.6 + 1], [p[0] + nx, p[1] + ny]
  }
}

# a ribbed root tube: brown body, black ribs, optional yellow lit line on one side
fn tube(path, w1, w2, lit = 0, step = 11, c = brown, light = yellow) {
  shape(band(path, w1, w2), c)
  ribs(path, w1, w2, step)
  if lit != 0 {
    color light
    stroke offset(path, lit)
  }
}

# a far spire: blue body, lit face strip along one edge
fn spire(pts, lit) {
  shape(pts, blue)
  color lightcyan
  stroke lit
}

# ---- sky ----------------------------------------------------------------------------------
# (delay: the viewer paints these backdrops last, farthest last, filling in behind the rest; the
# picture itself is unchanged)
delay 2 {
  color cyan
  rect 0, 0, 159, 167
}

# ---- far spires, left -----------------------------------------------------------------------
spire([[16, 2], [22, 30], [26, 60], [30, 100], [0, 100], [0, 40], [6, 20]],
      [[16, 3], [10, 14], [4, 26], [2, 36]])
shape([[16, 4], [8, 18], [3, 30], [4, 36], [10, 24]], lightcyan, null)
spire([[27, 18], [30, 45], [34, 90], [10, 90], [12, 66], [18, 46], [23, 30]],
      [[27, 19], [22, 36], [17, 52], [12, 66]])
spire([[40, 0], [36, 20], [34, 50], [38, 90], [30, 90], [28, 50], [32, 20], [36, 0]],
      [[36, 2], [32, 22], [29, 48]])

# ---- far spires, right ----------------------------------------------------------------------
spire([[131, 8], [136, 40], [140, 90], [118, 90], [122, 55], [128, 30]],
      [[131, 9], [132, 25], [130, 40], [126, 50]])
spire([[142, 0], [148, 20], [154, 60], [159, 70], [159, 95], [134, 95], [138, 50], [140, 20]],
      [[142, 3], [144, 20], [143, 35], [141, 55]])
color lightcyan
stroke [143, 30], [148, 22]
stroke [140, 65], [137, 80]

# ---- the root tangle: dark mass behind everything --------------------------------------------
delay {
  shape([[36, 0], [120, 0], [122, 30], [126, 60], [134, 92], [140, 120], [140, 140], [30, 140],
         [30, 100], [36, 70], [40, 40], [38, 20]], black)
}

# the fan of fibres in the middle (behind the tubes): tapering rays of varied length
for i in 0..13 {
  let a = -60 + i * 10 + (noise(4, i) - 0.5) * 4
  let r = 34 + noise(9, i) * 14
  let path = [[70 + sin(a) * 3, 70 - cos(a) * 6], [70 + sin(a) * r / 2, 72 - cos(a) * r]]
  shape(band(path, 2, 5), brown, null)
  color i % 3 == 1 ? black : yellow
  stroke path
}

# tubes hanging through the inside, back ones first
tube([[44, 30], [48, 55], [46, 80], [42, 112]], 14, 12, 4, 11)
tube([[58, 14], [54, 40], [58, 62], [60, 76]], 10, 8, 3, 11)
tube([[96, 34], [92, 56], [96, 80], [100, 100], [98, 116]], 12, 14, -4, 11)
tube([[82, 30], [86, 52], [84, 72], [80, 86]], 8, 8, -3, 11)
tube([[110, 36], [118, 62], [126, 92], [132, 120]], 14, 16, 0, 11)
tube([[84, 58], [88, 74], [90, 92], [96, 110]], 10, 12, -3, 11)
tube([[72, 82], [78, 94], [84, 106], [88, 118]], 8, 10, 3, 11)

# the big top ring around the dark hole
tube([[38, 4], [60, 4], [80, 3], [100, 2], [122, 4]], 12, 12, 0, 11)
tube([[82, 20], [84, 10], [92, 4], [104, 4], [112, 10], [114, 22], [110, 32], [100, 36],
      [90, 34], [84, 28], [82, 20]], 10, 10, 0, 10)
shape(blob(98, 20, 7, 11, 3, 0.1), black, null)
tube([[40, 44], [42, 28], [48, 16], [58, 9], [70, 8], [80, 12]], 12, 8, -4, 11)

# one coil on the left inside
ellipse 46, 102, 8, 13
color brown
ellipse 46, 102, 7, 12
color black
stroke arc(46, 102, 5, 9, 0, 300, 20)
stroke arc(46, 103, 2, 4, 0, 330, 30)
color yellow
stroke arc(46, 102, 7, 12, 300, 420, 15)

# ---- near indigo rocks, left -----------------------------------------------------------------
shape([[18, 82], [24, 100], [27, 125], [26, 150], [0, 150], [0, 118], [8, 100]], blue)
color lightblue
stroke [18, 83], [10, 98], [3, 112]
stroke [20, 96], [14, 112], [10, 126]
color black
stroke [20, 104], [22, 128], [22, 148]
# the hooked lip at its foot
color lightblue
stroke [24, 121], [14, 125], [8, 130], [10, 140], [14, 146]

# ---- floor and path ---------------------------------------------------------------------------
shape([[30, 116], [60, 112], [100, 112], [128, 118], [150, 130], [159, 140], [159, 167],
       [0, 167], [0, 146], [20, 140]], brown)
# the winding path, narrow at the gate, wide at the front
shape([[64, 76], [72, 76], [76, 84], [74, 92], [76, 100], [82, 108], [88, 116], [96, 126],
       [102, 140], [104, 152], [104, 167], [48, 167], [48, 152], [52, 140], [56, 128],
       [58, 118], [60, 110], [57, 102], [60, 92], [62, 84]], yellow)
color brown
stroke [66, 86], [64, 96], [66, 108], [64, 120], [60, 134], [58, 150], [56, 166]
stroke [72, 98], [76, 110], [84, 124], [90, 140], [94, 166]
# ripples on the floor
color black
stroke arc(40, 168, 30, 26, 300, 360, 10)
stroke arc(24, 168, 22, 16, 330, 380, 10)
stroke arc(132, 168, 26, 30, 0, 60, 10)
stroke arc(136, 168, 22, 18, 0, 50, 10)
color yellow
stroke [32, 128], [44, 124], [54, 122]
stroke [106, 122], [118, 126], [128, 132]

# ---- the gateway horns --------------------------------------------------------------------------
let lpil = [[31, 166], [30, 140], [31, 115], [34, 90], [38, 66], [44, 44], [50, 28], [55, 18],
            [60, 12]]
tube(lpil, 40, 4, 0, 11)
color yellow
stroke offset(slice(lpil, 1, 9), 5)
stroke offset(slice(lpil, 2, 8), 4)
color lightblue
stroke offset(slice(lpil, 2, 9), -7)

let rpil = [[86, 18], [94, 26], [102, 40], [108, 58], [112, 80], [114, 104], [116, 130],
            [117, 150]]
tube(rpil, 4, 32, 0, 11)
color yellow
stroke offset(slice(rpil, 0, 7), -5)
stroke offset(slice(rpil, 1, 6), -4)
color lightblue
stroke offset(slice(rpil, 1, 6), 6)

# ---- bone ladder, lower right -------------------------------------------------------------------
fn bone(x1, y1, x2, y2) {
  shape(band([[x1, y1], [x2, y2]], 5, 5), white)
  shape(blob(x2, y2, 2, 3, 1, 0), white)
  shape(blob(x1, y1, 2, 3, 2, 0), white)
  color lightgrey
  stroke [x1 + 1, y1 + 1], [x2, y2 + 1]
}
shape([[112, 134], [122, 128], [134, 132], [140, 146], [138, 162], [114, 164], [108, 150]], black, null)
bone 110, 147, 124, 139
bone 114, 152, 130, 143
bone 117, 157, 134, 148
bone 120, 162, 128, 158

# ---- ochre horns framing the corners --------------------------------------------------------------
tube([[150, 167], [146, 130], [144, 110], [140, 90]], 30, 3, 0, 11)
color yellow
stroke offset([[150, 167], [146, 130], [144, 110], [141, 92]], -5)
tube([[2, 167], [6, 140], [4, 120], [0, 108]], 26, 6, 0, 7)
color yellow
stroke offset([[2, 167], [6, 140], [4, 120]], 5)
tube([[0, 40], [5, 20], [6, 0]], 10, 10, 0, 7)
tube([[159, 34], [152, 18], [150, 0]], 12, 10, 0, 7)

frame()
