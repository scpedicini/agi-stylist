# Fireside Library
# Source: King's Quest VI (VGA) - reference/kq6/r03-c10.png; reframed with:
#   pnpm grid reference/kq6/r03-c10.png --name kq6-r03-c10
# Method: translated by eye. Kept: beamed plank ceiling, plaster side wall with its corner,
#   trophy shield, sunlit doorway and window, the small bookcase, the wall of bookshelves, the
#   round stone fireplace with its fire and chandelier, the red armchair, footstool, round rug,
#   the bench on the right, the stacked green and red books on the left and the row of giant
#   books in the foreground. Dropped: wood grain, individual books and stones, candles on the
#   chandelier, the little box by the bookcase, the sunlit landscape through the door.
# Colours: plank ceiling → brown with yellow seams, dark beams → red with black undersides,
#   peach plaster → yellow, sunlight → white, wood floor → brown, rug → yellow, blue-grey stone
#   → lightgrey/darkgrey, armchair → red/lightred, page edges → lightgrey with darkgrey lines,
#   maroon book covers → magenta, olive book → green.
scene "Fireside Library"
variants day

# ---- plaster walls and the wooden floor -------------------------------------------------
# (delay: the viewer paints these backdrops last, farthest last, filling in behind the rest; the
# picture itself is unchanged)
delay 3 {
  color yellow
  rect 0, 0, 159, 122
}
delay 2 {
  shape([[38, 120], [76, 100], [159, 100], [159, 167], [0, 167], [0, 120]], brown, null)
}

# ---- ceiling: dark top band, planks and two beams ---------------------------------------
# the planked ceiling, from the top band down to the back wall and the left wall top
shape([[20, 22], [60, 17], [100, 10], [159, 3], [159, 50], [76, 50], [63, 48], [38, 39],
       [20, 26]], brown, null)
# plank seams: short slanted yellow strokes between the bands
fn seams(x1, x2, ytop1, ytop2, ybot1, ybot2, step, s) {
  color yellow
  for x in range(x1, x2, step) {
    let t = (x - x1) / (x2 - x1)
    let yt = ytop1 + (ytop2 - ytop1) * t
    let yb = ybot1 + (ybot2 - ybot1) * t
    line x + 2, yt + 1, x - 1, yb - 1
  }
}
seams 26, 159, 20, 4, 37, 22, 7, 1
seams 42, 159, 41, 28, 44, 34, 6, 2
seams 66, 159, 49, 42, 50, 49, 6, 3
# top band (dark beam along the top of the picture)
shape([[0, 0], [159, 0], [159, 3], [100, 10], [60, 17], [20, 22], [0, 24]], red, null)
color black
line 20, 22, 60, 17, 100, 10, 159, 3
line 0, 8, 60, 6, 120, 2
# two beams across the ceiling
fn beam(x1, y1, x2, y2, h) {
  shape([[x1, y1], [x2, y2], [x2, y2 + h], [x1, y1 + h]], red, null)
  color black
  line x1, y1 + h, x2, y2 + h
  color lightred
  line x1, y1, x2, y2
}
beam 38, 35, 159, 21, 4
beam 62, 43, 159, 35, 4

