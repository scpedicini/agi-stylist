# ---- the wall of bookshelves --------------------------------------------------------------
let book_colors = [red, blue, magenta, darkgrey, green, lightred, cyan, red, blue, brown]
fn books(x1, x2, ybot, h, s) {
  for x in x1..=x2 {
    if noise(s, x) >= 0.15 {
      color book_colors[floor(noise(s + 1, x) * len(book_colors))]
      line x, ybot - 1, x, ybot - h + floor(noise(s + 2, x) * 3)
    }
  }
}
delay {
  shape([[76, 50], [159, 50], [159, 101], [76, 101]], brown)
}
for i in 0..6 {
  let y = 58 + i * 8
  books 77, 158, y, 6, 40 + i * 3
  color yellow
  line 76, y, 159, y
  color black
  line 76, y + 1, 159, y + 1
}
# uprights
for x in [86, 143] {
  color yellow
  line x, 50, x, 100
  color black
  line x + 1, 50, x + 1, 100
}

# ---- round stone fireplace -----------------------------------------------------------------
let hearth = [[108, 47], [110, 44], [114, 43], [118, 44], [121, 48], [122, 55], [124, 60],
              [124, 67], [126, 72], [126, 80], [128, 86], [127, 93], [129, 101], [100, 101],
              [101, 94], [100, 88], [103, 80], [103, 72], [105, 66], [105, 58], [107, 53]]
