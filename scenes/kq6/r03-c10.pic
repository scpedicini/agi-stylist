# ---- the row of giant books in the foreground -------------------------------------------
# one tome seen end-on: page block between a left and right edge, with a dark top rim
fn tome(tl, tr, br, bl) {
  shape([tl, tr, br, bl], lightgrey, null)
  color darkgrey
  let n = floor((tr[0] - tl[0]) / 2.5)
  for i in 1..n {
    let t = i / n
    let xt = tl[0] + (tr[0] - tl[0]) * t
    let yt = tl[1] + (tr[1] - tl[1]) * t + 2
    let xb = bl[0] + (br[0] - bl[0]) * t
    let yb = 167
    if xb < 0 {
      yb = yt + (167 - yt) * xt / (xt - xb)
      xb = 0
    }
    line xt, yt, xb, yb
  }
  # rounded top rim of the spine
  color black
  let mx = (tl[0] + tr[0]) / 2
  line tl[0], tl[1] + 1, tl[0] + 2, tl[1] - 1, mx, tl[1] - 2, tr[0] - 2, tr[1] - 1, tr[0], tr[1] + 1
  color magenta
  line tl[0] + 2, tl[1], mx, tl[1] - 1, tr[0] - 2, tr[1]
}
fn cover(top_l, top_r, bot_r, bot_l) {
  shape([top_l, top_r, bot_r, bot_l], magenta)
}
# gold-edged cover of the leftmost book, running up to the red book
