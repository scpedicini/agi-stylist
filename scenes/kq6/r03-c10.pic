# cobbles: courses of lumpy stones on black mortar, lit on the left, shadowed on the right
for row in 0..10 {
  let sy = 49 + row * 5.4
  let half = 5 + row * 0.9
  let off = (row % 2) * 2
  for k in 0..8 {
    let sx = 114 - half + off + k * 4.5
    if sx > 114 + half { break }
    let c = sx > 114 + half * 0.45 ? darkgrey : lightgrey
    shape(blob(sx, sy, 1.5, 1.9, 70 + row * 8 + k, 0.3, 7), c, null)
  }
}
