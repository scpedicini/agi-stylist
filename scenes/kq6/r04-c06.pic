# Throne of the Winged Ones
# Source: King's Quest VI VGA background, reference/kq6/r04-c06.png
#   (the king and queen of the Winged Ones enthroned in their stone hall); reframed with:
#   pnpm grid reference/kq6/r04-c06.png --name kq6-r04-c06
# Method: translated by eye. Kept: the block-stone back wall and side pilasters, the four
#   great white wings and their shadows on the wall, the king (bare-chested, white tunic with
#   violet trim, gold collar, laced sandals) and the queen (white gown, gold collar, belt and
#   hem, tiara) holding hands, the stone double throne with its arm blocks and legs, the dais
#   with its lotus frieze, the two gold three-candle candelabras, the stepped column bases
#   and the flagstone floor.
# Dropped: the speckled stone texture, most feather detail, facial detail beyond eyes and
#   brows, the floor reflections and the faint far-floor seams.
# Colours: blue-grey stone -> lightgrey with darkgrey joints and shadows, wings -> white with
#   lightgrey feather strokes, tan skin -> brown, fair skin -> lightred, hair -> black,
#   gold -> yellow with brown shade, violet trim -> lightmagenta, candles -> white with
#   lightgrey shade, flames -> yellow with lightred.
scene "Throne of the Winged Ones"
variants lit

fn box(x1, y1, x2, y2, c, edge = black) {
  shape([[x1, y1], [x2, y1], [x2, y2], [x1, y2]], c, edge)
}

# ---- back wall ---------------------------------------------------------------------------------
# (delay: the viewer paints this backdrop last, filling in behind the rest; the picture itself is
# unchanged)
delay {
  color lightgrey
  rect 0, 0, 159, 167
}
color darkgrey
line 10, 10, 146, 10
line 10, 48, 146, 48
line 10, 88, 146, 88
line 38, 0, 38, 10
line 112, 0, 112, 10
line 22, 10, 22, 48
line 132, 10, 132, 48
line 24, 48, 24, 88
line 136, 48, 136, 88

# side pilasters
box(-1, -1, 10, 110, lightgrey)
color darkgrey
line 3, 0, 3, 108
line 7, 0, 7, 108
color white
line 1, 0, 1, 108
box(146, -1, 160, 110, lightgrey)
color darkgrey
line 150, 0, 150, 108
line 155, 0, 155, 108
color white
line 148, 0, 148, 108

# ---- wings: shadow on the wall, then the four wings ------------------------------------------
let wl1 = [[30, 98], [27, 75], [28, 55], [33, 35], [41, 19], [51, 7], [56, 12], [58, 26],
           [60, 45], [56, 70], [46, 92]]
let wl2 = [[60, 45], [62, 22], [68, 10], [75, 8], [80, 14], [84, 30], [85, 50], [82, 68], [70, 70]]
let wr1 = [[82, 68], [80, 45], [82, 25], [88, 12], [94, 7], [99, 12], [100, 26], [97, 50], [92, 66]]
let wr2 = [[104, 48], [104, 24], [107, 13], [111, 8], [117, 15], [124, 30], [130, 50], [133, 70],
           [133, 88], [128, 98], [118, 80], [110, 62]]
shape(shift(wr2, 5, 4), darkgrey, null)
shape(shift(wr1, 5, 4), darkgrey, null)
shape(shift(wl2, 4, 4), darkgrey, null)
shape(shift(wl1, 4, 4), darkgrey, null)
# the deep shadow behind the queen's right wing and the throne end
shape([[128, 70], [138, 76], [140, 112], [126, 112]], darkgrey, null)
shape(wl1, white)
shape(wr2, white)
shape(wl2, white)
shape(wr1, white)

# feather strokes, following each wing's sweep
color lightgrey
stroke [[49, 12], [40, 26], [34, 44], [32, 64], [34, 84]]
stroke [[53, 18], [46, 34], [42, 54], [42, 76]]
stroke [[56, 30], [51, 48], [50, 66]]
stroke [[73, 12], [79, 26], [80, 44], [78, 62]]
stroke [[70, 18], [74, 34], [73, 52]]
stroke [[92, 12], [86, 28], [85, 46], [87, 62]]
stroke [[96, 18], [93, 34], [92, 52]]
stroke [[112, 13], [120, 28], [126, 48], [129, 68], [129, 86]]
stroke [[109, 20], [115, 36], [120, 56], [122, 74]]
stroke [[107, 30], [111, 48], [114, 62]]
# primary feather tips along the lower edges
color darkgrey
for p in [[30, 80], [32, 88], [36, 94], [125, 84], [128, 90], [131, 80]] {
  line p[0], p[1], p[0] + (p[0] < 80 ? 4 : -4), p[1] - 3
}

# pale halos behind the two heads
shape(blob(57, 32, 9, 15, 4, 0.04), white, lightgrey)
shape(blob(102, 36, 9, 15, 6, 0.04), white, lightgrey)

# ---- throne ------------------------------------------------------------------------------------
box(30, 80, 128, 110, lightgrey)
# legs and recessed panels
box(32, 82, 41, 109, lightgrey)
box(72, 82, 89, 109, lightgrey)
box(116, 82, 126, 109, lightgrey)
color darkgrey
line 42, 84, 42, 108
line 71, 84, 71, 108
line 90, 84, 90, 108
line 115, 84, 115, 108
line 36, 84, 36, 108
line 77, 84, 77, 108
line 84, 84, 84, 108
line 121, 84, 121, 108
for x in [46, 60, 66, 94, 110] { line x, 90, x, 108 }
# arm blocks with rounded tops
box(31, 68, 43, 82, lightgrey)
box(71, 68, 89, 82, lightgrey)
box(115, 68, 127, 82, lightgrey)
color white
line 32, 69, 42, 69
line 72, 69, 88, 69
line 116, 69, 126, 69
color darkgrey
line 32, 76, 42, 76
line 72, 76, 88, 76
line 116, 76, 126, 76

# ---- the king -----------------------------------------------------------------------------------
# legs: thighs forward to the knees, shins down to sandalled feet
box(48, 80, 56, 86, brown)
box(60, 80, 68, 86, brown)
shape([[49, 86], [55, 86], [55, 104], [51, 104]], brown)
shape([[61, 86], [67, 86], [66, 104], [62, 104]], brown)
color black
line 50, 90, 55, 94, 50, 98, 55, 102
line 55, 90, 50, 94, 55, 98, 50, 102
line 62, 90, 67, 94, 62, 98, 66, 102
line 67, 90, 62, 94, 67, 98, 62, 102
box(49, 104, 56, 108, white)
box(61, 104, 68, 108, white)
color brown
line 51, 105, 54, 105
line 63, 105, 66, 105
# torso and arms
shape([[47, 45], [70, 45], [73, 50], [72, 68], [48, 68], [45, 52]], brown)
shape([[45, 50], [49, 52], [48, 70], [44, 70]], brown)
shape(band([[70, 48], [74, 58], [78, 67]], 8, 6), brown)
# white tunic over the left shoulder, skirt to the knees, violet trim
shape([[48, 45], [53, 45], [64, 60], [68, 66], [69, 72], [48, 72]], white)
color black
line 62, 52, 66, 53, 70, 51
shape([[47, 67], [70, 67], [70, 81], [47, 81]], white)
color lightmagenta
line 53, 46, 64, 60, 68, 66
line 48, 80, 69, 80
color yellow
line 49, 67, 68, 67
color lightgrey
line 55, 72, 53, 79
line 63, 72, 64, 79
# head
shape([[57, 39], [60, 39], [60, 44], [56, 44]], brown, null)
shape(blob(57, 32, 4, 7, 3, 0.05), brown)
shape([[52, 30], [53, 24], [57, 22], [61, 24], [62, 30], [60, 28], [54, 28]], black)
color black
plot 55, 32
plot 59, 32
line 56, 37, 58, 37
color lightred
line 53, 33, 53, 35
# gold collar and pendant
shape([[51, 44], [62, 44], [60, 47], [53, 47]], yellow, brown)
box(55, 47, 58, 51, yellow, brown)

# ---- the queen ---------------------------------------------------------------------------------
# gown: shoulders, bodice, lap and skirt to the floor
shape([[92, 48], [112, 48], [116, 56], [114, 74], [117, 84], [112, 88], [113, 105],
       [97, 105], [97, 88], [91, 84], [94, 72], [90, 56]], white)
# sleeves: her right hand reaches across to the king, her left rests on the throne arm
shape(band([[92, 52], [88, 60], [84, 66], [80, 68]], 8, 6), white)
shape(band([[112, 52], [116, 60], [118, 66], [121, 69]], 8, 6), white)
color lightgrey
line 96, 76, 98, 103
line 104, 76, 104, 103
line 110, 76, 109, 103
line 94, 82, 113, 84
# clasped hands and her left hand
ellipse 78, 68, 2, 2
color black
plot 79, 69
shape(blob(122, 70, 2, 2, 2, 0.05), lightred)
# gold: belt, hem, collar
box(96, 69, 110, 71, yellow, brown)
box(97, 102, 113, 105, yellow, brown)
shape([[96, 47], [108, 47], [105, 52], [99, 52]], yellow, brown)
# feet
box(100, 106, 104, 109, lightred)
box(106, 106, 110, 109, lightred)
# head: hair framing the face, face, tiara
shape(blob(102, 36, 5, 9, 5, 0.08), black)
shape(blob(102, 27, 3, 3, 3, 0.05), black)
shape(blob(102, 38, 3, 6, 2, 0.05), lightred)
shape([[100, 43], [104, 43], [104, 47], [100, 47]], lightred, null)
color yellow
line 98, 28, 106, 28
color black
plot 100, 35
plot 104, 35
color red
line 101, 40, 103, 40

# ---- dais ---------------------------------------------------------------------------------------
box(27, 109, 132, 112, white)
box(27, 112, 132, 124, lightgrey)
# lotus frieze
for x in [38, 53, 67, 80, 94, 108, 121] {
  color darkgrey
  line x - 4, 115, x - 2, 120, x + 2, 120, x + 4, 115
  line x, 114, x, 120
  color white
  line x - 2, 117, x - 1, 115
  line x + 2, 117, x + 1, 115
}

# ---- column bases at the sides ------------------------------------------------------------------
box(-1, 102, 13, 110, lightgrey)
box(-1, 110, 17, 118, lightgrey)
color darkgrey
line 0, 108, 12, 108
line 0, 116, 16, 116
box(138, 102, 160, 110, lightgrey)
box(134, 110, 160, 118, lightgrey)
color darkgrey
line 139, 108, 159, 108
line 135, 116, 159, 116

# ---- floor --------------------------------------------------------------------------------------
shape([[0, 119], [26, 119], [26, 125], [133, 125], [133, 119], [160, 119], [160, 168], [0, 168]],
      lightgrey, null)
# shadow under the dais
box(26, 125, 134, 127, darkgrey, null)
color darkgrey
stroke [[54, 127], [24, 168]]
stroke [[80, 127], [80, 168]]
stroke [[106, 127], [136, 168]]
stroke [[0, 128], [26, 124]]
stroke [[134, 124], [160, 130]]
stroke [[0, 145], [40, 136]]
stroke [[46, 136], [118, 136]]
stroke [[124, 136], [160, 146]]
stroke [[0, 160], [160, 160]]

# ---- candelabras --------------------------------------------------------------------------------
fn candelabra(x) {
  # x is the pole; candles left and right of it at y 64, the middle one lower
  # tripod feet
  shape(band([[x, 124], [x - 6, 130], [x - 7, 133]], 4, 3), brown)
  shape(band([[x + 1, 124], [x + 7, 130], [x + 8, 133]], 4, 3), brown)
  shape([[x - 1, 70], [x + 2, 70], [x + 2, 128], [x - 1, 128]], yellow, brown)
  color brown
  line x + 1, 72, x + 1, 127
  # gilded arms rising to the side cups
  shape(band([[x, 82], [x - 5, 78], [x - 8, 70], [x - 7, 66]], 6, 4), yellow, brown)
  shape(band([[x + 1, 82], [x + 6, 78], [x + 9, 70], [x + 8, 66]], 6, 4), yellow, brown)
  color brown
  line x - 4, 79, x - 7, 72
  line x + 5, 79, x + 8, 72
  # cups
  box(x - 10, 63, x - 4, 65, brown)
  box(x + 4, 63, x + 10, 65, brown)
  box(x - 2, 72, x + 3, 74, brown)
  # candles
  box(x - 9, 42, x - 5, 63, white)
  box(x + 5, 43, x + 9, 63, white)
  box(x - 2, 54, x + 3, 72, white)
  color lightgrey
  line x - 6, 44, x - 6, 62
  line x + 8, 45, x + 8, 62
  line x + 2, 56, x + 2, 71
  # flames
  shape([[x - 7, 35], [x - 5, 40], [x - 7, 41], [x - 9, 40]], yellow, lightred)
  shape([[x + 7, 36], [x + 9, 41], [x + 7, 42], [x + 5, 41]], yellow, lightred)
  shape([[x, 47], [x + 2, 52], [x, 53], [x - 2, 52]], yellow, lightred)
}
candelabra 16
candelabra 142

frame
