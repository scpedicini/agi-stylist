}
for b in [[62, 33, 8, 6, 1], [74, 29, 9, 7, 2], [86, 27, 9, 7, 3], [98, 27, 9, 6, 4],
          [109, 27, 7, 5, 5]] {
  shape(blob(b[0], b[1] + 1, b[2] - 1, b[3] - 1, b[4], 0.3), lightgreen, null)
}
shape([[56, 36], [70, 33], [90, 31], [112, 29], [116, 33], [110, 34], [100, 37], [85, 39],
       [70, 41], [58, 43]], lightgreen, null)
color green
