# ---- right ferns and lower-right cliff -------------------------------------------------------
# dark undergrowth behind the fronds
shape([[159, 62], [134, 64], [130, 84], [124, 100], [120, 118], [116, 140], [159, 140]], green)
# a fern frond from its base (x, y), arching out to its tip (x + dx, y + dy), toothed underneath
fn frond(x, y, dx, dy) {
  let pts = []
  for t in 0..=6 {
    push(pts, [x + dx * t / 6, y + dy * t * t / 36 - 4 * sin(t * 30)])
  }
  for t in 0..=6 {
    let u = 6 - t
    let tooth = u % 2 == 0 ? 2 : 5
    push(pts, [x + dx * u / 6, y + dy * u * u / 36 - 4 * sin(u * 30) + tooth * sin(u * 30) + 1])
  }
  shape(pts, lightgreen)
  color green
  line x, y, x + dx / 2, y + dy / 4 - 3, x + dx, y + dy
}
frond 159, 78, -26, 12
frond 152, 90, -24, 14
frond 159, 98, -30, 16
frond 150, 110, -28, 16
frond 159, 118, -32, 18
frond 148, 128, -26, 12
frond 140, 82, 14, 8
frond 136, 104, 18, 10
