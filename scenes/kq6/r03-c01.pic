line 3, 56, 9, 57, 15, 62

# ---- palm -------------------------------------------------------------------------------------
color brown
line 46, 62, 47, 50, 46, 38, 46, 22
line 47, 62, 48, 50, 47, 38, 47, 22
fn palm_leaf(x, y, dx, dy) {
  shape([[x, y], [x + dx / 2, y - 2], [x + dx, y + dy], [x + dx / 2, y + 1]], green, black)
}
palm_leaf 46, 22, -10, 7
palm_leaf 47, 22, 10, 7
palm_leaf 46, 21, -7, -2
palm_leaf 47, 21, 7, -2
palm_leaf 46, 22, -3, 9

# ---- the low rocky spit ----------------------------------------------------------------------
shape([[0, 82], [10, 78], [22, 74], [35, 70], [45, 64], [55, 60], [60, 66], [64, 80], [64, 94], [40, 88],
       [25, 87], [10, 89], [0, 90]], brown)
shape([[0, 82], [10, 78], [22, 74], [35, 70], [45, 64], [55, 60], [57, 61], [46, 66], [36, 72],
       [22, 76], [10, 80], [0, 84]], yellow, null)
