line 27, 45, 29, 53, 31, 61
# hull, bow up on the left
shape([[2, 54], [8, 55], [14, 60], [20, 66], [26, 72], [20, 77], [0, 78], [0, 58]], brown)
color black
line 2, 58, 8, 60, 14, 65, 20, 70
line 6, 66, 6, 76
line 12, 66, 12, 76
