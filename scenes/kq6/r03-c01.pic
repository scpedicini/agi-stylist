# ---- sand cove -------------------------------------------------------------------------------
shape([[45, 94], [60, 89], [80, 92], [96, 90], [100, 94], [128, 94], [126, 105], [120, 125],
       [116, 145], [112, 167], [95, 167], [90, 160], [86, 153], [90, 148], [92, 140], [86, 131],
       [75, 125], [60, 121], [45, 119], [28, 121], [22, 118], [35, 112], [44, 104]], yellow, null)
# shadow line along the cliff foot
color brown
line 52, 94, 60, 91, 80, 94, 96, 92, 128, 96
# wet edge
color brown
line 22, 119, 28, 122, 45, 120, 60, 122, 75, 126, 86, 132, 93, 140, 91, 148, 87, 153, 91, 160, 96, 167
color black
line 21, 120, 28, 123, 45, 121, 60, 123, 75, 127, 85, 133, 92, 140, 90, 148, 86, 153, 90, 160, 95, 167

# ---- boulder and dark wreckage ---------------------------------------------------------------
# broken ribs of the ship, half in the water
shape([[10, 128], [14, 108], [18, 98], [22, 106], [26, 92], [29, 102], [34, 98], [34, 112],
       [28, 124], [20, 132]], darkgrey)
color black
line 14, 124, 18, 104
line 20, 126, 25, 98
line 26, 122, 31, 104
shape([[30, 86], [36, 79], [42, 80], [48, 86], [52, 100], [51, 110], [42, 113], [33, 110], [30, 100]], lightgrey)
shape([[30, 86], [36, 79], [37, 90], [36, 104], [40, 113], [33, 110], [30, 100]], darkgrey)
