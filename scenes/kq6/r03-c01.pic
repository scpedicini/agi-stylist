# Shipwreck Beach
# Source: King's Quest VI background, reference/kq6/r03-c01.png;
#   reframed with: pnpm grid reference/kq6/r03-c01.png --name kq6-r03-c01
# Method: translated by eye. Kept: blue sky and cloud, distant mountain, teal sea, the wrecked
#   hull and its leaning mast, a palm, the low rocky spit, the big grooved sandstone cliff with
#   its grass cap, the dark jungle hill behind, the shadowed gully, the right grass bank and
#   ferns, the lower-right cliff, the sand cove, the grey boulder with dark wreckage, the
#   driftwood log, a beach rock and two bits of driftwood. Dropped: the second small palm, the
#   rigging, the rocks out in the sea, most fern and grass texture. Moved: nothing.
# Colours: sky → blue, cloud → white/lightgrey, mountain → lightblue with a lightcyan lit face,
#   sea → cyan with lightcyan ripples, sandstone → yellow face / brown shadow and grooves,
#   grass cap and bank → lightgreen with green strokes, jungle and fern shade → green with black,
#   sand → yellow with a brown wet edge, boulder → lightgrey/darkgrey, wreckage → darkgrey/black,
#   wood → brown.
scene "Shipwreck Beach"
variants day

# ---- sky, cloud, mountain --------------------------------------------------------------------
# (delay: the viewer paints these backdrops last, farthest last, filling in behind the rest; the
# picture itself is unchanged)
delay 3 {
  color blue
  rect 0, 0, 159, 64
}
cloud(36, 38, 40, 2)
shape([[12, 64], [18, 58], [24, 53], [31, 47], [35, 49], [40, 54], [46, 59], [52, 64]], lightblue)
shape([[31, 47], [35, 49], [40, 54], [46, 59], [50, 63], [41, 61], [36, 55]], lightcyan, null)

# ---- the sea ---------------------------------------------------------------------------------
delay 2 {
  color cyan
  rect 0, 64, 159, 167
}
color lightcyan
for r in [[2, 92, 12], [4, 104, 8], [0, 146, 14], [20, 152, 16], [6, 160, 10], [46, 158, 14],
          [56, 140, 12], [30, 134, 10], [64, 148, 8]] {
  line r[0], r[1], r[0] + r[2], r[1]
}

# ---- the dark jungle hill behind everything --------------------------------------------------
delay {
  shape([[56, 40], [58, 30], [66, 24], [80, 18], [92, 16], [100, 10], [108, 4], [114, 0],
         [134, 0], [138, 6], [146, 12], [152, 8], [159, 9], [159, 72], [56, 72]], green)
}
color black
line 112, 10, 116, 20, 114, 30
line 122, 6, 124, 18
line 132, 12, 136, 24
line 144, 16, 146, 26
line 152, 14, 154, 24
# deep shade where the jungle closes over the gully
shape(blob(122, 42, 12, 10, 6, 0.2), black, null)
# jungle mass left of the cliff
shape(blob(56, 58, 8, 22, 4, 0.25), green)
color black
line 52, 44, 54, 56, 52, 64

# ---- the gully: shadowed sand wall right of the cliff ----------------------------------------
shape([[94, 60], [104, 54], [112, 50], [122, 50], [130, 54], [136, 64], [134, 80], [128, 94],
       [94, 94]], brown)
color black
line 118, 54, 112, 64, 106, 74
line 126, 56, 120, 68, 114, 80
line 132, 64, 126, 76, 122, 88
color yellow
line 116, 52, 109, 60, 104, 68
line 124, 54, 117, 66

# ---- the big sandstone cliff -----------------------------------------------------------------
let cliff = [[58, 46], [60, 42], [70, 40], [85, 38], [100, 36], [110, 32], [114, 36], [117, 44],
             [121, 50], [124, 53], [116, 55], [106, 57], [100, 62], [96, 72], [96, 90], [80, 92],
             [62, 90], [59, 75], [57, 60]]
shape(cliff, yellow)
# the shaded side under the curl
shape([[98, 38], [104, 44], [110, 52], [116, 55], [106, 57], [100, 62], [96, 72], [96, 90],
       [82, 92], [86, 70], [92, 54]], brown, null)
# grooves hanging from the top edge, fanning to the right on the curl
color brown
for g in [[63, 43, 62, 66], [68, 41, 67, 60], [73, 40, 74, 70], [78, 39, 77, 58], [83, 38, 84, 64],
          [88, 38, 88, 52], [94, 37, 94, 48], [107, 34, 109, 44], [111, 33, 114, 44],
          [114, 38, 118, 48]] {
  line g[0], g[1], g[2], g[3]
  if abs(g[2] - g[0]) <= 1 { line g[0] + 1, g[1], g[2] + 1, g[3] - 4 }
}
# columns in the shadow, light ribs on the lit lower face
color black
line 88, 60, 87, 90
line 92, 56, 91, 90
color yellow
line 86, 64, 85, 88
line 90, 58, 89, 86
color brown
line 66, 72, 65, 88
line 72, 76, 72, 90
line 78, 70, 79, 90
color black
outline cliff

# ---- grass cap on the cliff ------------------------------------------------------------------
for b in [[62, 33, 8, 6, 1], [74, 29, 9, 7, 2], [86, 27, 9, 7, 3], [98, 27, 9, 6, 4],
          [109, 27, 7, 5, 5]] {
