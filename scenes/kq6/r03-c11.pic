line 111, 143, 159, 139
fn candle(x1, x2, top, bottom) {
  shape([[x1, top + 2], [x1 + 1, top], [x2 - 1, top], [x2, top + 2], [x2, bottom], [x1, bottom]],
        white)
  color lightgrey
  line x2 - 1, top + 3, x2 - 1, bottom - 1
  line x1 + 1, top + 4, x1 + 1, top + 9
  color black
  line (x1 + x2) / 2, top - 2, (x1 + x2) / 2, top - 1
  color yellow
  line (x1 + x2) / 2, top - 4, (x1 + x2) / 2, top - 3
}
candle(124, 130, 120, 143)
candle(131, 135, 128, 142)
candle(140, 146, 136, 167)
candle(149, 153, 146, 167)

