color yellow
line 81, 96, 88, 96
line 82, 99, 87, 99

# ---- the bear's alcove: posts and plinth --------------------------------------------------
for x in [41, 74] {
  shape([[x, 46], [x + 2, 46], [x + 2, 106], [x, 106]], brown)
  color yellow
  line x, 47, x, 105
}
shape([[39, 104], [76, 104], [79, 109], [36, 109]], brown)
color red
line 40, 106, 76, 106

# ---- plank floor: seams converging on the back of the room ---------------------------------
color brown
for x in [-80, -55, -32, -12, 6, 22, 37, 51, 64, 77, 90, 104, 119, 135, 153, 173, 196, 222] {
  let vx = 62
  let vy = 70
  # seam from the floor's back edge (y 110) to the bottom of the picture
  let t1 = (110 - vy) / (167 - vy)
  stroke vx + (x - vx) * t1, 110, x, 167
}
# staggered board ends
color brown
for j in [[30, 116, 40], [70, 122, 82], [100, 114, 112], [16, 132, 30], [86, 142, 102],
          [56, 152, 72], [118, 128, 132]] {
  line j[0], j[1], j[0] + 4, j[1] - 1
}
color black
line 21, 104, 122, 104
line 122, 108, 159, 112

# ---- the stuffed bear ----------------------------------------------------------------------
fn bear() {
  # body and legs
  blobs([[59, 82, 13, 20], [52, 99, 7, 7], [66, 99, 7, 7], [59, 66, 10, 9]], brown)
  # raised arms
  shape(band([[50, 70], [46, 60], [47, 51]], 8, 6), brown)
  shape(band([[68, 70], [72, 60], [71, 51]], 8, 6), brown)
  # paws
  shape(blob(47, 51, 3, 4, 2, 0.15, 10), yellow)
  shape(blob(71, 51, 3, 4, 5, 0.15, 10), yellow)
  # head with ears
  shape(blob(53, 49, 2, 3, 7, 0.1, 8), brown)
  shape(blob(65, 49, 2, 3, 8, 0.1, 8), brown)
  shape(blob(59, 55, 5, 8, 3, 0.08, 14), brown)
  color yellow
  line 54, 51, 54, 56
  # lit muzzle and open mouth
  shape([[56, 57], [62, 57], [63, 62], [59, 64], [55, 62]], yellow)
  shape([[57, 60], [61, 60], [60, 63], [58, 63]], red)
  color black
  line 56, 53
  line 62, 53
  line 58, 57, 60, 57
  # fur highlights on the lit left side, belly and leg lines
  color yellow
  line 48, 75, 47, 88
  line 52, 72, 51, 82
  line 55, 50, 58, 49
  line 47, 97, 48, 103
  color black
  line 59, 84, 59, 92
  line 55, 92, 52, 94
  line 63, 92, 66, 94
  line 70, 74, 71, 88
  # big lit haunches and feet
  shape(blob(50, 98, 5, 7, 4, 0.1, 12), brown)
  shape(blob(68, 98, 5, 7, 6, 0.1, 12), brown)
  color yellow
  line 47, 94, 46, 100
  line 65, 94, 64, 100
  shape([[45, 103], [55, 103], [55, 106], [45, 106]], yellow)
  shape([[63, 103], [73, 103], [73, 106], [63, 106]], yellow)
}
bear()

