  rect b[0], b[1], b[2], b[3]
}
# shelf edges
for y in [64, 83, 102] {
  color yellow
  line 77, y, 121, y
}
color yellow
line 103, 47, 103, 102
line 77, 47, 77, 102

# shelf goods: ship's wheel, chests, globe and pots up top
