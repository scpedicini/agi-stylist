# Pawn Shop
# Source: King's Quest VI VGA background, reference/kq6/r03-c11.png
#   (the pawn shop on the Isle of the Crown); reframed with:
#   pnpm grid reference/kq6/r03-c11.png --name kq6-r03-c11
# Method: translated by eye. Kept: the dark ceiling band, the peach plaster soffit with its
#   little window, the dark left wall and its sunlit doorway, the cream right wall with its
#   shadowed beam and bottle alcove, the back shelving with a wheel, vase, shield and jars, the
#   stuffed bear on its plinth, the plank floor, the counter with a teapot, the spear and
#   halberd blade, the hanging cauldron and horn, the hanging skeleton, and in front the suit of
#   armour, drum, barrel, crystal ball, small chest, broom, candles, urn and bench.
# Dropped: the hatchet and basket by the bear, the loose boards in the foreground, most shelf
#   clutter, wood grain, plaster texture, the upper-left skylight.
# Colours: dark ceiling band → black, peach soffit → yellow with brown shading, cream right
#   wall → white with lightgrey and yellow texture, dark maroon walls → red with black shadow,
#   shelving and counter wood → brown with yellow edges, plank floor → yellow with brown seams,
#   bear fur → brown with yellow highlights, bones → white with lightblue shade, lavender-lit metal
#   rims → lightblue, dark armour and urn → blue/darkgrey with lightblue rims, drum → red with a yellow
#   head, candles → white with lightgrey, crystal ball → lightmagenta.
scene "Pawn Shop"
variants lit

# ---- walls and ceiling --------------------------------------------------------------------
# back and left walls in shadow
# (delay: the viewer paints these backdrops last, farthest last, filling in behind the rest; the
# picture itself is unchanged)
delay 2 {
  color red
  rect 0, 0, 159, 110
}
# plank floor
delay {
  color yellow
  rect 0, 104, 159, 167
}

# dark ceiling band along the top
color black
rect 0, 0, 159, 8

# right wall, cream plaster, from the corner at x=122
shape([[120, 9], [159, 9], [159, 112], [122, 108]], white, null)
color lightgrey
line 128, 14, 134, 14
line 146, 18, 154, 18
line 150, 44, 156, 44
line 126, 70, 128, 70
line 154, 104, 158, 104
line 124, 80, 127, 80
line 124, 92, 127, 92
line 140, 40, 145, 40
color yellow
line 140, 12, 146, 12
line 126, 52, 126, 58
line 157, 60, 157, 70
# shadowed beam running diagonally across the top of the right wall
shape([[116, 44], [159, 25], [159, 33], [124, 50], [116, 50]], red)
color black
line 117, 50, 124, 50, 159, 34
# corner where back wall meets right wall
color black
line 122, 50, 122, 108

# the peach plaster soffit: front face and slanted left side
shape([[32, 8], [118, 8], [118, 44], [32, 44]], yellow)
shape([[14, 8], [32, 8], [32, 44], [27, 46]], yellow)
color brown
line 32, 9, 32, 43
line 40, 41, 116, 41
line 50, 18, 56, 18
line 74, 28, 82, 28
line 98, 16, 104, 16
line 62, 36, 68, 36
line 18, 14, 22, 26
# little window in the side of the soffit
shape([[25, 21], [29, 21], [29, 34], [25, 33]], lightcyan)
# soffit right side face, lit
shape([[116, 8], [121, 8], [121, 44], [116, 44]], white)
color black
line 32, 45, 117, 45

# ---- the sunlit doorway on the left wall --------------------------------------------------
shape([[11, 61], [19, 61], [19, 103], [11, 103]], white)
shape([[11, 88], [15, 84], [19, 86], [19, 103], [11, 103]], yellow, null)
color brown
line 20, 61, 20, 104

# ---- back shelving ------------------------------------------------------------------------
shape([[76, 47], [122, 47], [122, 104], [76, 104]], brown)
# dark shelf backs
for b in [[78, 49, 101, 63], [106, 49, 120, 63], [78, 68, 101, 82], [106, 68, 120, 82],
          [78, 87, 101, 101], [106, 87, 120, 101]] {
