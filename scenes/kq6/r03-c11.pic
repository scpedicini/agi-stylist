shape(blob(117, 58, 3, 5, 4, 0.05, 10), brown)
# crossed tools, white vase and blue platter on the middle shelf
color lightgrey
line 80, 70, 88, 81
line 88, 70, 80, 81
shape([[94, 69], [97, 69], [99, 73], [99, 80], [97, 82], [94, 82], [92, 80], [92, 73]], white)
color lightgrey
line 97, 72, 97, 80
