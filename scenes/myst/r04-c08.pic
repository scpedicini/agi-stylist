# ---------- rope posts ----------
fn ropepost(x, y, dx) {
  color yellow
  stroke [[x - 1, y + 2], [x - 2 + dx * 0.5, y + 9], [x - 3 + dx, y + 18]]
  stroke [[x - 2, y + 2], [x - 3 + dx * 0.5, y + 9], [x - 4 + dx, y + 18]]
  color black
  stroke [[x - 3, y + 3], [x - 4 + dx * 0.5, y + 10], [x - 5 + dx, y + 18]]
  rect x + 1, y + 2, x + 2, 167
  shape(blob(x + 1, y + 1, 2.5, 3, 2, 0.05, 10), black, null)
  color darkgrey
  rect x + 1, y, x + 1, y + 1
  color black
  stroke x + 3, y + 14, x + 12, y + 11
}
ropepost(58, 149, 0)
ropepost(98, 148, 2)

frame()
