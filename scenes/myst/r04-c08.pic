# ---------- lamp stands ----------
fn stand(x1, x2, top, boxh, bottom) {
  color black
  line x1 + 1, top + boxh, x1 + 1, bottom
  line x2 - 1, top + boxh, x2 - 1, bottom
  shape([[x1, top], [x2, top], [x2, top + boxh], [x1, top + boxh]], darkgrey)
  color lightgrey
  line x1 + 1, top + 1, x2 - 1, top + 1
}
stand(33, 39, 63, 6, 90)
stand(49, 53, 63, 5, 81)
stand(104, 109, 61, 6, 80)

# ---------- the freestanding columns ----------
fn bigcol(x1, x2, top, bottom, px1, px2, pb) {
  column(x1, x2, top + 3, bottom, lightgrey, darkgrey, white)
  # dark capital: abacus and echinus
  let ov = x2 - x1 > 5 ? 2 : 1
  shape([[x1 - ov, top], [x2 + ov, top], [x2 + 1, top + 2], [x1 - 1, top + 2]], darkgrey)
  shape([[x1 - 1, top + 3], [x2 + 1, top + 3], [x2, top + 5], [x1, top + 5]], lightgrey)
  # plinth
  if pb > bottom {
    shape([[px1, bottom], [px2, bottom], [px2, pb], [px1, pb]], lightgrey)
    color darkgrey
    rect px2 - max(1, round((px2 - px1) / 3)), bottom + 1, px2 - 1, pb - 1
    color white
    line px1 + 1, bottom + 1, px2 - 2, bottom + 1
  }
}
bigcol(42, 46, 33, 81, 39, 49, 90)
bigcol(111, 114, 33, 80, 109, 116, 84)
bigcol(23, 30, 19, 90, 20, 33, 103)
bigcol(125, 132, 19, 89, 123, 136, 102)

# ---------- the round stepped platform ----------
fn tier(cx, cy, rx, ry, h) {
  let top = arc(cx, cy, rx, ry, 270, 450)
  let low = arc(cx, cy + h, rx, ry, 90, 270)
  shape(top + low, darkgrey)
  shape(arc(cx, cy, rx, ry, 0, 360), lightgrey)
  color white
  stroke arc(cx, cy, rx - 1, ry - 1, 170, 120)
}
