# ---------- pines ----------
fn mpine(x, top, bot, w, seed = 1, tb = -1, tw = 1) {
  if tb > bot {
    color red
    rect x - tw + 1, bot - 3, x + tw - 1, tb
    color black
    line x + tw, bot - 3, x + tw, tb
  }
  let n = max(3, round((bot - top) / 7))
  let right = []
  let left = []
  let tips = []
  for i in 1..=n {
    let t = i / n
    let y = top + (bot - top) * t
    let hw = w * t * (0.85 + 0.3 * noise(seed, i))
    let hw0 = w * (i - 1) / n
    let yn = top + (bot - top) * (i - 1) / n + 2
    push(right, [x + hw0 * 0.45 + 0.5, yn])
    push(right, [x + hw, y])
    push(left, [x - hw0 * 0.45 - 0.5, yn + 1])
    push(left, [x - hw * (0.9 + 0.2 * noise(seed + 7, i)), y + 1])
    push(tips, [x, y, hw])
  }
  shape([[x, top]] + right + [[x, bot + 1]] + reverse(left), green)
  for k in 1..len(tips) {
    let p = tips[k]
    color black
    stroke p[0] + p[2] * 0.7, p[1] - 1, p[0] + 1, p[1] - 4
    if k % 2 == 1 && p[2] > 3 {
      color lightgreen
      stroke p[0] - p[2] * 0.6, p[1] - 1, p[0] - 2, p[1] - 3
    }
  }
}

# left pines
mpine(1, 40, 74, 4, 3, 96)
mpine(13, 21, 70, 6, 2, 98, 2)
mpine(6, 24, 72, 6, 1, 100, 2)
mpine(19, 36, 74, 5, 4, 96)
mpine(26, 40, 74, 4, 5, 92)
mpine(35, 40, 70, 4, 6, 86)
# right pines
