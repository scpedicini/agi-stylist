# The Giant Gear
# Source: Myst (1993) render, reference/myst/r11-c13.png; reframed with:
#   pnpm grid reference/myst/r11-c13.png --crop 0,0,544,333 --name myst-r11-c13
# Method: translated by eye. Kept: the pale sky, the giant granite gear with its five teeth,
#   rim, two face grooves and bronze hub ring, the stone blocks stacked behind it in its
#   shadow, the small stone hut with its riveted panel at far left, the far wooden rail with
#   its brass knobs and posts, the two wooden beams lying on the deck, the concrete deck, ledge,
#   step and lit side walls, the turf either side, the two near handrails with knobs and posts,
#   and the handrail's cast shadow on the step. Dropped: the granite and wood-grain texture,
#   the blue sheen at the gear's foot, the posts' faint reflections. Moved: nothing.
# Colours: sky → lightcyan, gear → darkgrey lit faces / black shadow faces and grooves /
#   lightgrey lit edges, blocks behind → lightgrey lit / darkgrey shaded (paler than the gear so
#   it stands clear of them) with the gear's shadow in black, bronze hub → brown / yellow,
#   concrete tops → lightgrey, faces → darkgrey, sunlit side walls → white, wood and brass →
#   brown with yellow highlights and black edges, olive turf → green with lightgreen patches.
scene "The Giant Gear"
variants day

# ---- sky ----------------------------------------------------------------------------------
# Painted first, so everything else stands on it, but held back with delay: over the original
# the viewer paints it last, filling in behind what's already there.
delay {
  color lightcyan
  rect 0, 0, 159, 167
}

# ---- stone blocks behind the gear ------------------------------------------------------------
fn block(x1, x2, ytl, ytr, c) {
  shape([[x1, ytl], [x2, ytr], [x2, 106], [x1, 106]], c)
}
block 100, 113, 51, 48, darkgrey
block 113, 131, 47, 45, lightgrey
block 131, 137, 49, 48, darkgrey
block 137, 147, 47, 45, lightgrey
block 147, 156, 46, 48, darkgrey
block 156, 162, 52, 52, lightgrey
# lit left edges and a few vertical chisel marks
color white
line 114, 48, 114, 100
line 138, 48, 138, 100
color darkgrey
line 121, 52, 121, 60
line 126, 62, 126, 70
line 142, 52, 142, 58
line 158, 58, 158, 66
# their feet in shade below the rail
shape([[100, 86], [159, 86], [159, 106], [100, 106]], darkgrey, null)
# the gear's shadow thrown across the lower blocks
shape([[98, 52], [112, 52], [114, 60], [118, 74], [124, 90], [128, 106], [98, 106]], black, null)
shape([[131, 56], [137, 54], [141, 70], [143, 86], [137, 90], [131, 74]], black, null)
color black
line 100, 51, 113, 48, 131, 45, 137, 48, 147, 45, 156, 48, 159, 52

# ---- the giant gear ----------------------------------------------------------------------------
let gear = [[33, 104], [33, 64], [35, 62], [38, 62], [39, 44], [43, 27], [50, 30], [51, 11],
            [60, 6], [67, 10], [68, 12], [71, 7], [100, 34], [96, 49], [101, 82], [104, 104]]
shape(gear, darkgrey)
# shaded faces of the teeth
shape([[43, 27], [50, 30], [50, 38], [46, 38]], black, null)
shape([[60, 6], [67, 10], [68, 12], [67, 27], [61, 27]], black, null)
shape([[80, 16], [100, 34], [96, 49], [82, 49], [80, 40]], black, null)
# the near tooth, square to the viewer, and the dark side of the rim beside it
shape([[82, 60], [96, 49], [101, 82], [87, 92]], darkgrey)
shape([[96, 49], [101, 50], [103, 104], [101, 82]], black, null)
# the rim: a raised ring between the face and the teeth
let rim = [[61, 30], [67, 38], [72, 50], [77, 64], [80, 78], [82, 92], [83, 104]]
color black
stroke rim
stroke shift(rim, 2, 0)
color lightgrey
stroke shift(rim, 1, 0)
# grooves round the hub, each with a lit lip
let groove1 = arc(56, 94, 12, 40, 250, 375, 8)
let groove2 = arc(56, 94, 8, 27, 250, 400, 8)
shape(band(groove1, 3, 3), black, null)
color black
stroke groove2
shape(band(arc(56, 94, 8, 27, 340, 400, 10), 3, 1), black, null)
color lightgrey
stroke shift(groove1, 1, 2)
stroke shift(groove2, 1, 2)
# light catching the lit edges of the teeth
color lightgrey
line 52, 11, 59, 7
line 40, 43, 43, 30
line 83, 59, 95, 50
line 34, 64, 37, 63
color black
outline gear

# bronze hub ring with its bolts, round a recessed boss
ellipse 55, 93, 6, 13
color brown
ellipse 55, 93, 5, 12
color yellow
stroke arc(55, 93, 4, 11, 200, 340, 10)
color black
for a in range(0, 360, 30) {
  let bx = 55 + 5 * sin(a)
  let by = 93 - 11 * cos(a)
  rect bx, by, bx, by
}
ellipse 55, 93, 3, 7
color darkgrey
ellipse 55, 93, 2, 6
color lightgrey
stroke arc(55, 93, 2, 6, 100, 170, 15)

# ---- the stone hut at far left ----------------------------------------------------------------
shape([[0, 86], [15, 86], [16, 104], [0, 104]], darkgrey)
shape([[2, 68], [13, 68], [13, 90], [2, 90]], darkgrey)
shape([[2, 68], [8, 60], [14, 68]], darkgrey)
shape([[8, 60], [14, 68], [8, 68]], black, null)
color lightgrey
line 3, 67, 7, 62
color black
rect 3, 70, 12, 79
color brown
rect 5, 72, 10, 78
color lightgrey
for x in range(4, 12, 2) { rect x, 70, x, 70 }
for y in range(72, 79, 2) { rect 3, y, 3, y; rect 12, y, 12, y }
color black
line 4, 92, 10, 90
line 6, 96, 13, 94

# ---- the deck -----------------------------------------------------------------------------------
shape([[0, 98], [33, 97], [60, 101], [84, 104], [159, 101], [159, 122], [0, 122]], lightgrey, null)
color black
line 0, 98, 15, 98
# the hut's shadow
shape([[2, 99], [6, 99], [12, 110], [7, 110]], black, null)
# shadows of the near rail's knob and beam on the deck
shape([[50, 116], [80, 113], [76, 117], [52, 119]], black, null)

# ---- far rail and posts ---------------------------------------------------------------------------
fn post(x1, x2, y1, y2) {
  color brown
  rect x1, y1, x2, y2
  color yellow
  line x1, y1, x1, y2
  color black
  line x2 + 1, y1, x2 + 1, y2
}
fn knob(cx, cy, rx, ry) {
  shape([[cx - rx, cy], [cx - rx + 1, cy - ry + 1], [cx, cy - ry], [cx + rx - 1, cy - ry + 1],
         [cx + rx, cy], [cx + rx - 1, cy + ry - 1], [cx, cy + ry], [cx - rx + 1, cy + ry - 1]], yellow)
  shape([[cx + 1, cy + ry - 1], [cx + rx - 1, cy + 1], [cx + rx - 1, cy + ry - 2]], brown, null)
}
fn rail(x1, x2, y) {
  color brown
  rect x1, y - 1, x2, y + 1
  color yellow
  line x1, y - 1, x2, y - 1
  color black
  line x1, y - 2, x2, y - 2
  line x1, y + 2, x2, y + 2
}
# the low edge rail and thin posts out past the hut
color brown
line 15, 96, 40, 96
line 29, 82, 29, 96
line 33, 82, 33, 96
rail 0, 45, 79
post 45, 46, 82, 92
knob 46, 79, 3, 5
rail 108, 159, 79
post 106, 108, 82, 112
knob 107, 79, 3, 5

# ---- wooden beams lying on the deck ------------------------------------------------------------
fn beam(x1, x2, y1, y2) {
  shape([[x1, y1], [x2, y2], [x2, 121], [x1, 121]], brown)
  color black
  stroke x1, 118, x2, 118
  color yellow
  for g in [[4, 9, 112], [18, 24, 115], [33, 38, 112], [47, 51, 114]] {
    if x1 + g[1] < x2 { stroke x1 + g[0], g[2], x1 + g[1], g[2] }
  }
}
beam 0, 53, 109, 109
beam 103, 159, 110, 108

# ---- ledge, step and the turf either side -----------------------------------------------------
# turf (olive) on the left, sunlit on top, shaded at the bottom
shape([[0, 131], [48, 132], [44, 167], [0, 167]], green)
shape([[0, 132], [30, 133], [26, 140], [12, 142], [0, 146]], lightgreen, null)
shape([[0, 155], [10, 150], [18, 156], [24, 167], [0, 167]], black, null)
color lightgreen
line 30, 138, 36, 136
line 20, 146, 28, 144
# ledge front face below the beams
shape([[0, 121], [116, 121], [116, 136], [52, 136], [50, 132], [0, 132]], darkgrey)
# the step down in the middle: lit tread, shaded riser
shape([[52, 136], [114, 136], [118, 152], [52, 152]], lightgrey)
shape([[52, 152], [118, 152], [122, 167], [52, 167]], darkgrey)
# the handrail's shadow thrown across the step
shape([[55, 127], [59, 126], [64, 144], [70, 139], [78, 134], [80, 136], [64, 150], [52, 150], [52, 140]], black, null)
shape([[60, 153], [66, 153], [78, 167], [70, 167]], black, null)
shape([[52, 155], [54, 155], [58, 167], [52, 167]], black, null)
# sunlit left side wall of the stair
shape([[47, 131], [53, 131], [53, 167], [38, 167]], white)
color lightgrey
line 47, 133, 39, 165
# right: the shaded wall, the turf below it, and the sunlit side wall
shape([[110, 120], [159, 120], [159, 140], [126, 141], [118, 141]], darkgrey)
shape([[124, 140], [159, 138], [159, 167], [128, 167]], green)
shape([[145, 140], [159, 139], [159, 150], [150, 152]], lightgreen, null)
shape([[124, 140], [134, 140], [142, 167], [128, 167]], black, null)
shape([[107, 120], [117, 120], [132, 167], [120, 167]], white)
color lightgrey
line 109, 122, 121, 165

# ---- near handrails, posts and knobs ----------------------------------------------------------
fn handrail(path, w1, w2, lit) {
  shape(band(path, w1, w2), brown)
  shape(band(offset(path, lit), w1 * 0.2, w2 * 0.2), yellow, null)
}
# left
post 45, 47, 100, 127
shape([[43, 126], [49, 126], [49, 140], [43, 140]], brown)
color yellow
line 44, 127, 44, 139
handrail([[46, 100], [39.5, 124], [30.5, 154], [27, 172]], 10, 15, -2)
knob 45, 94, 4, 7
# right
post 112, 114, 98, 122
shape([[110, 120], [116, 120], [116, 131], [110, 131]], brown)
color yellow
line 110, 121, 110, 130
handrail([[116, 98], [126, 124], [141, 154], [149, 172]], 11, 18, 2)
knob 113, 91, 4, 7

frame()
