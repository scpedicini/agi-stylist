# Gear Hill Stairs
# Source: Myst (1993) render, reference/myst/r13-c13.png; reframed with:
#   pnpm grid reference/myst/r13-c13.png --crop 0,0,544,333 --name myst-r13-c13
# Method: translated by eye. Kept: pale sky, the top of the granite gear with its teeth and
#   two ring grooves, the concrete landing round its foot, the dark lever slab, the three runs
#   of rope rail on brass posts with their knobs, the big end cap and its post, the mossy
#   orange rock hill with lit ridges and black crevices, the curving wall top, the stair
#   flight and its bottom landing, the chunky parapet block (lit face, shaded face), the deep
#   black shadow under it, the lit rock slab on the right.
#   Dropped: concrete and granite texture, the bent brace by the middle posts, the far small
#   posts behind the gear, most of the rock's soft colour mottling.
#   Moved: nothing.
# Colours: hazy sky → lightcyan, granite gear → lightgrey with darkgrey/black shaded teeth and
#   black/darkgrey ring grooves, concrete → lightgrey treads and lit face, white wall tops,
#   darkgrey risers and shaded face, deep shadow → black, rope rail and posts → brown with
#   yellow twist ticks and black edges, orange rock → brown with yellow lit ridges, green moss,
#   red and black folds.
scene "Gear Hill Stairs"
variants day

# ---- helpers ---------------------------------------------------------------------------
# a rope-wrapped rail: brown body, black edge, yellow twist ticks along its top
fn rope(pts, w = 3) {
  shape(band(pts, w), brown, null)
  color black
  stroke offset(pts, 2)
  color yellow
  for p in along(pts, 3) {
    stroke p[0], p[1] - 1, p[0], p[1] - 1
  }
}

# a gear face: n square teeth round (cx, cy), tips on the ellipse rx × ry, roots at 0.76 of
# it. Each tooth has parallel sides (half-width hw of the radius), so its corners stay square.
fn gearpts(cx, cy, rx, ry, n, rot, hw = 0.17) {
  let pts = []
  for i in 0..n {
    let a = rot + i * 360 / n
    let d = [sin(a), -cos(a)]
    let q = [cos(a), sin(a)]
    for c in [[0.76, -1], [1, -1], [1, 1], [0.76, 1]] {
      push(pts, [cx + rx * (d[0] * c[0] + q[0] * hw * c[1]), cy + ry * (d[1] * c[0] + q[1] * hw * c[1])])
    }
    # the root between this tooth and the next
    let m = a + 180 / n
    push(pts, [cx + rx * 0.76 * sin(m), cy - ry * 0.76 * cos(m)])
  }
  return pts
}

# a brass post: brown with a black shadow column on its right
fn post(x, y1, y2) {
  color brown
  stroke x, y1, x, y2
  color black
  stroke x + 1, y1, x + 1, y2
}

# a round brass knob where rails meet a post
fn knob(x, y) {
  color black
  ellipse x, y, 2, 2
  color brown
  ellipse x, y, 1, 1
  color yellow
  stroke x - 1, y - 1, x - 1, y - 1
}

# ---- sky -------------------------------------------------------------------------------
# Painted first, so everything else stands on it, but held back with delay: over the original
# the viewer paints it last, filling in behind what's already there, after the shadow below.
delay 2 {
  color lightcyan
  rect 0, 0, 159, 167
}

# ---- the deep shadow under everything near ------------------------------------------------
delay {
  shape([[0, 100], [140, 100], [149, 94], [152, 100], [159, 108], [159, 168], [0, 168]], black, null)
}

# ---- the gear ------------------------------------------------------------------------------
# its thickness shows on the right of every tooth, so paint it shifted right in shade first
shape(gearpts(66, 50, 20, 40, 10, 0), darkgrey)
shape(gearpts(64, 50, 20, 40, 10, 0), lightgrey)
color black
outline gearpts(64, 50, 20, 40, 10, 0)
# ring grooves round the hub
color darkgrey
stroke arc(66, 50, 15, 17, 290, 430, 8)
stroke shift(arc(66, 50, 15, 17, 290, 430, 8), 0, 1)
color black
stroke arc(66, 50, 10, 13, 285, 435, 8)
stroke shift(arc(66, 50, 10, 13, 285, 435, 8), 0, 1)

# ---- the concrete landing round the gear's foot -------------------------------------------
shape([[20, 40], [48, 40], [62, 43], [76, 46], [84, 48], [84, 56], [20, 56]], lightgrey)
color brown
stroke 22, 41, 48, 41, 62, 44, 76, 47
color yellow
stroke 26, 41, 40, 41

# ---- the dark lever slab ---------------------------------------------------------------------
shape([[29, 26], [33, 24], [33, 40], [29, 40]], darkgrey)

# ---- the back rails ------------------------------------------------------------------------
post 18, 32, 40
post 44, 25, 40
post 47, 26, 40
color brown
stroke 19, 33, 23, 40
rope([[17, 32], [44, 24]])
rope([[47, 25], [77, 36]])
knob 17, 32
knob 45, 24
post 77, 37, 47

# ---- the hill -------------------------------------------------------------------------------
let hill = [[0, 50], [4, 48], [12, 40], [28, 41], [42, 50], [48, 41], [58, 44], [62, 48],
            [65, 45], [80, 47], [84, 52], [87, 62], [89, 75], [54, 75], [54, 152], [42, 155],
            [30, 161], [22, 168], [0, 168]]
shape(hill, brown)
# moss over the crown, its lower edge hanging into the brown in ragged tongues of mixed length
shape([[0, 51], [4, 49], [12, 41], [28, 42], [42, 51], [48, 42], [58, 45], [62, 49], [65, 46],
       [79, 48], [82, 53], [79, 58], [76, 55], [73, 63], [70, 57], [66, 59], [63, 68], [60, 58],
       [57, 66], [55, 82], [52, 74], [50, 96], [47, 84], [43, 90], [41, 104], [38, 86], [35, 80],
       [32, 92], [29, 72], [26, 78], [23, 66], [20, 84], [18, 70], [15, 76], [13, 96], [11, 88],
       [9, 120], [6, 104], [3, 112], [0, 106]], green, null)
# a bare rock streak through the moss
shape(band([[22, 46], [24, 58]], 3, 1), brown, null)
# lightgreen on the moss's sunlit crest
color lightgreen
stroke 13, 43, 19, 43
stroke 31, 45, 36, 48
stroke 49, 44, 54, 45
stroke 67, 48, 73, 48
stroke 6, 51, 9, 47
# crevices: tapering black bands of different lengths and leans
let crev = [[[[5, 120], [8, 136], [9, 152], [6, 167]], 6],
            [[[46, 98], [48, 112], [52, 130]], 3],
            [[[37, 106], [39, 122], [35, 142]], 4],
            [[[22, 110], [18, 124], [17, 134]], 3],
            [[[65, 63], [69, 73]], 2],
            [[[28, 140], [31, 152], [29, 163]], 3]]
for c in crev {
  shape(band(c[0], c[1], 1), black, null)
}
# a red shade edge beside two of them, a short yellow lit lip beside two others
color red
stroke shift(crev[0][0], 2, 0)
stroke shift(slice(crev[3][0], 0, 2), 2, 0)
color yellow
stroke shift(slice(crev[2][0], 0, 2), -2, 0)
stroke shift(slice(crev[1][0], 1, 3), -2, 0)
color black
outline hill

# ---- the curved wall top and the stair flight -------------------------------------------------
shape([[80, 47], [84, 49], [93, 57], [103, 65], [110, 71], [110, 75], [89, 75], [87, 62],
       [84, 52]], white, black)
# the wall's inner face dropping to the stairs
shape([[84, 49], [93, 57], [103, 65], [110, 71], [110, 74], [102, 67], [92, 59], [83, 51]],
      lightgrey, null)

let outer = [[82, 48], [100, 57], [116, 66], [131, 77], [138, 86], [141, 96], [141, 118]]
let inner_yx = [[49, 84], [57, 93], [65, 103], [71, 110], [118, 110]]
shape(outer + [[110, 118], [110, 72], [103, 65], [93, 57], [84, 49]], lightgrey)
# risers, deeper towards the viewer
let risers = [[61, 1], [66, 1], [72, 2], [79, 2], [87, 3], [97, 3], [108, 3]]
color darkgrey
for r in risers {
  for dy in 0..r[1] {
    let y = r[0] + dy
    let xl = interp(inner_yx, y) + 1
    let xr = 0
    for i in 0..len(outer) - 1 {
      let a = outer[i]
      let b = outer[i + 1]
      if y >= a[1] && y <= b[1] {
        xr = a[0] + (b[0] - a[0]) * (y - a[1]) / max(1, b[1] - a[1])
      }
    }
    stroke xl, y, xr - 1, y
  }
}
color black
stroke outer

# ---- the parapet block --------------------------------------------------------------------
shape([[54, 74], [88, 74], [89, 78], [89, 123], [83, 120], [75, 115], [63, 108], [54, 110]],
      lightgrey)
color white
rect 55, 75, 88, 76
shape([[89, 75], [110, 73], [110, 118], [94, 137], [91, 128], [89, 123]], darkgrey)
# bottom landing
shape([[94, 137], [110, 118], [141, 118], [141, 133]], lightgrey)

# ---- the lit rock slab on the right -------------------------------------------------------
shape([[150, 96], [159, 106], [159, 168], [155, 168], [152, 140], [151, 110]], brown)
color yellow
stroke 152, 100, 153, 120, 154, 140

# ---- the front rail ---------------------------------------------------------------------------
post 83, 38, 50
post 92, 45, 54
post 97, 45, 54
post 101, 47, 59
post 115, 53, 66
rope([[82, 37], [102, 47], [115, 53], [132, 63], [141, 71], [144, 77], [144, 86]])
knob 82, 37
knob 101, 46
knob 115, 53
knob 142, 72
# the end cap and its post
color black
ellipse 144, 91, 4, 6
color brown
ellipse 144, 91, 3, 5
color yellow
stroke 142, 87, 141, 90, 142, 94
color brown
rect 142, 97, 145, 121
color yellow
stroke 142, 97, 142, 120
color black
stroke 146, 97, 146, 121

frame()
