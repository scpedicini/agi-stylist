# Village Crossroads at Midday
# From the layout sketch app/tests/fixtures/sketches/12-crossroads.png and its brief.
scene "Village Crossroads at Midday"
variants day

let hz = 42

# ---------------------------------------------------------------- sky and ground
color blue
rect 0, 0, 159, 47
cloud(30, 12, 32, 2)
cloud(56, 31, 20, 5)
cloud(148, 9, 18, 3)
# the grass is painted first, so everything else stands on it, but held back with delay: the
# viewer paints it last, filling in behind what's already there
delay {
  color lightgreen
  rect 0, 44, 159, 167
}
# sky behind the right end of the skyline, which reaches the edge below the ground's top
color blue
rect 150, 44, 159, 51

# ---------------------------------------------------------------- mountains (grey ridge ~1)
# skyline along the stroke; the foot runs along the horizon on the left, rises into the pass
# where the road ends, and comes down nearer on the right (the right mountain's skirt)
let skyline = [[70, 50], [74, 49], [76, 45.4], [79, 39.8], [82.4, 33.6], [86.2, 27.4],
               [89.8, 22.7], [93, 20.2], [96.6, 21.6], [100.2, 26.9], [103.6, 33], [107.2, 37.2],
               [110.6, 37.2], [113.6, 33], [116.6, 26.6], [119.8, 19.6], [123.2, 13.7],
               [126.8, 10.6], [130, 11.5], [133.6, 14.8], [137.6, 19.9], [141.4, 25.8],
               [145.4, 31.9], [148.8, 37.8], [151.8, 42.8], [154, 46.2], [158, 49], [162, 50]]
let foot = [[162, 61], [140, 61], [128, 60], [123, 56], [118, 48], [113, 44], [109, 43],
            [105, 44], [101, 46], [96, 49], [70, 50]]
shape(skyline + foot, lightblue)
# snowcaps
shape([[87.4, 25.6], [89.8, 22.7], [93, 20.2], [96.6, 21.6], [99, 25], [97, 24.5],
       [95, 27], [93, 24], [91, 27], [89, 25]], white)
shape([[120.6, 18.2], [123.2, 13.7], [126.8, 10.6], [130, 11.5], [133.6, 14.8], [136.4, 18.4],
       [134, 18], [132, 21], [130, 17], [127.5, 21], [125, 17], [123, 20]], white)
# gullies and a spur (darker partner)
color blue
stroke 93, 26, 91, 31, 92, 36
stroke 97, 25, 99, 31
stroke 127, 21, 125, 27, 126, 34
stroke 131, 19, 134, 26, 135, 33, 134, 40
stroke 116, 30, 115, 36
stroke 142, 30, 145, 38
stroke 84, 34, 83, 40
stroke 121, 40, 126, 46, 131, 50
stroke 148, 44, 150, 50

# ---------------------------------------------------------------- trees along the mountains' foot
let clumps = []
for x in range(-4, 99, 7) { push(clumps, [x, 46 + noise(3, x) * 2, 5, 3 + noise(4, x) * 2]) }
for x in range(124, 166, 7) { push(clumps, [x, interp(reverse(slice(foot, 0, 4)), x) + noise(3, x), 5, 3 + noise(4, x) * 1.5]) }
blobs(clumps, green, black, 0.25, 6)

# ---------------------------------------------------------------- road and lane (brown ~2)
let road_pts = [[107, 44.8], [105.6, 46.8], [102.8, 51.2], [99.2, 56.6], [95.2, 62.4],
                [92.2, 67.2], [89.2, 72], [86.2, 76.7], [83, 81.8], [79.6, 87.1], [76, 92.4],
                [73, 96.6], [70, 100.8], [66.8, 105.3], [63.6, 109.8], [60.2, 114.5],
                [56.6, 119.3], [53.2, 124.3], [50, 129.1], [46.4, 134.1], [42.8, 139.7],
                [39, 145.3], [35.2, 150.9], [31.8, 156.2], [28.6, 161], [26, 164.9],
                [22, 172]]
let lane_pts = [[30, 84], [37.8, 86], [47.2, 88.2], [58, 90.7], [68.4, 93.2], [77.6, 95.8],
                [86.8, 98.3], [95.2, 101.1], [103.8, 103.9], [113.4, 106.7], [123, 109.8],
                [133.8, 112.8], [144.4, 115.9], [153.6, 118.4], [166, 121.8]]
# narrowed towards a vanishing point above the horizon, so it still has width where it enters
# the pass instead of thinning to nothing
let road = trail(road_pts, 13, 36)
let lane = trail(lane_pts, 16, hz, 0.9)
shape(road, brown, null)
shape(lane, brown, null)
# a few stones on the road and lane
color darkgrey
for p in [[31, 157], [47, 133], [64, 109], [110, 106], [139, 115], [84, 84]] {
  rect p[0], p[1], p[0] + 1, p[1]
}

# ---------------------------------------------------------------- inn (box x 16-53, y 47-83)
let base = 82
let eave = 64
let px = 31
let peak = 47
let x1 = 19
let x2 = 43
# back plane = front scaled 0.25 towards the vanishing point (80, hz)
fn back(p) { return [p[0] + 0.25 * (80 - p[0]), p[1] + 0.25 * (hz - p[1])] }
# a row on the side wall, running from (x2, y0) towards the vanishing point
fn side_y(y0, x) { return y0 + (x - x2) * (hz - y0) / (80 - x2) }
let bb = back([x2, base])
let be = back([x2, eave])
let bp = back([px, peak])

# short midday shadow along the foot
color green
polygon x1 - 1, base + 1, x2, base + 1, bb[0] + 1, bb[1] + 1, bb[0] + 1, bb[1] + 2, x2, base + 2, x1 - 1, base + 2

# right side wall (shaded plaster with timbers)
shape([[x2, eave], be, bb, [x2, base]], lightgrey)
color brown
stroke x2 + 1, 73, bb[0] - 1, side_y(73, bb[0] - 1)
stroke 48, side_y(eave, 48) + 1, 48, side_y(base, 48) - 1
stroke x2 + 1, eave + 2, 48, side_y(73, 48) - 1
stroke x2 + 1, side_y(73, x2 + 1) + 2, 48, side_y(base, 48) - 1

# chimney behind the ridge
shape([[45, 45], [48, 45], [48, 54], [45, 54]], lightgrey)
color black
rect 44, 44, 49, 44

# right roof plane (red tiles)
shape([[px, peak], bp, [be[0] + 1, be[1]], [x2 + 1, eave + 1]], red)
color black
for t in [0.33, 0.66] {
  stroke px + (x2 + 1 - px) * t, peak + (eave + 1 - peak) * t,
         bp[0] + (be[0] + 1 - bp[0]) * t, bp[1] + (be[1] - bp[1]) * t
}

# front wall with the gable (white plaster)
shape([[x1, base], [x1, eave], [px, peak + 2], [x2, eave], [x2, base]], white)
# timber frame: posts, rails, braces
color brown
line x1 + 1, 73, x2 - 1, 73
line x1 + 1, eave + 1, x2 - 1, eave + 1
for x in [x1 + 1, 25, 37, x2 - 1] {
  line x, eave + 1, x, base - 1
}
line 20, 72, 24, 66
line 42, 72, 38, 66
line 20, 81, 24, 75
line 42, 81, 38, 75
# gable timbers
line x1 + 4, eave - 1, x2 - 4, eave - 1
line px, peak + 3, px, eave - 2
line 25, 62, 29, 54
line 37, 62, 33, 54

# roof edge over the gable (bargeboards)
color red
line x1 - 1, eave + 1, px, peak, x2 + 1, eave + 1
color black
line x1 - 2, eave + 1, px, peak - 1, x2 + 2, eave + 1
line x1 - 1, eave + 2, px, peak + 1, x2 + 1, eave + 2

# door (on the lane) and windows
shape([[29, base], [29, 75], [30, 74], [33, 74], [34, 75], [34, base]], brown)
color black
line 31, 76, 31, 81
color yellow
rect 33, 78, 33, 78
fn window(wx, wy) {
  shape([[wx, wy], [wx + 4, wy], [wx + 4, wy + 4], [wx, wy + 4]], lightcyan)
  color brown
  line wx + 2, wy + 1, wx + 2, wy + 3
  line wx + 1, wy + 2, wx + 3, wy + 2
}
window(20, 75)
window(38, 75)
window(29, 56)
window(26, 66)
window(34, 66)
# side-wall window
shape([[46, side_y(74, 46)], [49, side_y(74, 49)], [49, side_y(79, 49)], [46, side_y(79, 46)]], blue)

# hanging tavern sign: iron bracket out from the left corner, a board with a tankard
color black
line 12, 65, x1, 65
line x1, 67, x1 - 1, 66
rect 13, 66, 13, 67
rect 17, 66, 17, 67
shape([[12, 68], [18, 68], [18, 76], [12, 76]], brown)
pixmap(13, 69, ["www..", "yyyy.", "yyy.y", "yyy.y", "yyyy.", "yyy.."], "wy", [white, yellow])

# ---------------------------------------------------------------- signpost at the crossing
# on the grass in the corner below the lane, right of the road
color green
rect 89, 112, 93, 112
color brown
rect 90, 99, 91, 111
color black
line 92, 99, 92, 111
shape([[86, 100], [95, 100], [97, 101.5], [95, 103], [86, 103]], yellow)
shape([[86, 105], [95, 105], [95, 108], [86, 108], [84, 106.5]], yellow)

# ---------------------------------------------------------------- stalls x3 (red dabs)
fn stall(dx, dy, c) {
  let top = dy - 20
  let bot = dy - 11
  let base = dy + 6
  # shadow under the counter
  color green
  rect dx - 6, base + 1, dx + 7, base + 1
  # posts holding up the awning
  shape([[dx - 6, bot], [dx - 5, bot], [dx - 5, base], [dx - 6, base]], brown, null)
  shape([[dx + 5, bot], [dx + 6, bot], [dx + 6, base], [dx + 5, base]], brown, null)
  color black
  line dx - 7, bot, dx - 7, base
  line dx + 7, bot, dx + 7, base
  # dark back of the stall between the posts
  shape([[dx - 4, bot + 1], [dx + 4, bot + 1], [dx + 4, dy - 2], [dx - 4, dy - 2]], darkgrey, null)
  # wares on the counter
  color red
  rect dx - 4, dy - 2, dx - 3, dy - 1
  color lightgreen
  rect dx - 1, dy - 3, dx + 1, dy - 1
  color white
  rect dx + 3, dy - 2, dx + 4, dy - 1
  # counter
  shape([[dx - 6, dy], [dx + 6, dy], [dx + 6, base], [dx - 6, base]], brown)
  color black
  line dx - 5, dy + 3, dx + 5, dy + 3
  # striped awning, wider at the front edge
  shape([[dx - 5, top], [dx + 5, top], [dx + 7, bot], [dx - 7, bot]], white)
  for x in range(dx - 6, dx + 7) {
    if floor((x - dx + 7) / 2) % 2 == 0 {
      color c
      let off = abs(x - dx) > 5 ? (abs(x - dx) - 5) * 4 : 0
      line x, top + 1 + off, x, bot - 1
    }
  }
  # scalloped valance
  color black
  line dx - 7, bot, dx + 7, bot
  for x in range(dx - 6, dx + 7, 2) {
    color floor((x - dx + 7) / 2) % 2 == 0 ? c : white
    rect x, bot + 1, x, bot + 2
  }
}
stall(106, 140, red)
stall(120, 144, blue)
stall(134, 148, green)

frame()
