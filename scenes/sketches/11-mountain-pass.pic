# Winter Mountain Pass
# Source: layout sketch tests/fixtures/sketches/11-mountain-pass.png; reframed with:
#   pnpm grid tests/fixtures/sketches/11-mountain-pass.png --crop 0,0,640,480 --fit --name sketches-11-mountain-pass
# Brief: a winter mountain pass under an overcast sky. The cave is dark, with icicles hanging
#   over its mouth.
# Method: composed from a hybrid layout sketch. Labels: Snow → white snowcap with lightcyan
#   shading on the central peak, filling pale-blue fill ~2 (peak (60,22), down to y≈46);
#   Mountains → a darkgrey rock massif from the grey skyline down to its foot on the pass floor
#   (y≈92 under the label at (140,80)), with lightgrey lit faces and black gullies; Cave → a
#   dark cave mouth in the left cliff, centred on (40,105), base on the floor at y≈118, with a
#   row of white icicles hanging from its lip; Path → a brown trail trodden through the snow,
#   along brown line ~3 from the mountains' foot at (91,92) winding down to the bottom edge at
#   x≈82. Geometry: grey line ~1 → the mountains' skyline (ridge) from the left edge at y≈72 to
#   the right edge at y≈44, peaks at x≈19, 60, 104; pale-blue fill ~2 → snow on the main peak;
#   brown line ~3 → trail (trail(), narrowing with distance).
# Stage: horizon y 80 (chosen: hidden behind the mountains, a little above the path's far end)
# Interpreted: the grey line is the skyline of the mountains, not the horizon: "Mountains" is
#   written below it, so the rock fills from the line down and the sky is above. The open
#   floor of the pass (where the path and the player go) is snow, starting at the mountains'
#   foot (chosen: y≈119 at the left cliff, rising to y≈92 in the middle and right). Cave is an
#   attached thing on the left mountain's face. Overcast: lightgrey sky with darkgrey and
#   white cloud streaks; flat light, so only modest lit faces on the rock. Paint colours as
#   hints: grey → rock, pale blue → snow, brown → a dirt trail. Lighting: overcast day →
#   variant day. Inventions (to make "winter" and "pass" read): white snow on the floor with
#   lightcyan drifts, snow streaks on the rock ledges and on top of the cave's lip, a notch of
#   snow at the pass where the trail leaves the screen beyond the far end, a few dark rocks
#   poking out of the snow beside the trail.
# Notes: the trail is the walkable way through the pass: exits at the bottom edge and at its
#   far end (91,92), into the gap between the mountains.
scene "Winter Mountain Pass"
variants day

let hz = 80

# ---- overcast sky ----
color lightgrey
rect 0, 0, 159, 80
# a few long cloud streaks (white lit tops, darkgrey undersides)
blobs([[30, 6, 26, 2], [92, 4, 30, 2], [140, 10, 22, 2]], white, null, 0.1, 3)
color darkgrey
stroke 10, 9, 44, 9
stroke 70, 7, 112, 7
stroke 124, 13, 152, 13
stroke 0, 15, 14, 15
stroke 84, 15, 100, 15

# ---- the mountains (grey line ~1 is their skyline) ----
let ridge = [[-3, 74], [0.6, 71.6], [8.1, 55.8], [19.1, 42.9], [23.6, 43.6], [33.6, 58.3],
  [39.1, 58.3], [48.4, 42.5], [52, 31], [57, 24], [60.1, 21.9], [64.6, 24.7], [68, 31],
  [73, 41], [78.4, 53], [82.1, 55.8], [87.4, 53.7], [98.6, 37.6], [103.9, 34.1],
  [107.4, 34.5], [111.1, 37.6], [124.4, 55.5], [130.9, 59.7], [137.1, 59.3], [146.1, 55.1],
  [157.4, 47.1], [163, 43]]
# the foot of the mountains, where the snowy floor of the pass begins (right to left)
let foot = [[163, 97], [148, 95], [134, 93], [120, 94], [108, 92], [97, 90], [90, 84],
  [84, 90], [76, 95], [66, 101], [58, 110], [52, 117], [40, 119], [26, 120], [12, 122],
  [-3, 123]]
shape(ridge + foot, darkgrey)

# lit faces (the left flank of each peak), lightgrey, no edge
shape([[19.1, 42.9], [8.1, 55.8], [2, 68], [6, 80], [12, 74], [16, 60]], lightgrey, null)
shape([[60.1, 21.9], [52, 31], [48.4, 42.5], [42, 54], [44, 66], [50, 58], [55, 44], [58, 32]], lightgrey, null)
shape([[103.9, 34.1], [98.6, 37.6], [90, 50], [93, 62], [98, 52], [102, 42]], lightgrey, null)
shape([[157.4, 47.1], [146.1, 55.1], [140, 66], [146, 72], [150, 62], [156, 54]], lightgrey, null)

# gullies and cracks, and the skyline outline again over the lit faces
color black
stroke ridge
stroke 16, 60, 12, 74, 6, 84
stroke 58, 32, 55, 44, 50, 58, 44, 72
stroke 102, 42, 98, 52, 93, 64, 90, 76
stroke 156, 54, 150, 62, 146, 74
stroke 33, 66, 30, 78, 32, 92
stroke 122, 66, 118, 78, 120, 88
stroke 72, 60, 70, 74, 66, 86
stroke 136, 70, 132, 80
stroke 20, 96, 22, 108

# snow lying on ledges (winter)
fn ledge(x, y, w) {
  color white
  rect x, y, x + w, y
  line x + 1, y - 1, x + w - 1, y - 1
}
ledge(24, 66, 6)
ledge(62, 72, 5)
ledge(110, 60, 6)
ledge(128, 78, 5)
ledge(78, 66, 4)
ledge(6, 98, 6)
ledge(140, 84, 6)

# ---- Snow: the snowcap on the main peak (pale-blue fill ~2) ----
let cap = [[49, 40], [52, 31], [57, 24], [60.1, 21.9], [64.6, 24.7], [68, 31], [73, 41],
  [70, 44], [67, 41], [65, 46], [61, 42], [57, 45], [54, 40], [51, 43]]
shape(cap, white)
# the snowcap's shaded right side
shape([[61, 23], [64.6, 24.7], [68, 31], [73, 41], [70, 44], [67, 41], [65, 46], [64, 38], [62, 30]], lightcyan, null)
color black
outline cap

# ---- the floor of the pass: snow ----
color white
polygon foot + [[163, 170], [-3, 170]]
color black
stroke foot
# lightcyan drifts
color lightcyan
stroke 4, 132, 20, 130, 34, 133
stroke 110, 104, 130, 102, 150, 105
stroke 118, 128, 136, 125, 158, 129
stroke 12, 154, 30, 151, 48, 155
stroke 122, 152, 140, 149, 158, 152
stroke 40, 128, 56, 126
stroke 100, 98, 112, 97
stroke 124, 98, 138, 98

# ---- Cave: dark mouth in the left cliff, icicles over it ----
# the dark opening: a ragged, roughly flat top under an overhanging brow
let mouth_top = [[28, 104], [30, 99], [34, 98], [38, 99], [42, 98], [46, 99], [50, 98], [52, 103]]
shape([[27, 120], [27, 110]] + mouth_top + [[54, 110], [55, 120]], black, null)
# the overhanging brow of rock, part of the cliff
boulder([[22, 101], [23, 94], [28, 88], [36, 85], [45, 86], [53, 88], [58, 94], [57, 101],
  [52, 99], [50, 98], [46, 99], [42, 98], [38, 99], [34, 98], [30, 99], [26, 102]],
  lightgrey, darkgrey, black, 0.3)
# snow lying on the brow
shape([[22, 95], [25, 90], [30, 86], [37, 84], [45, 85], [52, 87], [57, 91], [58, 95],
  [53, 91], [46, 89], [38, 88], [31, 89], [26, 92]], white)
# icicles hanging from the brow's underside, irregular lengths
fn icicle(x, y, h) {
  color white
  line x, y, x, y + h - 1
  color lightcyan
  line x, y + h, x, y + h
}
for ic in [[29, 3], [30, 6], [32, 3], [33, 8], [35, 4], [36, 10], [38, 5], [40, 7], [41, 12],
           [43, 4], [44, 8], [46, 3], [47, 9], [49, 5], [50, 3], [51, 6]] {
  icicle(ic[0], floor(interp(mouth_top, ic[0])) + 1, ic[1])
}
# shadowed jambs either side of the mouth
color black
stroke 26, 119, 26, 106
stroke 56, 119, 55, 106
# a little snow drifted into the mouth
color white
polygon 29, 120, 34, 118, 46, 118, 52, 120
color black
stroke 29, 120, 34, 118, 46, 118, 52, 120

# ---- Path: a dirt trail trodden through the snow (brown line ~3) ----
let path_pts = [[89, 88], [90.9, 91.9], [92.6, 96.4], [91.6, 102.7], [69.1, 117.1],
  [65.9, 121.6], [68.1, 126.5], [92.9, 138.8], [97.1, 143], [95.9, 151.7], [85.6, 164.7],
  [82.1, 166.8], [80, 172]]
shape(trail(path_pts, 10, hz), brown)
# stones in the trail
color darkgrey
for p in [[86, 150], [90, 158], [78, 128], [72, 120], [88, 104], [94, 142]] {
  rect p[0], p[1], p[0] + 1, p[1]
}

# ---- a few rocks poking out of the snow ----
fn snowrock(x, y, w, h, s) {
  rock(x, y, w, h, s, darkgrey, black)
  color white
  line x - w / 4, y - h + 1, x + w / 4, y - h + 1
}
snowrock(124, 140, 10, 6, 2)
snowrock(20, 140, 12, 6, 4)
snowrock(140, 112, 7, 4, 5)

frame()
