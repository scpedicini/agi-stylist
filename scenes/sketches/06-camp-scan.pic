# Night Camp by the Lake
# Source: layout sketch app/tests/fixtures/sketches/06-camp-scan.jpg (photographed page on a table);
#   reframed with: pnpm grid app/tests/fixtures/sketches/06-camp-scan.jpg --trim --crop 0,0,1000,740 --fit --name sketches-06-camp-scan
# Brief: a night camp scene. The tent is orange. The campfire is lit. Some stars in the sky.
# Method: composed from a layout sketch. Labels: stars (+ 5 asterisks) → five white twinkling
#   stars at the asterisks (63,22) (78,32) (97,19) (115,29) (134,16); big oak tree → big night
#   oak (thick darkgrey trunk, broad lobed crown x 10-74, y 18-78), trunk base (44,101); Tent → orange (brown) A-frame tent, front facing the
#   fire, base y 121, spanning x 64-101 around (84,111); campfire → log fire with flames and a
#   stone ring, base (106,137), with a glow patch on the ground; lake → lake region right of a
#   shore from the horizon at x 108 to the right edge at y 124, containing (135,100).
#   Geometry: horizon line from (23,86) rising to (155,81), extended to both edges.
# Interpreted: "night" → variant night, blue night sky, green grass, black far treeline
#   (invented far backdrop along the horizon); the stars are exactly the five sketched
#   asterisks (the label "stars" names them); "lit" campfire shows as yellow glow on the
#   ground, a lit tent front and a yellow reflection streak on the lake; "orange" → brown
#   (EGA's orange), with red for the shaded seams; the lake's shore is invented (none drawn).
scene "Night Camp by the Lake"
variants night

# horizon line as drawn (slightly rising to the right), extended to the edges
let hz = [[0, 86.5], [23, 86], [40, 85.5], [60, 85], [70, 85], [77, 83.5], [95, 83],
  [110, 82.5], [122, 81.5], [140, 81.5], [155, 80.5], [159, 80.5]]

# --- sky -------------------------------------------------------------------
color blue
rect 0, 0, 159, 90

# --- far treeline silhouette along the horizon -----------------------------
let tl = wavy(0, 159, 76, 4, 6, 6)
shape([[0, 90]] + tl + [[159, 90]], black, null)

# --- ground ----------------------------------------------------------------
shape([[0, 167]] + hz + [[159, 167]], green, null)
color black
stroke hz

# --- lake (right), shore invented ------------------------------------------
let shore = [[106, 82.6], [110, 90], [115, 98], [121, 106], [130, 113], [142, 119], [159, 123]]
shape(shore + [[159, 80.5], [155, 80.5], [140, 81.5], [122, 81.5], [110, 82.5]], blue)
# muddy bank along the shore
color brown
stroke shift(shore, -1, 1)
color black
stroke shift(shore, -1, 2)
# ripples
color lightblue
line 128, 88, 136, 88
line 141, 93, 151, 93
line 124, 97, 130, 97
line 146, 104, 155, 104
line 137, 110, 143, 110
# firelight reflected on the water near the shore
color yellow
line 123, 108, 126, 108
line 127, 111, 132, 111
line 119, 103, 121, 103
color lightred
line 133, 114, 137, 114

# --- big oak tree (left) ---------------------------------------------------
# thick trunk with root flares and two limbs forking into a broad crown
shape([[36, 102], [39, 99], [40, 88], [39, 74], [49, 74], [48, 88], [49, 99], [53, 102]], darkgrey)
shape(band([[42, 82], [34, 72], [26, 64]], 8, 4), darkgrey)
shape(band([[46, 80], [54, 70], [60, 62]], 8, 4), darkgrey)
shape([[40, 88], [39, 76], [48, 76], [48, 88]], darkgrey, null)
color black
line 42, 100, 43, 90, 42, 80
line 46, 99, 46, 92
line 38, 101, 40, 98
line 51, 101, 48, 98
# crown: broad, lobed, wider than tall like an old oak
let crown = []
for b in [[22, 52, 12, 14], [38, 40, 15, 16], [54, 48, 11, 14], [12, 64, 9, 9], [40, 55, 9, 7],
  [30, 64, 14, 10], [52, 64, 12, 9], [42, 30, 9, 9], [26, 38, 10, 10], [64, 60, 6, 7]] {
  push(crown, [b[0] + 4, b[1], b[2], b[3]])
}
blobs(crown, darkgrey, black, 0.25, 3)
# leaf-clump lines inside the crown
color black
for c in [[18, 48], [34, 36], [50, 42], [28, 60], [46, 58], [12, 64], [58, 54], [36, 26], [24, 34]] {
  stroke arc(c[0] + 4, c[1] + 4, 5, 4, 300, 420, 20)
}
# limbs showing through gaps under the crown
color black
line 33, 72, 28, 69
line 55, 70, 59, 67

# a few dark grass tufts
color black
for p in [[14, 120], [30, 140], [60, 150], [8, 158], [130, 150], [148, 138], [40, 118], [90, 160]] {
  line p[0], p[1], p[0] - 1, p[1] - 2
  line p[0] + 1, p[1], p[0] + 1, p[1] - 3
  line p[0] + 2, p[1], p[0] + 3, p[1] - 2
}

# --- campfire glow on the ground -------------------------------------------
shape(blob(104, 137, 24, 13, 4, 0.08), brown, null)
shape(blob(105, 137, 13, 7, 2, 0.08), yellow, null)

# --- tent (orange), front facing the fire ----------------------------------
let apex = [90, 96]
let ridge = [74, 93]
let fl = [79, 121]
let fr = [101, 121]
let bl = [64, 118]
# shadow on the ground behind/left of the tent
shape([[64, 118], [79, 121], [74, 123], [60, 120]], black, null)
# side panel (the long roof), away from the fire
shape([ridge, apex, fl, bl], brown)
color red
line 72, 100, 77, 104
line 70, 106, 76, 111
line 68, 112, 75, 117
# front panel, lit by the fire
shape([apex, fr, fl], brown)
# door opening: dark inside, flaps pulled back
shape([[90, 102], [96, 121], [85, 121]], black, null)
color yellow
line 90, 101, 97, 120
line 91, 98, 100, 119
color red
line 90, 101, 84, 120
# ridge pole tip and guy ropes
color black
line 90, 96, 91, 94
line 101, 121, 105, 124
line 79, 121, 76, 125
line 64, 118, 60, 121
line 74, 93, 72, 91
color lightgrey
line 105, 124, 106, 124
line 76, 125, 77, 125
line 60, 121, 61, 121

# --- campfire --------------------------------------------------------------
# stone ring
for s in [[96, 138], [99, 141], [104, 142], [110, 141], [114, 138]] {
  shape([[s[0] - 1, s[1] - 1], [s[0] + 1, s[1] - 1], [s[0] + 2, s[1] + 1], [s[0] - 2, s[1] + 1]], lightgrey)
}
# crossed logs
shape(band([[98, 139], [113, 134]], 4), brown)
shape(band([[99, 133], [113, 139]], 4), brown)
# flames
shape([[100, 136], [101, 129], [103, 132], [105, 121], [107, 130], [109, 126], [110, 131],
  [112, 128], [112, 136]], lightred, red)
shape([[102, 136], [104, 129], [105, 131], [106, 125], [108, 132], [110, 136]], yellow, null)
shape([[105, 136], [106, 131], [107, 136]], white, null)
# sparks
color yellow
line 103, 116, 103, 116
line 109, 119, 109, 119
line 107, 112, 107, 112

# --- stars (the five sketched asterisks) -----------------------------------
for s in [[63, 22], [78, 32], [97, 19], [115, 29], [134, 16]] {
  sparkle(s[0], s[1], white, 2)
}

frame()
