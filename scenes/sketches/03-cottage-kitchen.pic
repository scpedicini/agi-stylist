# Cottage Kitchen by Firelight
# Source: layout sketch app/tests/fixtures/sketches/03-cottage-kitchen.png; reframed with:
#   pnpm grid app/tests/fixtures/sketches/03-cottage-kitchen.png --crop 0,0,800,600 --fit --name sketches-03-cottage-kitchen
# Brief: a cosy cottage kitchen at night, lit by the fire. The moon is visible through the
#   window. A wooden table with a loaf of bread on it. The rug is red.
# Method: composed from a layout sketch. Drawn room box → back wall (44,42)-(116,112) with the
#   four corner lines to the picture corners (room()). CHANDELIER → iron ring of candles hung
#   on a chain from the ceiling, centre (80,20); WINDOW → four-pane window on the back wall,
#   centre (64,67), night sky and moon in it; FIREPLACE → stone fireplace with a burning fire
#   on the back wall, firebox and mantel centred (98,97), chimney breast up to the ceiling;
#   DOOR → plank door on the left wall in perspective, centre (23,97); TABLE → wooden table,
#   x 61-99, standing on y 143, loaf on top; RUG → red rug on the floor, centre (80,153).
# Interpreted: variant `lit` (night, warm firelight). Walls are yellow plaster (firelit),
#   ceiling brown boards, floor darkgrey flagstones (so the wooden table and red rug stand
#   out). "Lit by the fire": the fire is the light, so the chandelier's candles are unlit.
#   Added: a chimney breast above the fireplace and a stone hearth slab (a fireplace needs
#   them), a jug and a plate on the mantel (small kitchen touches); the rug runs under the
#   table so its legs stand on it.
# Colours: plaster → yellow, timber/table/door → brown, stone → lightgrey/darkgrey,
#   night sky → blue, moon → white, fire → red/yellow, rug → red with yellow border.
# Objects: backdrop: room (ceiling, walls, floor); window/moon, fireplace/fire, jug, plate,
#   door/latch, rug, table, loaf, chandelier. The jug, plate and loaf are siblings of what they
#   stand on, drawn after it; the fireplace is reopened for its hearth.
scene "Cottage Kitchen by Firelight"
variants lit

let bx1 = 44
let by1 = 42
let bx2 = 116
let by2 = 112
let r = room(bx1, by1, bx2, by2)

# ---------- ceiling: brown boards converging on the back wall ----------
shape(r[3], brown)
color black
# (no seams through the middle, so the chandelier stands clear of them)
for x in [50, 58, 66, 94, 102, 110] {
  # board seams run from the back wall's top edge out to the top of the picture
  let vx = 80
  let vy = 77
  let t = vy / (vy - by1)
  stroke x, by1, vx + (x - vx) * t, 0
}

# ---------- walls ----------
shape(r[1], yellow)
shape(r[2], yellow)
shape(r[0], yellow)
# timber beam along the top of the back wall and skirting along the floor
color brown
rect bx1 + 1, by1 + 1, bx2 - 1, by1 + 2
color black
line bx1, by1 + 3, bx2, by1 + 3

# ---------- floor: darkgrey flagstones ----------
shape(r[4], darkgrey)
color black
for i in 1..6 {
  let s = i / 6
  let d = depth(bx1, by1, bx2, by2, s * sqrt(s))
  stroke d[0], d[3], d[2], d[3]
}
for x in [56, 68, 80, 92, 104] {
  let vx = 80
  let vy = 77
  let t = (167 - vy) / (by2 - vy)
  stroke x, by2, vx + (x - vx) * t, 167
}

# ---------- window on the back wall, centre (64,67) ----------
object "window" {
  color brown
  rect 53, 51, 75, 83
  shape([[53, 51], [75, 51], [75, 83], [53, 83]], null)
  color blue
  rect 55, 53, 73, 81
  # night sky with the moon in the upper right pane
  object "moon" { moon(69, 59, 4) }
  color white
  plot 57, 56
  plot 61, 61
  plot 58, 73
  plot 70, 76
  color brown
  rect 64, 53, 64, 81
  rect 55, 66, 73, 67
  color black
  outline [[55, 53], [73, 53], [73, 81], [55, 81]]
  # sill
  shape([[51, 83], [77, 83], [77, 85], [51, 85]], brown)
}

# ---------- fireplace on the back wall, centre (98,97) ----------
object "fireplace" {
  # chimney breast up to the ceiling
  color lightgrey
  rect 87, by1 + 4, 109, 80
  stones(87, by1 + 4, 109, 80, 6, 8, darkgrey)
  color black
  line 87, by1 + 4, 87, 80
  line 109, by1 + 4, 109, 80
  # firebox surround
  color lightgrey
  rect 85, 84, 111, by2
  stones(85, 84, 111, by2, 5, 7, darkgrey)
  shape([[85, 84], [111, 84], [111, by2], [85, by2]], null)
  # mantel beam
  shape([[82, 80], [114, 80], [114, 84], [82, 84]], brown)
  # opening and fire
  shape(archway(98, 87, 8, 4, by2), black)
  object "fire" {
    shape([[91, 110], [92, 102], [94, 104], [96, 94], [98, 101], [100, 92], [102, 102], [104, 98], [105, 110]], red, null)
    shape([[93, 110], [95, 104], [97, 106], [99, 99], [101, 105], [103, 110]], yellow, null)
    color brown
    rect 92, 110, 104, 111
    color black
    line 96, 110, 96, 111
    line 100, 110, 100, 111
  }
}
# a jug and a plate on the mantel
object "jug" { shape([[90, 79], [90, 76], [91, 74], [92, 76], [92, 79]], red) }
object "plate" {
  color black
  ellipse 103, 76, 2, 4
  color blue
  ellipse 103, 76, 1, 3
}

# hearth slab
object "fireplace" { shape([[83, by2], [113, by2], [116, 116], [80, 116]], lightgrey) }

# ---------- door on the left wall, centre (23,97) ----------
let dxl = 15
let dxr = 31
# floor and ceiling lines of the left wall
fn floory(x) { return 167 - x * (167 - by2) / bx1 }
fn ceily(x) { return x * by1 / bx1 }
fn doortop(x) { return floory(x) - 0.72 * (floory(x) - ceily(x)) }
let door = [[dxl, doortop(dxl)], [dxr, doortop(dxr)], [dxr, floory(dxr)], [dxl, floory(dxl)]]
object "door" {
  shape(door, brown)
  color black
  for x in [19, 23, 27] { line x, doortop(x), x, floory(x) }
  # iron straps
  for f in [0.22, 0.78] {
    line dxl, doortop(dxl) + f * (floory(dxl) - doortop(dxl)), dxr, doortop(dxr) + f * (floory(dxr) - doortop(dxr))
  }
  object "latch" {
    color yellow
    rect 28, 92, 29, 93
  }
}

# ---------- rug, centre (80,153) ----------
let rug = [[52, 139], [108, 139], [121, 165], [39, 165]]
object "rug" {
  shape(rug, red)
  color yellow
  outline [[56, 142], [104, 142], [115, 162], [45, 162]]
  shape([[80, 146], [92, 152], [80, 158], [68, 152]], lightred, black)
  # fringe
  color yellow
  for x in range(42, 120, 3) { line x, 166, x, 166 }
}

# ---------- table, x 61-99, standing on y 143 ----------
object "table" {
  color brown
  # back legs
  shape([[66, 128], [68, 128], [68, 139], [66, 139]], brown)
  shape([[92, 128], [94, 128], [94, 139], [92, 139]], brown)
  # top and apron
  shape([[64, 120], [96, 120], [99, 126], [61, 126]], brown)
  shape([[61, 126], [99, 126], [99, 130], [61, 130]], brown)
  # front legs
  shape([[62, 130], [64, 130], [64, 143], [62, 143]], brown)
  shape([[96, 130], [98, 130], [98, 143], [96, 143]], brown)
}

# loaf of bread
object "loaf" {
  shape([[73, 122], [74, 119], [76, 116], [80, 115], [84, 116], [86, 119], [87, 122]], yellow)
  color brown
  line 77, 117, 76, 119
  line 80, 116, 79, 119
  line 83, 117, 82, 119
}

# ---------- chandelier hanging from the ceiling, centre (80,19) ----------
object "chandelier" {
  color black
  line 80, 0, 80, 10
  ellipse 80, 12, 1, 2
  # iron ring (a solid band with the ceiling showing through) and a finial underneath
  ellipse 80, 21, 14, 3
  color brown
  ellipse 80, 21, 11, 1
  color black
  line 80, 24, 80, 27
  # arms from the hub out to the ring
  line 80, 13, 68, 19
  line 80, 13, 92, 19
  line 80, 14, 74, 22
  line 80, 14, 86, 22
  # unlit candles standing on the ring
  for x in [67, 72, 77, 83, 88, 93] {
    color white
    rect x, 14, x, 18
    color black
    plot x, 13
  }
}

frame()
