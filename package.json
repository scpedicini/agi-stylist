{
  "name": "kq-styles",
  "version": "0.1.0",
  "private": true,
  "description": "Sierra AGI-style adventure scenes painted from PicScript drawing instructions",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "vite --config app/vite.config.ts --port 5250 --strictPort --host",
    "build": "tsc --noEmit -p app && vite build --config app/vite.config.ts",
    "preview": "vite preview --config app/vite.config.ts --port 5250 --strictPort",
    "typecheck": "tsc --noEmit -p app",
    "test": "vitest run --config app/vite.config.ts",
    "test:watch": "vitest --config app/vite.config.ts",
    "test:e2e": "playwright test -c app/playwright.config.ts",
    "trace": "tsx app/scripts/trace.ts",
    "screenshot": "node app/scripts/screenshot.mjs",
    "render": "tsx app/scripts/render.ts",
    "grid": "tsx app/scripts/grid.ts",
    "style-stats": "tsx app/scripts/style-stats.ts",
    "regions": "tsx app/scripts/regions.ts",
    "lint:pic": "tsx app/scripts/lint-pic.ts",
    "skill:docs": "tsx app/scripts/gen-skill-docs.ts",
    "social": "tsx app/scripts/social.ts"
  },
  "dependencies": {
    "p5": "^2.3.4"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
